{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:daily",
    "security:minimumReleaseAgeNpm",
    ":automergeBranch",
    ":automergeDigest",
    ":automergeLinters",
    ":automergePatch",
    ":automergeRequireAllStatusChecks",
    ":automergeTesters",
    ":automergeTypes",
    ":maintainLockFilesWeekly",
    ":npm",
    ":rebaseStalePrs"
  ],
  "automergeSchedule": [
    "at any time"
  ],
  "automergeStrategy": "squash",
  "constraints": {
    "php": "~8.3.31"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the DDEV Node.js runtime",
      "managerFilePatterns": ["/^\\.ddev/config\\.yaml$/"],
      "matchStrings": ["nodejs_version: \"(?<currentValue>\\d+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "packageRules": [
    {
      "groupName": "CKEditor Development Tools",
      "rangeStrategy": "auto",
      "matchPackageNames": [
        "/^@ckeditor/ckeditor-dev-/"
      ]
    }
  ],
  "postUpdateOptions": [
    "npmDedupe",
    "npmInstallTwice"
  ],
  "skipInstalls": false
}
