--- /dev/null
+++ b/src/core/Filesystem/ZipExtractor.php
@@ -0,0 +1,237 @@
+<?php
+
+declare(strict_types=1);
+/**
+ * Copyright 2022-2026 FOSSBilling
+ * SPDX-License-Identifier: Apache-2.0.
+ *
+ * @copyright FOSSBilling (https://www.fossbilling.org)
