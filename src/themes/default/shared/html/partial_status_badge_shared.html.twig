{# Shared status_badge body for the admin and client macro_functions.html.twig files.
   Canonical behavior is the admin variant: a data-driven status map per type
   with a generic fallback map, Tabler text-bg-* / bg-*-fg classes, and labels
   from partial_status_name_shared.html.twig. The color/value pairs match what
   the client macro rendered for every status it handled (same hues, Tabler's
   contrast-correct classes); statuses the client macro didn't cover
   (pending_cancellation, transaction/gateway_tx/mail_queue types, ...) now
   resolve to the admin mapping instead of the generic fallback. #}
{% set status_key = status|default('')|lower %}
{% set status_classes = {
    'order': {
        'active': 'text-bg-success',
        'pending_setup': 'text-bg-warning',
        'failed_setup': 'text-bg-danger',
        'suspended': 'text-bg-danger',
        'failed_renew': 'text-bg-danger',
        'canceled': 'text-bg-secondary',
    },
    'ticket': {
        'open': 'text-bg-success',
        'on_hold': 'text-bg-warning',
        'closed': 'text-bg-secondary',
    },
    'invoice': {
        'paid': 'text-bg-success',
        'unpaid': 'text-bg-warning',
        'refunded': 'text-bg-info',
        'canceled': 'text-bg-secondary',
    },
    'client': {
        'active': 'bg-green text-green-fg',
        'suspended': 'bg-red text-red-fg',
        'canceled': 'bg-secondary text-secondary-fg',
    },
    'admin': {
        'active': 'bg-green text-green-fg',
        'inactive': 'bg-secondary text-secondary-fg',
    },
    'subscription': {
        'active': 'text-bg-success',
        'pending_cancellation': 'text-bg-warning',
        'canceled': 'text-bg-secondary',
        'past_due': 'text-bg-danger',
    },
    'post': {
        'published': 'text-bg-success',
        'active': 'text-bg-success',
        'draft': 'text-bg-secondary',
    },
    'product': {
        'enabled': 'text-bg-success',
        'disabled': 'text-bg-secondary',
    },
    'massmailer': {
        'sent': 'text-bg-success',
        'draft': 'text-bg-secondary',
    },
    'transaction': {
        'approved': 'text-bg-success',
        'processed': 'text-bg-success',
        'received': 'text-bg-warning',
        'processing': 'text-bg-warning',
        'error': 'text-bg-danger',
    },
    'gateway_tx': {
        'approved': 'text-bg-success',
        'complete': 'text-bg-success',
        'completed': 'text-bg-success',
        'processed': 'text-bg-success',
        'success': 'text-bg-success',
        'succeeded': 'text-bg-success',
        'pending': 'text-bg-warning',
        'processing': 'text-bg-warning',
        'received': 'text-bg-warning',
        'requires_action': 'text-bg-warning',
        'requires_capture': 'text-bg-warning',
        'requires_confirmation': 'text-bg-warning',
        'canceled': 'text-bg-danger',
        'cancelled': 'text-bg-danger',
        'error': 'text-bg-danger',
        'failed': 'text-bg-danger',
        'requires_payment_method': 'text-bg-danger',
        'unknown': 'text-bg-danger',
    },
    'mail_queue': {
        'sent': 'text-bg-success',
        'sending': 'text-bg-warning',
        'unsent': 'text-bg-danger',
    },
    'tx': {
        'success': 'text-bg-success',
        'failed': 'text-bg-danger',
        'pending': 'text-bg-warning',
        'refunded': 'text-bg-info',
    },
} %}
{% set fallback_classes = {
    'active': 'text-bg-success',
    'open': 'text-bg-success',
    'paid': 'text-bg-success',
    'published': 'text-bg-success',
    'pending_setup': 'text-bg-warning',
    'on_hold': 'text-bg-warning',
    'unpaid': 'text-bg-warning',
    'pending': 'text-bg-warning',
    'failed_setup': 'text-bg-danger',
    'suspended': 'text-bg-danger',
    'failed_renew': 'text-bg-danger',
    'canceled': 'text-bg-danger',
    'closed': 'text-bg-danger',
    'failed': 'text-bg-danger',
} %}
{% set type_classes = status_classes[type]|default(null) %}
{% if type_classes is not null %}
    {% set badge_class = type_classes[status_key]|default('text-bg-primary') %}
{% else %}
    {% set badge_class = fallback_classes[status_key]|default('text-bg-primary') %}
{% endif %}
<span class="badge {{ badge_class }}">{% include 'partial_status_name_shared.html.twig' with {status: status} %}</span>
