{#
    Body of the `recaptcha()` macro, byte-identical across the default admin
    and client themes' own macro_functions.html.twig. `{% include %}`
    rather than a shared macro namespace, since every call site invokes
    `mf.recaptcha` without parens - under that calling convention a macro
    body cannot reliably reach a namespace another template imported at its
    own top level, while `{% include %}` always renders with the current
    context (and Twig globals like `guest`), regardless of how the macro
    wrapping it was called.
#}
{% if guest.extension_is_on({"mod":"antispam"}) %}
    {% set config = guest.antispam_recaptcha %}
{% endif %}

{% if config is defined and config.enabled %}
            {% set provider = config.captcha_provider|default('recaptcha_v2') %}
            {% if provider == 'turnstile' %}
                {% if config.turnstile_site_key %}
                    <div class="mb-3">
                        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                        <div class="cf-turnstile" data-sitekey="{{ config.turnstile_site_key }}"></div>
                    </div>
                {% endif %}

            {% elseif provider == 'recaptcha_v2' %}
                {% if config.publickey %}
                    <div class="mb-3">
                        <script src='https://www.google.com/recaptcha/api.js' async defer></script>
                        <div class="g-recaptcha" data-sitekey="{{ config.publickey }}"></div>
                    </div>
                {% endif %}
            {% elseif provider == 'recaptcha_v3' %}
                {% if config.publickey %}
                    <script src="https://www.google.com/recaptcha/api.js?render={{ config.publickey }}" async defer></script>
                    <input type="hidden" name="g-recaptcha-response" value="">
                    <input type="hidden" name="g-recaptcha-action" value="fossbilling_submit">
                    <script>
                    (function () {
                        const script = document.currentScript;
                        const form = script.closest('form');
                        if (!form) {
                            return;
                        }

                        function submitWithoutToken() {
                            form.dataset.recaptchaV3Verified = 'true';
                            form.requestSubmit();
                        }

                        function submitWithToken() {
                            const tokenField = form.querySelector('input[name="g-recaptcha-response"]');
                            const actionField = form.querySelector('input[name="g-recaptcha-action"]');
                            window.grecaptcha.ready(function () {
                                window.grecaptcha.execute('{{ config.publickey|e('js') }}', { action: actionField.value }).then(function (token) {
                                    tokenField.value = token;
                                    submitWithoutToken();
                                }).catch(function () {
                                    submitWithoutToken();
                                });
                            });
                        }

                        form.addEventListener('submit', function (event) {
                            if (form.dataset.recaptchaV3Verified === 'true') {
                                form.dataset.recaptchaV3Verified = '';
                                return;
                            }

                            event.preventDefault();
                            event.stopImmediatePropagation();

                            if (window.grecaptcha) {
                                submitWithToken();
                                return;
                            }

                            // api.js loads async/defer, so window.grecaptcha may not exist
                            // yet even though the script tag is present. Poll briefly for
                            // it instead of submitting without a token immediately - only
                            // give up (and submit anyway) if it never shows up, e.g. the
                            // script is blocked by the browser or an extension.
                            let attempts = 0;
                            const maxAttempts = 50; // ~5s at 100ms intervals
                            const waitForGrecaptcha = setInterval(function () {
                                attempts++;
                                if (window.grecaptcha) {
                                    clearInterval(waitForGrecaptcha);
                                    submitWithToken();
                                } else if (attempts >= maxAttempts) {
                                    clearInterval(waitForGrecaptcha);
                                    submitWithoutToken();
                                }
                            }, 100);
                        }, true);
                    }());
                    </script>
                {% endif %}
            {% elseif provider == 'hcaptcha' %}
                {% if config.hcaptcha_site_key %}
                    <div class="mb-3">
                        <script src='https://js.hcaptcha.com/1/api.js' async defer></script>
                        <div class="h-captcha" data-sitekey="{{ config.hcaptcha_site_key }}"></div>
                    </div>
                {% endif %}
            {% endif %}
        {% endif %}
