{% embed 'partial_notice.html.twig' with {
    notice_type: 'danger', notice_role: 'alert', notice_icon: true
} %}
    {% block notice_content %}
        <h4 class="alert-heading">{{ 'An Error Occurred While Rendering This Widget.'|trans }}</h4>
        <ul class="mb-1">
            <li><strong>{{ 'Slot:'|trans }}</strong> {{ widget.slot|default('') }}</li>
            <li><strong>{{ 'Module:'|trans }}</strong> {{ widget.mod_name|default('') }}</li>
            <li><strong>{{ 'Template:'|trans }}</strong> {{ widget.template|default('') }}.html.twig</li>
        </ul>
        {% if error|default('') %}<pre class="mt-3 mb-0 bg-body-tertiary p-2 border rounded text-danger-emphasis small">{{ error }}</pre>{% endif %}
    {% endblock %}
{% endembed %}
