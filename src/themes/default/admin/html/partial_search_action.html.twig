{# Preserve the compact search entrypoint and explicit extension-supplied fields. #}
{% set preservedSearchFields = {} %}
{% for field_name in search_preserve_fields|default([]) %}
    {% if request[field_name]|default(null) is not null %}
        {% set preservedSearchFields = preservedSearchFields|merge({(field_name): request[field_name]}) %}
    {% endif %}
{% endfor %}
{% include 'partial_search_form_shared.html.twig' with {
    search_compact: true,
    search_value: request.search|default(''),
    search_hidden_fields: preservedSearchFields|merge(search_hidden_fields|default({}))
} %}
