{% set strength_config = {
    input: '#' ~ input_id,
    messages: {
        weak: 'Weak'|trans,
        fair: 'Fair'|trans,
        good: 'Good'|trans,
        strong: 'Strong'|trans
    }
} %}
<div class="strength" data-bs-strength="" data-bs-config="{{ strength_config|json_encode|url_encode|e('html_attr') }}"
     aria-label="{{ 'Password strength'|trans|e('html_attr') }}">
    <span class="strength-segment"></span>
    <span class="strength-segment"></span>
    <span class="strength-segment"></span>
    <span class="strength-segment"></span>
</div>
<div class="strength-text form-text" aria-live="polite"></div>
