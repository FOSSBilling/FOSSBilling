<nav class="row row-cards g-3 mb-3" aria-label="{{ label }}">
    {% for item in items %}
    {% set selected = item.status == current_status|default('') %}
    {% set item_query = item.query|default(item.status ? { status: item.status } : {}) %}
    <div class="col-6 col-lg">
        <a class="card card-sm h-100 shadow-none text-decoration-none{% if selected %} bg-primary-lt{% endif %}" href="{{ path|url(query: item_query) }}" aria-label="{{ item.label }} {{ item.count }}"{% if selected %} aria-current="page"{% endif %}>
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <span class="avatar avatar-lg rounded fs-1 fw-semibold shadow-none {{ item.count_class|default('bg-secondary-subtle text-secondary-emphasis') }}">{{ item.count }}</span>
                <span class="fw-medium{% if selected %} text-primary-emphasis{% endif %}">{{ item.label }}</span>
            </div>
        </a>
    </div>
    {% endfor %}
</nav>
