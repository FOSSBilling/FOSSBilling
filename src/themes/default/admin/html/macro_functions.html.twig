{% macro table_search() %}
<div style="position: relative;">
    <div class="dataTables_filter">
        <form method="get" action="">
            <label>{{ 'Search:'|trans }} <input type="text" name="search" placeholder="{{ 'Enter search text...'|trans }}" value="{{ request.search }}"><div class="srch"></div></label>
        </form>
    </div>
</div>
{% endmacro table_search %}

{% macro text_badge(label, badge_class) %}
    <span class="badge {{ badge_class }}">{{ label }}</span>
{% endmacro %}

{% macro boolean_badge(value, true_label, false_label, true_class, false_class) %}
    {% if value %}
        {{ _self.text_badge(true_label, true_class|default('text-bg-success')) }}
    {% else %}
        {{ _self.text_badge(false_label, false_class|default('text-bg-secondary')) }}
    {% endif %}
{% endmacro %}

{% macro status_badge(status, type, subtle = false) %}
    {% set status_key = status|default('')|lower %}
    {% set status_colors = {
        'order': {
            'active': 'success',
            'pending_setup': 'warning',
            'failed_setup': 'danger',
            'suspended': 'danger',
            'failed_renew': 'danger',
            'canceled': 'secondary',
        },
        'ticket': {
            'open': 'warning',
            'on_hold': 'info',
            'closed': 'secondary',
        },
        'invoice': {
            'paid': 'success',
            'unpaid': 'warning',
            'refunded': 'info',
            'canceled': 'secondary',
        },
        'client': {
            'active': 'success',
            'suspended': 'danger',
            'canceled': 'secondary',
        },
        'admin': {
            'active': 'success',
            'inactive': 'secondary',
        },
        'subscription': {
            'active': 'success',
            'pending_cancellation': 'warning',
            'canceled': 'secondary',
            'past_due': 'danger',
        },
        'post': {
            'published': 'success',
            'active': 'success',
            'draft': 'secondary',
        },
        'product': {
            'enabled': 'success',
            'disabled': 'secondary',
        },
        'massmailer': {
            'sent': 'success',
            'draft': 'secondary',
        },
        'transaction': {
            'approved': 'success',
            'processed': 'success',
            'received': 'warning',
            'processing': 'warning',
            'error': 'danger',
        },
        'gateway_tx': {
            'approved': 'success',
            'complete': 'success',
            'completed': 'success',
            'processed': 'success',
            'success': 'success',
            'succeeded': 'success',
            'pending': 'warning',
            'processing': 'warning',
            'received': 'warning',
            'requires_action': 'warning',
            'requires_capture': 'warning',
            'requires_confirmation': 'warning',
            'canceled': 'danger',
            'cancelled': 'danger',
            'error': 'danger',
            'failed': 'danger',
            'requires_payment_method': 'danger',
            'unknown': 'danger',
        },
        'mail_queue': {
            'sent': 'success',
            'sending': 'warning',
            'unsent': 'danger',
        },
        'tx': {
            'success': 'success',
            'failed': 'danger',
            'pending': 'warning',
            'refunded': 'info',
        },
    } %}
    {% set fallback_colors = {
        'active': 'success',
        'open': 'success',
        'paid': 'success',
        'published': 'success',
        'pending_setup': 'warning',
        'on_hold': 'warning',
        'unpaid': 'warning',
        'pending': 'warning',
        'failed_setup': 'danger',
        'suspended': 'danger',
        'failed_renew': 'danger',
        'canceled': 'danger',
        'closed': 'danger',
        'failed': 'danger',
    } %}
    {% set type_colors = status_colors[type]|default(null) %}
    {% if type_colors is not null %}
        {% set color = type_colors[status_key]|default('primary') %}
    {% else %}
        {% set color = fallback_colors[status_key]|default('primary') %}
    {% endif %}
    {% set badge_class = subtle ? 'bg-' ~ color ~ '-subtle text-' ~ color ~ '-emphasis' : 'text-bg-' ~ color %}
    {{ _self.text_badge(_self.status_name(status, type), badge_class) }}
{% endmacro %}

