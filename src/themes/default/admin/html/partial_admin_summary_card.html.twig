{% set summary_header_aside %}{% block summary_header_aside %}{% endblock %}{% endset %}
{% set _summary_actions_fallback %}{% block summary_actions %}{% endblock %}{% endset %}
{% set summary_actions = block('summary_actions')|trim %}

<div class="card{% if card_class|default('') %} {{ card_class }}{% endif %}">
    <div class="card-body{% if body_class|default('') %} {{ body_class }}{% endif %}">
        {% embed 'partial_card_heading.html.twig' with {heading_content_class: 'fb-card-summary-heading'} %}
            {% block card_heading_content %}
                <h5 class="card-title mb-0">{{ title }}</h5>
                {% if subtitle is defined and subtitle %}<p class="text-secondary mb-0 mt-1">{{ subtitle }}</p>{% endif %}
            {% endblock %}
            {% block card_heading_actions %}{{ summary_header_aside|raw }}{% endblock %}
        {% endembed %}
    </div>

    {% block summary_content %}{% endblock %}

    {% if summary_actions %}
        <div class="card-footer{% if centered_actions|default(false) %} text-center{% endif %}">
            {% if centered_actions|default(false) %}
                <div class="btn-list justify-content-center">
                    {{ summary_actions|raw }}
                </div>
            {% else %}
                {{ summary_actions|raw }}
            {% endif %}
        </div>
    {% endif %}
</div>
