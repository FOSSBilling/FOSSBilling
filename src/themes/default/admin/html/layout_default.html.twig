{% set profile = admin.profile_get %}
{% set company = guest.system_company %}
{% set active_locale = guest.system_locale|default('en')|replace({'_': '-'}) %}
{% set current_active_menu = active_menu|default('') %}

<!DOCTYPE html>
<html lang="{{ active_locale }}" data-bs-theme="dark">

<head>
    <title>{% block meta_title %}{% endblock %} - {{ company.name }}</title>
    <meta charset="UTF-8">
    {{ include('partial_admin_theme_init.html.twig') }}
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="shortcut icon" href="{{ company.favicon_url }}">

    {{ include('partial_bb_meta.html.twig') }}

    <link rel="stylesheet" href="{{ 'build/css/vendor.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'build/css/fossbilling.css' | asset_url }}">
    {{ 'js/fossbilling.js' | public_asset_url | script_tag }}
    {{ 'js/api.js' | public_asset_url | script_tag }}
    <script type="module" src="{{ 'build/js/fossbilling.js' | asset_url }}"></script>
    {{ debug_bar_render_head() }}

    {% block head %}{% endblock %}
</head>

<body>

    {% if not admin %}
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            window.location = "{{ 'staff/login'|url }}";
        });
    </script>
    {% endif %}

    {% if admin %}
    {% if hide_menu is defined and hide_menu %}
    {% block content_wide %}{% endblock %}
    {% else %}
    <a href="{{ guest.system_current_url|split('#')|first }}#main-content" class="visually-hidden-focusable position-fixed top-0 start-0 p-3 bg-body admin-skip-link">{{ 'Skip to content'|trans }}</a>
    <div class="page">
        {{ include('partial_admin_sidebar.html.twig') }}
        {% block nav %}{% endblock %}
        <div class="page-wrapper">
            {% block before_content %}{% endblock %}
            <main class="page-body" id="main-content" tabindex="-1">
                <div class="container-fluid px-lg-4">
                    <nav class="mb-3 mb-lg-4" aria-label="breadcrumb">
                        {% block breadcrumbs %}
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="{{ '/'|url }}" aria-label="{{ 'Dashboard'|trans }}">
                                    <svg class="icon">
                                        <use href="#home" />
                                    </svg>
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">{{ block('meta_title') }}</li>
                        </ol>
                        {% endblock %}
                    </nav>
                    {{ render_widgets('admin.theme.content.before') }}
                    {% block top_content %}{% endblock %}
                    {% block content %}{% endblock %}
                    {{ render_widgets('admin.theme.content.after') }}
                </div>
            </main>

            <footer class="footer footer-transparent d-print-none">
                <div class="container-fluid px-lg-4">
                    {{ render_widgets('admin.theme.footer.start') }}
                    <p>&copy; {{ 'now'|date('Y') }} <a href="https://github.com/FOSSBilling">FOSSBilling contributors</a>.
                    Licensed under <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache 2.0</a>.
                    Running version <code>{{ FOSSBillingVersion }}</code>.</p>
                    {{ render_widgets('admin.theme.footer.end') }}
                </div>
            </footer>
        </div>
    </div>
    {% endif %}

    <div class="loading dim"></div>

    <div class="d-none">
        {{ svg_sprite() }}
    </div>

    <button type="button" aria-label="{{ 'Back to Top'|trans }}" class="btn btn-floating btn-lg btn-icon back-to-top-hidden" id="back-to-top">
        <svg class="icon">
            <use href="#arrow-up" />
        </svg>
    </button>

    {% block js %}{% endblock %}

    <noscript id="noscript">
        <div class="msg error">NOTE: Many features on FOSSBilling require JavaScript and cookies. You can enable both via your browser's preference settings.</div>
    </noscript>
    {% endif %}

    {{ debug_bar_render() }}

    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1070;">
    </div>
</body>
</html>
