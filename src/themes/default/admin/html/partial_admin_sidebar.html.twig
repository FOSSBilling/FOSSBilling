{% set navigation = admin.extension_get_navigation({ 'url': guest.system_current_url }) %}
<aside class="navbar navbar-vertical navbar-expand-lg d-print-none admin-sidebar">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="{{ 'Toggle navigation'|trans }}">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-brand mb-lg-3">
            {{ include('partial_company_logo.html.twig', {
                company: company,
                logo_url: company.logo_url,
                dark_logo_url: company.logo_url_dark,
                image_class: 'navbar-brand-image'
            }) }}
            <button type="button" class="btn btn-icon btn-ghost-secondary btn-sm d-none d-lg-inline-flex" data-bs-toggle="sidebar-folded" aria-label="{{ 'Fold sidebar'|trans }}" aria-pressed="false" title="{{ 'Fold or pin sidebar'|trans }}">
                <svg class="icon" aria-hidden="true"><use href="#layout-sidebar-left-collapse" /></svg>
            </button>
        </div>
        <div class="navbar-footer">
            <ul class="navbar-nav">
                <li class="nav-item dropup flex-row align-items-center">
                    <a class="nav-link text-reset flex-grow-1 overflow-hidden" href="{{ 'staff/profile'|url }}" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-label="{{ 'Open user menu'|trans }}" aria-expanded="false">
                        {{ avatar(profile.email, 32, 'avatar avatar-sm') }}
                        <span class="nav-link-title overflow-hidden">
                            <span class="d-block text-truncate">{{ profile.name }}</span>
                            <span class="d-block small text-secondary text-truncate">{{ profile.email }}</span>
                        </span>
                    </a>
                    <a class="btn btn-icon btn-ghost-secondary admin-sidebar-logout" href="{{ 'profile/logout'|api_url }}" {{ fb_api_link({ redirect: 'staff/login'|url }) }} aria-label="{{ 'Logout'|trans }}" data-bs-toggle="tooltip" title="{{ 'Logout'|trans }}">
                        <svg class="icon" aria-hidden="true"><use href="#logout" /></svg>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-lg-start">
                        <a class="dropdown-item" href="{{ 'staff/profile'|url }}">{{ 'Profile'|trans }}</a>
                        <a class="dropdown-item" href="{{ 'system'|url }}">{{ 'Settings'|trans }}</a>
                        <div class="dropdown-divider"></div>
                        {% set languages = guest.extension_languages(true) %}
                        {% if languages|length > 1 %}
                            <div class="px-3 py-2">
                                <label class="form-label" for="admin-language">{{ 'Language'|trans }}</label>
                                <select id="admin-language" name="lang" class="form-select js-locale-selector">
                                    {% for lang in languages %}
                                        <option value="{{ lang.locale }}" data-custom-properties="&lt;span class=&quot;flag flag-country-{{ lang.locale|split('_')[1]|default('')|lower }} &quot;&gt;&lt;/span&gt;"{% if lang.locale == guest.system_locale %} selected{% endif %}>{{ lang.title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                        <div class="px-3 py-2">
                            <div class="btn-group w-100" role="group" aria-label="{{ 'Appearance'|trans }}">
                                <button type="button" class="btn btn-icon" data-theme-preference="system" aria-label="{{ 'System'|trans }}" aria-pressed="false" data-bs-toggle="tooltip" title="{{ 'System'|trans }}">
                                    <svg class="icon" aria-hidden="true"><use href="#device-desktop" /></svg>
                                </button>
                                <button type="button" class="btn btn-icon" data-theme-preference="light" aria-label="{{ 'Light'|trans }}" aria-pressed="false" data-bs-toggle="tooltip" title="{{ 'Light'|trans }}">
                                    <svg class="icon" aria-hidden="true"><use href="#sun" /></svg>
                                </button>
                                <button type="button" class="btn btn-icon" data-theme-preference="dark" aria-label="{{ 'Dark'|trans }}" aria-pressed="false" data-bs-toggle="tooltip" title="{{ 'Dark'|trans }}">
                                    <svg class="icon" aria-hidden="true"><use href="#moon" /></svg>
                                </button>
                            </div>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="{{ 'profile/logout'|api_url }}" {{ fb_api_link({ redirect: 'staff/login'|url }) }}>{{ 'Logout'|trans }}</a>
                    </div>
                </li>
            </ul>
        </div>
        <div class="collapse navbar-collapse pb-lg-3" id="navbar-menu">
            <nav class="w-100" aria-label="{{ 'Main navigation'|trans }}">
                <ul class="navbar-nav">
                    <li class="nav-item{% if current_active_menu == 'dashboard' %} active{% endif %}">
                        <a class="nav-link" href="{{ '/'|url }}"{% if current_active_menu == 'dashboard' %} aria-current="page"{% endif %}>
                            <span class="nav-link-icon"><svg class="icon" aria-hidden="true"><use href="#home" /></svg></span>
                            <span class="nav-link-title">{{ 'Dashboard'|trans }}</span>
                        </a>
                    </li>
                    {% for location, group in navigation %}
                        {% if group.subpages %}
                            {% set expanded = current_active_menu == location or group.active %}
                            <li class="nav-item dropdown{% if expanded %} active{% endif %}">
                                <button class="nav-link dropdown-toggle text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-controls="admin-nav-{{ loop.index }}" aria-expanded="{{ expanded ? 'true' : 'false' }}">
                                    <span class="nav-link-icon"><svg class="icon" aria-hidden="true"><use href="#{{ group.class }}" /></svg></span>
                                    <span class="nav-link-title">{{ group.label|trans }}</span>
                                </button>
                                <ul class="dropdown-menu{% if expanded %} show{% endif %}" id="admin-nav-{{ loop.index }}">
                                    {% for subpage in group.subpages %}
                                        <li><a class="dropdown-item text-wrap{% if subpage.active %} active{% endif %}" href="{{ subpage.uri }}"{% if subpage.active %} aria-current="page"{% endif %}>{{ subpage.label|trans }}</a></li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% endif %}
                    {% endfor %}
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-controls="admin-nav-help" aria-expanded="false">
                            <span class="nav-link-icon"><svg class="icon" aria-hidden="true"><use href="#help" /></svg></span>
                            <span class="nav-link-title">{{ 'Help'|trans }}</span>
                        </button>
                        <ul class="dropdown-menu" id="admin-nav-help">
                            <li><a class="dropdown-item text-wrap" href="https://docs.fossbilling.org/" target="_blank" rel="noopener">{{ 'Documentation'|trans }}</a></li>
                            <li><a class="dropdown-item text-wrap" href="https://github.com/FOSSBilling/FOSSBilling" target="_blank" rel="noopener">GitHub</a></li>
                            <li><a class="dropdown-item text-wrap" href="https://github.com/FOSSBilling/FOSSBilling/issues" target="_blank" rel="noopener">{{ 'Report a Bug'|trans }}</a></li>
                            <li><a class="dropdown-item text-wrap" href="https://fossbilling.org/discord" target="_blank" rel="noopener">{{ 'Discord'|trans }}</a></li>
                            <li><a class="dropdown-item text-wrap" href="https://github.com/sponsors/FOSSBilling" target="_blank" rel="noopener">{{ 'Sponsor'|trans }}</a></li>
                        </ul>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</aside>
