{% if header is defined and header %}
    <div class="card-header">
        <h3 class="card-title">{{ header }}</h3>
    </div>
{% endif %}

<div class="table-responsive">
    <div class="modal" id="extensionReadMe" data-fetching-message="{{ 'Fetching extension details.'|trans }}">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="extension-name"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div id="extension-readme" class="modal-body">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                </div>
            </div>
        </div>
    </div>
    <table class="table card-table table-vcenter table-striped sortable">
        <thead>
        <tr>
            <th class="w-1 no-sort"></th>
            <th>{{ 'Extension'|trans }}</th>
            <th>{{ 'Description'|trans }}</th>
            <th class="w-1 no-sort"></th>
            <th class="w-1 no-sort"></th>
        </tr>
        </thead>
        <tbody>
        {% set extensions = admin.extension_get_latest({ "type": type|default('mod')}) %}
        {% for extension in extensions %}
        {% set latest = extension.releases|default([])|first|default({}) %}
            <tr>
                <td class="text-nowrap">
                    {% if extension.icon_url|default('') %}
                        <img src="{{ extension.icon_url }}" alt="{{ extension.name|default('Extension') }}" style="width: 32px; height: 32px;">
                    {% else %}
                        <svg class="icon" style="width: 32px; height: 32px;"><use href="#settings" /></svg>
                    {% endif %}
                </td>
                <td class="text-wrap">
                    <strong>{{ extension.name|default('Unknown extension') }}</strong> {{ latest.tag|default('') }}<br>
                    {% set author = extension.author|default({}) %}
                    {% set author_name = author.id|default(author.name|default('Unknown')) %}
                    {% if author.URL|default('') %}
                    <span>by <a href="{{ author.URL }}" target="_blank">{{ author_name }}</a></span>
                    {% else %}
                    <span>by {{ author_name }}</span>
                    {% endif %}
                </td>
                <td class="text-wrap">
                    {{ extension.description|default('')|truncate(150) }}<br>
                    <a href="https://extensions.fossbilling.org/extension/{{ extension.id|default('') }}" target="_blank">{{ 'View on the extension directory'|trans }}</a>
                </td>
                <td class="text-nowrap" data-bs-toggle="tooltip" data-bs-title="{{ 'View extension README'|trans }}">
                    <a class="btn btn-icon" data-bs-toggle="modal" data-bs-target="#extensionReadMe" data-extension-id="{{ extension.id|default('') }}" data-extension-name="{{ extension.name|default('') }}">
                     <svg class="icon">
                         <use href="#eye" />
                     </svg>
                    </a>
                </td>
                <td class="text-nowrap">
                    <a class="btn btn-icon" href="{{ 'extension/install'|api_url(query: { 'type': extension.type|default('mod'), 'id': extension.id|default('') }) }}"
                        data-bs-toggle="tooltip" data-bs-title="{{ 'Install extension'|trans }}"
                        {{ fb_api_link({ message: 'By installing "' ~ extension.name|default('this extension') ~ '", you agree with terms and conditions. Only install extensions you trust. You also might want to have a full backup ready in case something goes wrong.'|trans, modal: {type: 'confirm', title: 'Are you sure?'|trans}, reload: true }) }}>
                        <svg class="icon">
                            <use href="#download" />
                        </svg>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center">
                    <a href="https://extensions.fossbilling.org/" target="_blank">{{ 'Explore FOSSBilling extensions'|trans }}</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <script>
        (() => {
            const modal = document.currentScript.parentElement.querySelector('#extensionReadMe');
            modal.addEventListener('show.bs.modal', (event) => {
                const trigger = event.relatedTarget;
                if (!trigger || !trigger.dataset.extensionId) {
                    return;
                }

                const header = modal.querySelector('#extension-name');
                header.textContent = trigger.dataset.extensionName;

                const readme = modal.querySelector('#extension-readme');
                readme.textContent = modal.dataset.fetchingMessage;

                // Ignore stale responses: opening another extension before
                // this request completes must not replace its README.
                const requestedId = trigger.dataset.extensionId;
                modal.dataset.currentExtensionId = requestedId;

                FOSSBilling.api.admin.post('extension/get_extension_readme', { extension_id: requestedId },
                    (result) => {
                        if (modal.dataset.currentExtensionId !== requestedId) {
                            return;
                        }
                        readme.innerHTML = result;
                    });
            });
        })();
    </script>
</div>
