{% macro markdown_quote(text) %}
    {% for line in text|split('\n') %}
        > {{ line }}
    {% endfor %}
{% endmacro markdown_quote %}

{% macro recaptcha() %}
{% include 'partial_recaptcha_shared.html.twig' %}
{% endmacro recaptcha %}

{% macro selectbox(name, options, selected, required, nullOption, id) %}
    <select name="{{ name }}" id="{{ id|default(name) }}" class="form-select{% if required %} is-required{% endif %}"{% if required %} required{% endif %}>
        {% if nullOption %}<option value="">{{ nullOption }}</option>{% endif %}
        {% for val, label in options %}
            <option value="{{ val }}" {% if selected == val %}selected{% endif %}>{{ label }}</option>
        {% endfor %}
    </select>
{% endmacro selectbox %}

{% macro status_name(status) %}
{% include 'partial_status_name_shared.html.twig' with {status: status} %}
{% endmacro status_name %}


{% macro status_badge(status, type) %}
{% include 'partial_status_badge_shared.html.twig' with {
    status: status, type: type, badge_variant: 'subtle'
} %}
{% endmacro %}

{% macro empty_list(colspan, message) %}
{% include 'partial_empty_list_shared.html.twig' with {colspan: colspan, message: message} %}
{% endmacro empty_list %}
