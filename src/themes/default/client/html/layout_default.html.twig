<!DOCTYPE html>
{% set active_locale = guest.system_locale|default('en')|replace({'_': '-'}) %}
{% set canonical_url = guest.system_current_url|url %}
{% set current_active_menu = active_menu|default('') %}
<html lang="{{ active_locale }}" data-bs-theme="{{ settings.theme|default('light') }}">
<head>
    <meta charset="utf-8">
    <title>{{ (settings.meta_title_prefix|default('') ~ ' ' ~ block('meta_title') ~ ' ' ~ settings.meta_title_suffix|default(''))|trim }}</title>

    <meta name="description" content="{% block meta_description %}{{ settings.meta_description|default('') }}{% endblock %}">
    <meta name="keywords" content="{{ settings.meta_keywords|default('') }}">
    <meta name="robots" content="{{ settings.meta_robots|default('') }}">
    <meta name="author" content="{{ settings.meta_author|default('') }}">
    <meta name="generator" content="FOSSBilling">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">

    {% block canonical %}
        <link rel="canonical" href="{{ canonical_url }}">
    {% endblock %}

    {% block opengraph %}
        <meta property="og:title" content="{{ (settings.meta_title_prefix|default('') ~ ' ' ~ block('meta_title') ~ ' ' ~ settings.meta_title_suffix|default(''))|trim }}" />
        <meta property="og:type" content="website" />
        <meta property="og:description" content="{{ block('meta_description') }}" />
        <meta property="og:url" content="{{ canonical_url }}" />
        <meta property="og:site_name" content="{{ guest.system_company.name }}" />
    {% endblock %}

    {{ include('partials/theme_init.html.twig') }}

    <link rel="stylesheet" href="{{ 'build/css/vendor.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'build/css/huraga.css' | asset_url }}">
    <link rel="shortcut icon" href="{{ guest.system_company.favicon_url }}">

    {{ 'js/fossbilling.js' | public_asset_url | script_tag }}
    {{ 'js/api.js' | public_asset_url | script_tag }}
    <script type="module" src="{{ 'build/js/huraga.js' | asset_url }}"></script>

    {{ debug_bar_render_head() }}

    {% block head %}{% endblock %}
    {% block js %}{% endblock %}
</head>

<body class="client-shell {% block body_class %}{% endblock %}">

<div class="d-none">{{ svg_sprite() }}</div>

{{ render_widgets('client.theme.body.start') }}

{% block body %}
{% if not client and settings.require_login and exception is not defined %}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const publicPaths = [
                '/invoice/',
                '/news',
                '/tos',
                '/privacy-policy'
                {% if guest.support_guest_tickets_enabled() %}
                ,'/support/contact-us'
                ,'/support/contact-us/conversation'
                ,'/support/ticket'
                {% endif %}
            ];
            const currentPath = window.location.pathname;

            const isAllowed = publicPaths.some(path => currentPath.startsWith(path));
            if (!isAllowed) {
                window.location.href = '{{ "login"|url }}';
            }
        });
    </script>
{% endif %}

{% if client and profile is not defined %}
    {% set profile = client.profile_get %}
{% endif %}
{% set company = guest.system_company %}
{% set guest_support_url = guest.support_guest_tickets_enabled() ? 'support/contact-us'|url : 'login'|url %}
{% set support_url = client ? 'support'|url : guest_support_url %}

<a class="visually-hidden-focusable client-skip-link" href="#main-content">{{ 'Skip to Content'|trans }}</a>
<div class="container client-container" id="top">
    <header class="client-header">
        {{ render_widgets('client.theme.header.start') }}
        <nav class="navbar navbar-expand-lg py-3" aria-label="{{ 'Main Navigation'|trans }}">
            <div class="container-fluid px-0">
                {{ include('partial_company_logo.html.twig', {
                    company: company,
                    logo_url: settings.show_company_logo ? company.logo_url : null,
                    dark_logo_url: settings.show_company_logo ? company.logo_url_dark : null,
                    link_class: 'navbar-brand',
                    image_height: '45px'
                }) }}
                <div class="client-header-actions d-flex d-lg-none align-items-center ms-auto">
                    <button class="navbar-toggler btn btn-icon btn-ghost-secondary client-header-icon" type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="{{ 'Toggle Navigation'|trans }}">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                <div class="collapse navbar-collapse flex-lg-grow-0 ms-lg-2" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-0 w-100 justify-content-lg-end align-items-lg-center client-header-menu">
                        {% set languages = guest.extension_languages(true) %}
                        {% if languages|length > 1 %}
                            <li class="nav-item client-language-menu">
                                <label class="visually-hidden" for="client-language">{{ 'Language'|trans }}</label>
                                <select id="client-language" name="lang" class="form-select js-locale-selector">
                                    {% for lang in languages %}
                                        <option value="{{ lang.locale }}" data-custom-properties="&lt;span class=&quot;fi fi-{{ lang.locale|split('_')[1]|lower }}&quot;&gt;&lt;/span&gt;"{% if lang.locale == guest.system_locale %} selected{% endif %}>{{ lang.title }}</option>
                                    {% endfor %}
                                </select>
                            </li>
                        {% endif %}

                        {% if settings.top_menu_profile and not client %}
                            <li class="nav-item d-lg-flex">
                                <a class="nav-link{% if current_active_menu == 'login' %} active{% endif %}" href="{{ 'login'|url }}"{% if current_active_menu == 'login' %} aria-current="page"{% endif %}>{{ 'Sign In'|trans }}</a>
                            </li>
                        {% endif %}

                        {% if settings.top_menu_signout %}
                            <li class="nav-item d-lg-flex{% if client %} client-account-menu-item order-1 order-lg-1{% endif %}">
                                {% if client %}
                                    <div class="dropdown client-dropdown">
                                        <button class="nav-link dropdown-toggle" id="client-account-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-controls="client-account-menu">
                                            {% set avatar_size = 28 %}
                                            {{ avatar(profile.email, avatar_size, 'avatar rounded-circle d-inline-block flex-shrink-0', null, 'div') }}
                                            <span class="client-account-name">{% if profile.company %}{{ profile.first_name }} {{ profile.last_name }} ({{ profile.company }}){% else %}{{ profile.first_name }} {{ profile.last_name }}{% endif %}</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-lg-end" id="client-account-menu" aria-labelledby="client-account-toggle">
                                            <li><a class="dropdown-item{{ current_active_menu == 'profile' ? ' active' : '' }}"
                                                   href="{{ 'client/profile'|url }}"{% if current_active_menu == 'profile' %} aria-current="page"{% endif %}>{{ 'Profile'|trans }}</a></li>
                                            <li><a class="dropdown-item"
                                                   href="{{ 'client/logout'|url }}">{{ 'Sign Out'|trans }}</a></li>
                                        </ul>
                                    </div>
                                {% else %}
                                    <a class="btn btn-outline-primary"
                                       href="{{ 'signup'|url }}">{{ 'Create an Account'|trans }}</a>
                                {% endif %}
                            </li>
                        {% endif %}

                        <li class="nav-item d-flex client-appearance-menu order-2 order-lg-0">
                            {{ include('partial_client_theme_picker.html.twig') }}
                        </li>

                        {% if client %}
                            <li class="nav-item d-flex client-notification-item order-3 order-lg-0">
                                {{ include('partial_client_notifications.html.twig') }}
                            </li>
                        {% endif %}

                        {% if client or not settings.hide_menu %}
                            <li class="d-lg-none client-mobile-menu order-4">
                                {{ include('mobile_menu.html.twig') }}
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
        {{ render_widgets('client.theme.header.end') }}
    </header>
    <div class="client-layout">
            <div class="row gy-4">
        {% if client or not settings.hide_menu %}
            <div class="col-lg-auto d-none d-lg-block client-sidebar-column">
                {{ include('partial_menu.html.twig') }}
            </div>
        {% endif %}
            <div class="col-12{% if client or not settings.hide_menu %} col-lg{% endif %} client-main-column">
                <div id="wrapper">
                    <main id="main-content" tabindex="-1">
                        {% block content_before %}{% endblock %}
                        <div class="content-block">
                            {% if settings.show_breadcrumb %}
                                {% block breadcrumbs %}
                                    {% set breadcrumb_items %}
                                        <li class="breadcrumb-item"><a href="{{ '/'|url }}">{{ 'Home'|trans }}</a></li>
                                        {% block breadcrumb %}
                                            <li class="active breadcrumb-item" aria-current="page">{{ 'Dashboard'|trans }}</li>
                                        {% endblock %}
                                    {% endset %}
                                    {{ include('partial_breadcrumbs.html.twig', {breadcrumb_items: breadcrumb_items, breadcrumb_class: 'mb-3'}) }}
                                {% endblock %}
                            {% endif %}

                            {{ render_widgets('client.theme.content.before') }}
                            {% block content %}{% endblock %}
                            {{ render_widgets('client.theme.content.after') }}

                            {{ include('partial_message.html.twig') }}

                            {% block content_after %}{% endblock %}
                        </div>
                    </main>
                    <div id="push"></div>
                </div>

                {% if settings.footer_enabled %}
                    <footer id="footer" class="small text-secondary client-footer">
                        <div class="d-flex flex-column">
                            {{ render_widgets('client.theme.footer.start') }}
                            <div class="d-flex justify-content-center flex-wrap text-center">
                                <span>&copy; {{ 'now'|date('Y') }} {{ settings.footer_signature|default(company.signature) }}
                                    {% if company.bank_info_pagebottom == 1 %}
                                        <br/>
                                        <b>{{'Payment Information'|trans}}</b> - {{'Bank Name'|trans}}: {{ company.bank_name|default('') }} | {{'BIC / SWIFT Code'|trans}}: {{ company.bic|default('') }} | {{'Account Number'|trans}}: {{ company.account_number|default('') }}
                                    {% endif %}
                                </span>
                            </div>
                            <div class="d-flex justify-content-center flex-wrap text-center">
                                {% set first_link_rendered = false %}
                                {% for i in 1..5 %}
                                    {% set enabled_key = 'footer_link_' ~ i ~ '_enabled' %}
                                    {% set page_key = 'footer_link_' ~ i ~ '_page' %}
                                    {% set title_key = 'footer_link_' ~ i ~ '_title' %}
                                    {% set link_enabled = attribute(settings, enabled_key) is defined ? attribute(settings, enabled_key) : false %}
                                    {% if link_enabled %}
                                        {% if first_link_rendered %}&nbsp;&#x2022;&nbsp;{% endif %}
                                        {% set link_page = attribute(settings, page_key)|default('') %}
                                        {% set link_title = attribute(settings, title_key)|default('') %}
                                        {% if 'http://' in link_page or 'https://' in link_page %}
                                            <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                               href="{{ link_page }}">{{ link_title }}</a>
                                        {% else %}
                                            <a class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                               href="{{ link_page|url }}">{{ link_title }}</a>
                                        {% endif %}
                                        {% set first_link_rendered = true %}
                                    {% endif %}
                                {% endfor %}
                            </div>
                            {{ render_widgets('client.theme.footer.end') }}
                        </div>
                    </footer>
                {% endif %}
            </div>
        </div>
    </div>
    {{ include('partial_client_announcements.html.twig') }}
    {{ include('partial_ui_feedback.html.twig', {feedback_area: 'client'}) }}
    {% if settings.footer_to_top_enabled %}
        <div class="d-flex justify-content-end my-3">
            <a href="#top" class="btn btn-outline-secondary">
                <svg class="icon" aria-hidden="true"><use href="#arrow-up" /></svg> {{ 'Back to Top'|trans }}
            </a>
        </div>
    {% endif %}
    <div class="wait" style="display:none" onclick="this.style.display='none'">
        <div class="spinner-border"
             style="width: 4rem; height: 4rem; top: 50%; left: 50%; position: fixed; z-index: 999"></div>
    </div>
    <noscript>{{ "NOTE: Many features on FOSSBilling require Javascript and cookies. You can enable both in your browser's preference settings."|trans }}</noscript>

    {% endblock %}

    {% if settings.inject_javascript %}
        {{ settings.inject_javascript|raw }}
    {% endif %}
    {{ include('partial_pending_messages.html.twig', ignore_missing: true) }}
    {% if guest.extension_is_on({ "mod": "cookieconsent" }) %}
        {{ include('mod_cookieconsent_index.html.twig', ignore_missing: true) }}
    {% endif %}
</div>
{{ render_widgets('client.theme.body.end') }}
{{ debug_bar_render() }}
</body>
</html>
