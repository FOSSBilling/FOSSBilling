{% if list.pages > 1 %}
    {% set url = url|default(guest.system_current_url|split('?')|first) %}
    {% embed 'partial_pagination_base.html.twig' %}
        {% block pagination_content %}
            {% set pagination_items = [
                {page: 1, label: 'First'|trans, icon: 'chevrons-left', disabled: currentPage == 1, edge: true},
                {page: max(1, currentPage - 1), label: 'Previous'|trans, icon: 'chevron-left', disabled: currentPage == 1, rel: 'prev'}
            ] %}
            {% for page in max(1, currentPage - 1)..min(list.pages, currentPage + 1) %}
                {% set pagination_items = pagination_items|merge([{page: page}]) %}
            {% endfor %}
            {% set pagination_items = pagination_items|merge([
                {page: min(list.pages, currentPage + 1), label: 'Next'|trans, icon: 'chevron-right', disabled: currentPage == list.pages, rel: 'next'},
                {page: list.pages, label: 'Last'|trans, icon: 'chevrons-right', disabled: currentPage == list.pages, edge: true}
            ]) %}
            <nav aria-label="{{ 'Pagination'|trans }}">
                <p class="small text-secondary text-center mb-2">{{ 'Page %page% of %pages%'|trans({'%page%': currentPage, '%pages%': list.pages}) }}</p>
                {% include 'partial_pagination_items.html.twig' with {pagination_class: 'justify-content-center flex-wrap mb-0'} %}
            </nav>
        {% endblock %}
    {% endembed %}
{% endif %}
