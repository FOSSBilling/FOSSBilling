{% extends 'layout_public.html.twig' %}

{% block body %}
    <main class="container py-4 py-md-5">
        <div class="client-auth-panel {% block auth_width %}{% endblock %} mx-auto">
            {% if (public_logo_url or public_dark_logo_url) and settings.login_page_show_logo %}
                <div class="d-flex justify-content-center mb-4">
                    {{ include('partial_company_logo.html.twig', {
                        company: company, logo_url: public_logo_url, dark_logo_url: public_dark_logo_url,
                        link_url: settings.login_page_logo_url|default('/'), link_target: '_blank', link_rel: 'noopener noreferrer',
                        link_class: 'client-auth-logo', image_class: 'img-fluid', image_height: '50px'
                    }) }}
                </div>
            {% endif %}
            <div class="card mb-3"><div class="card-body p-3 p-md-4">{% block auth_content %}{% endblock %}</div></div>
        </div>
    </main>
{% endblock %}
