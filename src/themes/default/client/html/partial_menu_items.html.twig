{% set current_active_menu = current_active_menu|default(active_menu|default('')) %}
{% if support_url is not defined %}
    {% set support_url = client ? 'support'|url : (guest.support_guest_tickets_enabled() ? 'support/contact-us'|url : 'login'|url) %}
{% endif %}
<ul class="nav flex-column client-menu">
    {% if settings.side_menu_dashboard %}
        <li class="nav-item offcanvas-item{% if current_active_menu == 'dashboard' %} active{% endif %}">
            <a class="nav-link d-flex align-items-center gap-2{% if current_active_menu == 'dashboard' %} active{% endif %}" href="{{ '/'|url }}"{% if current_active_menu == 'dashboard' %} aria-current="page"{% endif %}>
                <svg class="icon" aria-hidden="true"><use href="#layout-grid" /></svg>
                {{ 'Dashboard'|trans }}
            </a>
        </li>
    {% endif %}

    {% if settings.side_menu_order %}
        <li class="nav-item offcanvas-item{% if current_active_menu == 'order' %} active{% endif %}">
            <a class="nav-link d-flex align-items-center gap-2{% if current_active_menu == 'order' %} active{% endif %}" href="{{ 'order'|url }}"{% if current_active_menu == 'order' %} aria-current="page"{% endif %}>
                <svg class="icon" aria-hidden="true"><use href="#shopping-cart" /></svg>
                {{ 'Order'|trans }}
            </a>
        </li>
    {% endif %}

    {% if settings.side_menu_support %}
        <li class="nav-item offcanvas-item{% if current_active_menu == 'support' %} active{% endif %}">
            <a class="nav-link d-flex align-items-center gap-2{% if current_active_menu == 'support' %} active{% endif %}" href="{{ support_url }}"{% if current_active_menu == 'support' %} aria-current="page"{% endif %}>
                <svg class="icon" aria-hidden="true"><use href="#lifebuoy" /></svg>
                {{ 'Support'|trans }}
            </a>
        </li>
    {% endif %}

    {% if settings.side_menu_services %}
        <li class="nav-item offcanvas-item{% if current_active_menu == 'services' %} active{% endif %}">
            <a class="nav-link d-flex align-items-center gap-2{% if current_active_menu == 'services' %} active{% endif %}" href="{{ 'order/service'|url }}"{% if current_active_menu == 'services' %} aria-current="page"{% endif %}>
                <svg class="icon" aria-hidden="true"><use href="#apps" /></svg>
                {{ 'Services'|trans }}
            </a>
        </li>
    {% endif %}

    {% if settings.side_menu_invoices %}
        <li class="nav-item offcanvas-item{% if current_active_menu == 'invoices' %} active{% endif %}">
            <a class="nav-link d-flex align-items-center gap-2{% if current_active_menu == 'invoices' %} active{% endif %}" href="{{ 'invoice'|url }}"{% if current_active_menu == 'invoices' %} aria-current="page"{% endif %}>
                <svg class="icon" aria-hidden="true"><use href="#receipt" /></svg>
                {{ 'Invoices'|trans }}
            </a>
        </li>
    {% endif %}

    {% if settings.side_menu_emails %}
        <li class="nav-item offcanvas-item{% if current_active_menu == 'emails' %} active{% endif %}">
            <a class="nav-link d-flex align-items-center gap-2{% if current_active_menu == 'emails' %} active{% endif %}" href="{{ 'email'|url }}"{% if current_active_menu == 'emails' %} aria-current="page"{% endif %}>
                <svg class="icon" aria-hidden="true"><use href="#mail" /></svg>
                {{ 'Emails'|trans }}
            </a>
        </li>
    {% endif %}

    {% if settings.side_menu_payments and (client or guest.invoice_funds_enabled) %}
        <li class="nav-item offcanvas-item{% if current_active_menu == 'payments' %} active{% endif %}">
            <a class="nav-link d-flex align-items-center gap-2{% if current_active_menu == 'payments' %} active{% endif %}" href="{{ 'client/balance'|url }}"{% if current_active_menu == 'payments' %} aria-current="page"{% endif %}>
                <svg class="icon" aria-hidden="true"><use href="#wallet" /></svg>
                {{ 'Wallet'|trans }}
            </a>
        </li>
    {% endif %}

    {% if (guest.extension_is_on({"mod":"news"}) and settings.side_menu_news) %}
        <li class="nav-item offcanvas-item{% if current_active_menu == 'news' %} active{% endif %}">
            <a class="nav-link d-flex align-items-center gap-2{% if current_active_menu == 'news' %} active{% endif %}" href="{{ 'news'|url }}"{% if current_active_menu == 'news' %} aria-current="page"{% endif %}>
                <svg class="icon" aria-hidden="true"><use href="#news" /></svg>
                {{ 'News'|trans }}
            </a>
        </li>
    {% endif %}

    {% if (guest.support_kb_enabled() and settings.side_menu_kb) %}
        <li class="nav-item offcanvas-item{% if current_active_menu == 'kb' %} active{% endif %}">
            <a class="nav-link d-flex align-items-center gap-2{% if current_active_menu == 'kb' %} active{% endif %}" href="{{ 'support/kb'|url }}"{% if current_active_menu == 'kb' %} aria-current="page"{% endif %}>
                <svg class="icon" aria-hidden="true"><use href="#book" /></svg>
                {{ 'Knowledge Base'|trans }}
            </a>
        </li>
    {% endif %}

    {% if settings.sidebar_balance_enabled and client %}
        <li class="pt-3 ps-3">
            <div class="h5 text-secondary d-block pb-1 client-menu-label">{{ 'Account Balance'|trans }}</div>
            {% if profile.currency is not null %}
                <p class="h4 mb-0"><strong>{{ profile.balance|format_currency(profile.currency ?? default_currency) }}</strong></p>
            {% else %}
                <p class="h4 mb-0"><strong>-</strong></p>
            {% endif %}
        </li>
    {% endif %}

    {% if settings.sidebar_note_enabled %}
        <li class="pt-3 ps-3">
            <div class="h5 text-secondary d-block pb-1 client-menu-label">{{ settings.sidebar_note_title }}</div>
            <span>{{ settings.sidebar_note_content }}</span>
        </li>
    {% endif %}
</ul>
