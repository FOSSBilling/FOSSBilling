{% block subject %}[{{ guest.system_company.name }}] Order #{{ order.id|default('') }} suspended{% endblock %}
{% block content %}
{% set order = order|default({}) %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
</head>
<body>
    <h1>Order Suspended</h1>
    <p>Hello {{ staff.name|default('') }},</p>
    <p>The service <strong>{{ order.title|default('') }}</strong> for <strong>{{ order.client.first_name|default('') }} {{ order.client.last_name|default('') }}</strong> has been suspended.</p>
    {% if order.reason|default('') %}
        <p><strong>Reason:</strong> {{ order.reason }}</p>
    {% endif %}
    <p><a href="{{ "order/manage/#{order.id|default('')}"|url(area: 'admin') }}" target="_blank">Manage order</a></p>
    <div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
