{% block subject %}[{{ guest.system_company.name }}] {{ 'Cancellation request'|trans }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		strong {
			font-weight: bold;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>{{ 'Cancellation request'|trans }}</h1>
	<p>{{ 'A client asked to cancel a service: %title% (order #%id%).'|trans({'%title%': order.title|default(''), '%id%': order.id|default('')}) }}</p>
	<p>{{ 'Client: %name%'|trans({'%name%': client.name|default('')}) }}</p>
	<p>{{ 'Review it here:'|trans }} <a href="{{ order.url|default('#') }}" target="_blank">{{ 'Open order'|trans }}</a></p>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
