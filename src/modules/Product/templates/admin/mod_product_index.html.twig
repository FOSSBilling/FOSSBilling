{% extends 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% set active_menu = 'products' %}
{% set product_toolbar_actions %}
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#newProductModal">
        <svg class="icon">
            <use href="#plus" />
        </svg>
        {{ 'New Product'|trans }}
    </button>
{% endset %}

{% block meta_title %}{{ 'Products'|trans }}{% endblock %}

{% block top_content %}
    {{ include('partial_admin_page_heading.html.twig', {title: 'Products'|trans}) }}
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-pills card-header-pills flex-nowrap text-nowrap overflow-x-auto" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="index-tab" data-bs-toggle="tab" data-bs-target="#tab-index" type="button" role="tab" aria-controls="tab-index" aria-selected="true">{{ 'Products'|trans }}</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="categories-tab" data-bs-toggle="tab" data-bs-target="#tab-categories" type="button" role="tab" aria-controls="tab-categories" aria-selected="false">{{ 'Categories'|trans }}</button>
                </li>
            </ul>
        </div>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-index" role="tabpanel" aria-labelledby="index-tab" data-list-ns="">
                {{ include('partial_search.html.twig', { search_toolbar_actions: product_toolbar_actions, search_max_width: 'none' }) }}
                <form method="post" action="{{ 'product/update_priority'|api_url }}" {{ fb_api_form({reload: true}) }}>
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    {{ include('partial_sortable_th.html.twig', { 'label': '#'|trans, 'sort_key': 'id', 'url': 'product', 'hash': '#tab-index', 'default_sort': 'priority', 'default_direction': 'ASC' }) }}
                                    {{ include('partial_sortable_th.html.twig', { 'label': 'Product'|trans, 'sort_key': 'title', 'url': 'product', 'hash': '#tab-index', 'default_sort': 'priority', 'default_direction': 'ASC' }) }}
                                    {{ include('partial_sortable_th.html.twig', { 'label': 'Status'|trans, 'sort_key': 'status', 'url': 'product', 'hash': '#tab-index', 'default_sort': 'priority', 'default_direction': 'ASC' }) }}
                                    <th class="text-end">{{ 'Pricing'|trans }}</th>
                                    <th>{{ 'Stock'|trans }}</th>
                                    {{ include('partial_sortable_th.html.twig', { 'label': 'Priority'|trans, 'sort_key': 'priority', 'url': 'product', 'hash': '#tab-index', 'th_class': 'w-1 text-center', 'default_sort': 'priority', 'default_direction': 'ASC' }) }}
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set products = admin.product_get_list({ 'per_page': 25, 'page': request.page }|merge(request)) %}
                                {% set currency_code = admin.currency_get_default.code %}
                                {% for product in products.list %}
                                <tr>
                                    <td class="text-secondary">{{ product.id }}</td>
                                    <td>
                                        <a class="fw-semibold" href='{{ "product/manage/#{product.id}"|url }}'>{{ product.title }}</a>
                                        <div class="text-secondary small">
                                            {{ mf.status_name(product.type) }}
                                            {% if product.category is defined %}
                                                · <a class="text-secondary" href='{{ "product/category/#{product.category.id}"|url }}'>{{ product.category.title }}</a>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td>
                                        {{ mf.status_badge(product.status, 'product', true) }}
                                        {% if product.hidden %}
                                            <div class="mt-1"><span class="badge bg-warning-subtle text-warning-emphasis">{{ 'Hidden'|trans }}</span></div>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">{{ include('partial_product_price.html.twig') }}</td>
                                    <td>{{ include('partial_product_stock.html.twig') }}</td>
                                    <td class="text-center">
                                        <input type="text" class="form-control form-control-sm" aria-label="{{ 'Priority for %product%'|trans({'%product%': product.title}) }}" name="priority[{{ product.id }}]" value="{{ product.priority }}" size="2">
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-ghost-secondary btn-icon btn-sm" aria-label="{{ 'Edit Product'|trans }}" href='{{ "product/manage/#{product.id}"|url }}'>
                                            <svg class="icon">
                                                <use href="#edit" />
                                            </svg>
                                        </a>
                                        <a class="btn btn-ghost-secondary btn-icon btn-sm" aria-label="{{ 'Delete Product'|trans }}" href="{{ 'product/delete'|api_url({'id' : product.id }) }}"
                                            {{ fb_api_link({modal: {type: 'confirm', title: 'Are you sure?'|trans}, redirect: 'product'|url}) }}>
                                            <svg class="icon">
                                                <use href="#trash" />
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td class="text-muted" colspan="7">{{ 'The list is empty'|trans }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>

                    </div>
                    <div class="card-footer d-flex flex-wrap align-items-center justify-content-end gap-3">
                        {{ include('partial_pagination.html.twig', { 'list': products, 'url': 'product', 'split_footer_controls': true }) }}
                        <button type="submit" class="btn btn-outline-secondary">
                            <svg class="icon"><use href="#refresh" /></svg>
                            {{ 'Update Priority'|trans }}
                        </button>
                    </div>
                </form>
            </div>

            <div class="tab-pane fade" id="tab-categories" role="tabpanel" aria-labelledby="categories-tab">
                <div class="p-3 border-bottom d-flex justify-content-end">
                    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
                        <svg class="icon">
                            <use href="#plus" />
                        </svg>
                        {{ 'New Category'|trans }}
                    </button>
                </div>
                <form method="post" action="{{ 'product/category_update_priority'|api_url }}" {{ fb_api_form({reload: true}) }}>
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    <th class="w-1">#</th>
                                    <th>{{ 'Title'|trans }}</th>
                                    <th class="w-1 text-center">{{ 'Priority'|trans }}</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for category in admin.product_category_get_list %}
                                <tr>
                                    <td>{{ category.id }}</td>
                                    <td>
                                        <a class="fw-semibold" href='{{ "product/category/#{category.id}"|url }}'>{{ category.title }}</a>
                                    </td>
                                    <td class="text-center">
                                        <input type="text" class="form-control form-control-sm" aria-label="{{ 'Priority for %category%'|trans({'%category%': category.title}) }}" name="priority[{{ category.id }}]" value="{{ category.priority }}" size="2">
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-ghost-secondary btn-icon btn-sm" aria-label="{{ 'Edit Category'|trans }}" href='{{ "product/category/#{category.id}"|url }}'>
                                            <svg class="icon">
                                                <use href="#edit" />
                                            </svg>
                                        </a>
                                        <a class="btn btn-ghost-secondary btn-icon btn-sm" aria-label="{{ 'Delete Category'|trans }}" href="{{ 'product/category_delete'|api_url(query: { 'id': category.id }) }}"
                                            {{ fb_api_link({modal: {type: 'confirm', title: 'Are you sure?'|trans}, redirect: 'product#tab-categories'|url}) }}>
                                            <svg class="icon">
                                                <use href="#trash" />
                                            </svg>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td class="text-muted" colspan="4">{{ 'The list is empty'|trans }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer text-end">
                        <button type="submit" class="btn btn-outline-secondary">
                            <svg class="icon">
                                <use href="#refresh" />
                            </svg>
                            {{ 'Update Priority'|trans }}
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="modal modal-blur fade" id="newProductModal" tabindex="-1" aria-labelledby="newProductModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" method="post" action="{{ 'product/prepare'|api_url }}" {{ fb_api_form({reload: true}) }}>
                    <div class="modal-header">
                        <h3 class="modal-title" id="newProductModalLabel">{{ 'Create New Product'|trans }}</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">{{ 'Type'|trans }}</label>
                            {{ mf.selectbox('type', admin.product_get_types, request.type, 1) }}
                        </div>
                        <div class="mb-3">
                            <label class="form-label">{{ 'Category'|trans }}</label>
                            {{ mf.selectbox('product_category_id', admin.product_category_get_pairs, request.product_category_id, 1) }}
                        </div>
                        <div class="mb-0">
                            <label class="form-label" for="new-product-title">{{ 'Title'|trans }}</label>
                            <input type="text" class="form-control" id="new-product-title" name="title" value="{{ request.title }}" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button class="btn btn-primary" type="submit">{{ 'Create'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="modal modal-blur fade" id="newCategoryModal" tabindex="-1" aria-labelledby="newCategoryModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <form class="modal-content" method="post" action="{{ 'product/category_create'|api_url }}" {{ fb_api_form({redirect: 'product#tab-categories'|url}) }}>
                    <div class="modal-header">
                        <h3 class="modal-title" id="newCategoryModalLabel">{{ 'Create New Category'|trans }}</h3>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="new-category-title">{{ 'Title'|trans }}</label>
                            <input type="text" class="form-control" id="new-category-title" name="title" value="{{ request.cat_title }}" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="new-category-icon-url">{{ 'Icon URL'|trans }}</label>
                            <input type="text" class="form-control" id="new-category-icon-url" name="icon_url" value="">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="new-category-priority">{{ 'Priority'|trans }}</label>
                            <input type="number" class="form-control" id="new-category-priority" name="priority" value="" placeholder="{{ 'Optional. Lower values are shown first.'|trans }}">
                        </div>
                        <div class="mb-0">
                            <label class="form-label" for="new-category-description">{{ 'Description'|trans }}</label>
                            <textarea class="form-control editor-textarea" id="new-category-description" name="description" rows="5">{{ request.cat_description }}</textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button class="btn btn-primary" type="submit">{{ 'Create'|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block js %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const modalConfigs = [
        { elementId: 'newProductModal', hash: '#tab-new' },
        { elementId: 'newCategoryModal', hash: '#tab-new-category' }
    ];

    for (const { elementId, hash } of modalConfigs) {
        const modalElement = document.getElementById(elementId);
        if (!modalElement) {
            continue;
        }

        const modal = tabler.Modal.getOrCreateInstance(modalElement);
        if (window.location.hash === hash) {
            modal.show();
        }

        modalElement.addEventListener('hidden.bs.modal', function () {
            if (window.location.hash !== hash) {
                return;
            }

            const url = new URL(window.location.href);
            url.hash = '';
            window.history.replaceState({}, '', url);
        });
    }
});
</script>
{% endblock %}

{% block head %}{{ wysiwyg('.editor-textarea') }}{% endblock %}
