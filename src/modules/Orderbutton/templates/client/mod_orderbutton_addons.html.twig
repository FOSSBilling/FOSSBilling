{% if product.addons is defined and product.addons|length > 0 %}
<h4 class="mt-4 mb-1"><strong>{{ 'Addons & Extras'|trans }}</strong></h4>
<div class="table-responsive"><table class="table table-vcenter table-sm table-borderless table-striped">
  <tbody>
    {% for addon in product.addons %}
    <tr>
      <td {% if not addon.icon_url %}style="display: none" {% endif %}>
        <label><img src="{{ addon.icon_url }}" alt="" width="36" /></label>
      </td>

      <td>
        <label>
          <h6 class="h4"><strong>{{ addon.title }}</strong></h6>
        </label>
        {{ (addon.description ?? '')|markdown_to_html }}
      </td>

      <td>
        <label class="currency">
          {% set cart_currency = guest.cart_get_currency %}
          {% if addon.pricing.type is same as('recurrent') %}
          <select class="form-select" aria-label="{{ 'Billing Cycle for %product%'|trans({'%product%': addon.title}) }}" name="addons[{{ addon.id }}][period]" rel="addon-periods-{{ addon.id }}">
            {% for code, prices in addon.pricing.recurrent %}
            {% if prices.enabled %}
            <option value="{{ code }}">{{ (prices.price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }} {% if prices.setup !=
              '0.00' %}{{ 'Setup:'|trans }} {{ (prices.setup * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}{% endif %} ({{ prices.title }})</option>
            {% endif %}
            {% endfor %}
          </select>
          {% endif %}

          {% if addon.pricing.type is same as('once') %}
          <span>{{ (addon.pricing.once.price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }} · {{ 'One-Time Payment'|trans }}</span>
          {% if addon.pricing.once.setup %}<div class="small">+ {{ (addon.pricing.once.setup * cart_currency.conversion_rate)|format_currency(cart_currency.code) }} {{ 'setup fee'|trans }}</div>{% endif %}
          {% endif %}

          {% if addon.pricing.type is same as('free') %}
          <span class="badge text-bg-success">{{ 0|format_currency(cart_currency.code) }}</span>
          {% endif %}
        </label>

        <div class="float-end d-flex align-items-center gap-2">
          {% if addon.allow_quantity_select %}
          <input
            type="number"
            name="addons[{{ addon.id }}][quantity]"
            value="1"
            min="1"
            class="form-control"
            style="max-width: 90px; text-align: center;"
            aria-label="{{ 'Quantity for %product%'|trans({'%product%': addon.title}) }}"
          >
          {% endif %}
          <input type="radio" class="btn-check" name="addons[{{ addon.id }}][selected]" value="1"
            id="addon_{{ addon.id }}" autocomplete="off">
          <label class="btn btn-outline-success" for="addon_{{ addon.id }}" data-bs-toggle="tooltip"
            data-bs-title="{{ 'Add to Cart'|trans }}">
            {{ 'Include'|trans }}<span class="visually-hidden"> {{ addon.title }}</span>
          </label>

          <input type="radio" class="btn-check" name="addons[{{ addon.id }}][selected]" value="0"
            id="addon_{{ addon.id }}_decline" autocomplete="off" checked>
          <label class="btn btn-outline-danger" for="addon_{{ addon.id }}_decline" data-bs-toggle="tooltip"
            data-bs-title="{{ 'Remove from Cart'|trans }}">
            {{ 'Not Included'|trans }}<span class="visually-hidden"> {{ addon.title }}</span>
          </label>
        </div>
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table></div>
{% endif %}
