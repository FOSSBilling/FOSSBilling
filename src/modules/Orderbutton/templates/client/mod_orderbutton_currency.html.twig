{% set currencies = guest.currency_get_pairs %}
{% if currencies|length > 1 %}
    <div class="d-flex align-items-center gap-2">
        <label for="currency" class="form-label mb-0">{{ 'Currency'|trans }}</label>
        <select id="currency" name="currency" class="currency_selector form-select">
            {% set selected = guest.cart_get_currency.code %}
            {% for code, name in currencies %}
                <option value="{{ code }}" class="currency_{{ code }}"{% if code == selected %} selected{% endif %}>{{ code }} - {{ name }}</option>
            {% endfor %}
        </select>
    </div>
{% endif %}
