{% set cart = guest.cart_get %}
{% set order_stage = order_stage|default(request.checkout|default(false) ? 'checkout' : 'browse') %}
<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button {{ order_stage != 'checkout' ? 'collapsed' : '' }}" type="button" data-bs-toggle="collapse" data-bs-target="#checkout" aria-expanded="{{ order_stage == 'checkout' ? 'true' : 'false' }}" aria-controls="checkout"{% if not cart.items %} disabled{% endif %}>
            <svg class="icon me-2"><use href="#shopping-cart" /></svg>
            <span>{{ 'Review Order'|trans }}</span>&nbsp;<span class="badge text-bg-success">{{ cart.items | length }}</span>
        </button>
    </h2>
    {% if cart.items %}
    {% set cart_currency = cart.currency %}
    {% set currency_mismatch = client and profile.currency|default('') and profile.currency != cart_currency.code %}
    <div id="checkout" class="accordion-collapse collapse {{ order_stage == 'checkout' ? 'show' : '' }}">
        <div class="accordion-body">
            <div class="accordion-inner" id="checkout-inner">
                <div class="table-responsive">
                <table class="table table-vcenter table-hover client-cart-items">
                    <thead>
                    <tr>
                        <th scope="col">{{ 'Product'|trans }}</th>
                        <th scope="col">{{ 'Amount'|trans }}</th>
                        <th scope="col"><span class="visually-hidden">{{ 'Actions'|trans }}</span></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for i, item in cart.items %}
                        <tr>
                            <td class="cart-description">
                                <strong>{{ item.title }}</strong>
                                <div class="small text-secondary">{{ 'Quantity'|trans }}: {{ item.quantity }} · {% if item.period|default(false) %}{{ item.period|period_title }}{% else %}{{ 'One-Time Payment'|trans }}{% endif %}</div>
                            </td>
                            <td class="cart-amount">
                                <span class="d-block d-md-none small text-secondary" aria-hidden="true">{{ 'Amount'|trans }}</span>
                                {% if item.discount_price %}
                                    <del>{{ (item.total * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</del>
                                    <strong class="text-success-emphasis">{{ ((item.total - item.discount_price) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong>
                                {% else %}
                                    {{ (item.total * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                                {% endif %}
                            </td>
                            <td class="cart-action">
                                <a class="btn btn-outline-secondary btn-sm" aria-label="{{ 'Remove %product% from Cart'|trans({'%product%': item.title}) }}" title="{{ 'Remove Item'|trans }}"
                                   {{ fb_api_link({href: 'cart/remove_item'|api_url(query: {id: item.id}, role: 'guest'), modal: {type: 'confirm', title: 'Remove Item from Cart'|trans, content: 'Remove "%product%" from your cart?'|trans({'%product%': item.title}), button: 'Remove Item'|trans, cancelButton: 'Keep Item'|trans}, loading: {button: 'Removing Item…'|trans}, reload: true}) }}>
                                    <svg class="icon"><use href="#x" /></svg>
                                </a>
                            </td>
                        </tr>

                        {% if request.show_custom_form_values %}
                            <tr>
                                <td colspan="3" class="cart-custom-fields">
                                    {% if item.form_id and guest.extension_is_on({"mod":"formbuilder"}) %}
                                        {% set form = guest.formbuilder_get({"id": item.form_id}) %}
                                        {# debug form #}
                                        <div class="well">
                                            <dl class="row">
                                                {% for field, value in item %}
                                                    {% for form_field in form.fields %}
                                                        {% if value is not empty %}
                                                            {% if form_field.name == field%}
                                                                <dt>
                                                                    {{form_field.label}}
                                                                </dt>
                                                                <dd>
                                                                    {% if form_field.type == "checkbox"%}
                                                                        {% for selection in value %}
                                                                            {% for field_key,field_value in form_field.options%}
                                                                                {% if field_value == selection %}
                                                                                    {{ field_key }}
                                                                                {% endif %}
                                                                            {% endfor %}
                                                                        {% endfor%}
                                                                    {% elseif form_field.type == "select" or form_field.type == "radio" %}
                                                                        {% for field_key,field_value in form_field.options%}
                                                                            {% if field_value == value %}
                                                                                {{ field_key }}
                                                                            {% endif %}
                                                                        {% endfor %}
                                                                    {% else %}
                                                                        {{value}}
                                                                    {% endif %}
                                                                </dd>
                                                            {% endif %}
                                                        {% endif %}
                                                    {% endfor %}
                                                {% endfor %}
                                            </dl>
                                        </div>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endif %}

                        {% if item.setup_price != 0 %}
                            <tr>
                                <td class="cart-description">{{ item.title }} <span class="small text-secondary">— {{ 'One-Time Setup Fee'|trans }}</span></td>
                                <td class="cart-amount">
                                    <span class="d-block d-md-none small text-secondary" aria-hidden="true">{{ 'Amount'|trans }}</span>
                                    {% if item.discount_setup %}
                                    <del>{{ (item.setup_price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</del>
                                    {{ ((item.setup_price - item.discount_setup) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                                    {% else %}
                                    {{ (item.setup_price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                                {% endif %}
                                </td>
                            </tr>
                        {% endif %}

                    {% endfor %}
                    </tbody>
                </table>
                </div>
                <a href="{{ 'order'|url }}" class="d-inline-block mb-4">{{ 'Add Another Product'|trans }}</a>

                <div class="row g-4">
                    <div class="col-md-6">
                        {% if not cart.promocode %}
                            <button type="button" class="btn btn-link p-0" id="show-promo-field" aria-expanded="false" aria-controls="apply-promo">{{ 'Have a coupon code?'|trans }}</button>
                        {% endif %}

                        <form method="post" action="{{ 'cart/apply_promo'|api_url(role: 'guest') }}" {{ fb_api_form({message: 'Promo Code Applied to Order'|trans, reload: true}) }}
                            {% if not cart.promocode %}style="display:none"{% endif %} id="apply-promo">
                            <div class="control-group">
                                <div class="form-controls">
                                    <div class="d-flex flex-wrap gap-2">
                                        <label class="visually-hidden" for="promocode">{{ 'Coupon Code'|trans }}</label>
                                        <input class="form-control" type="text" name="promocode" id="promocode" value="{{ request.promocode|default(cart.promocode) }}" {% if promo|default({}).required|default(false) %}required="required"{% endif %} placeholder="{{ 'Enter code'|trans }}">
                                        {% if cart.promocode %}
                                            <a class="btn btn-outline-secondary btn-sm mb-1" href="{{ 'cart/remove_promo'|api_url(role: 'guest') }}" type="button" {{ fb_api_link({reload: true}) }}>{{ 'Remove'|trans }}</a>
                                        {% else %}
                                            <button class="btn btn-outline-secondary btn-sm mb-1" type="submit">{{ 'Apply'|trans }}</button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-md-6">
                        <table class="table client-cart-totals">
                            <caption class="visually-hidden">{{ 'Order Total'|trans }} ({{ cart_currency.code }})</caption>
                                <tr>
                                    <th scope="row"><strong>{{ 'Subtotal:'|trans }}</strong></th>
                                    <td><strong>{{ (cart.subtotal * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong></td>
                                </tr>
                            {% if cart.discount > 0 %}
                                <tr>
                                    <th scope="row"><strong>{{ 'Discount:'|trans }}</strong></th>
                                    <td><strong>- {{ (cart.discount * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong></td>
                                </tr>
                                {% for auto_promo in cart.auto_promos|default([]) %}
                                <tr>
                                    <th scope="row" class="ps-4 fw-normal"><span class="text-secondary">{{ auto_promo.title }}</span></th>
                                    <td>{{ (auto_promo.discount * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</td>
                                </tr>
                                {% endfor %}
                            {% endif %}

                            {% set tax_amount = 0 %}
                            {% if client and client.client_is_taxable %}
                                {% set tax_rate = client.invoice_get_tax_rate %}
                                {% set tax_amount = cart.total * tax_rate / 100 %}
                                <tr>
                                    <th scope="row"><strong>{{ 'VAT'|trans }} ({{ tax_rate }}%) :</strong></th>
                                    <td><strong>{{ (tax_amount * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong></td>
                                </tr>
                            {% endif %}
                            <tr>
                                <th scope="row"><strong>{{ client ? 'Total Due Now'|trans : 'Total Before Tax'|trans }} ({{ cart_currency.code }})</strong></th>
                                <td><strong>{{ ((cart.total + tax_amount) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong></td>
                            </tr>

                        </table>
                        {% if not client %}<p class="small text-secondary">{{ 'Any applicable tax will be calculated after you sign in or create an account.'|trans }}</p>{% endif %}

                        {% if currency_mismatch %}<p role="alert" class="text-danger-emphasis">{{ 'Your account uses %currency%. Select that currency above before placing your order.'|trans({'%currency%': profile.currency}) }}</p>{% endif %}
                        <form data-unsaved-changes method="post" action="{{ 'cart/checkout'|api_url }}" {{ fb_api_form({callback: 'onOrderCheckout'}) }}>
                            <fieldset>
                                {% set payable_total = ((cart.total + tax_amount) * cart_currency.conversion_rate)|round(2) %}
                                {% set enough_in_balance = client and not currency_mismatch and payable_total > 0 ? (profile.balance ?? client.client_balance_get_total)|round(2) >= payable_total : false %}
                                {% if client and cart.total and not enough_in_balance %}
                                    <fieldset class="control-group">
                                        <legend class="form-label">{{ 'Payment Method'|trans }}</legend>
                                        <p class="small text-secondary mb-2">{{ 'Choose a payment method to continue with your order.'|trans }}</p>
                                        <div class="d-flex flex-wrap gap-3">
                                        {% set gateway_selected = false %}
                                        {% for gtw in guest.invoice_gateways %}
                                            {% if gtw.code|default('') != 'ClientBalance' and cart.currency.code in gtw.accepted_currencies and (gtw.allow_single or (cart.subscribable|default(false) and gtw.allow_recurrent)) %}
                                                {% set gateway_input_id = 'order-gateway-' ~ gtw.id %}
                                                <div class="invoice-gateway rounded-2 p-2">
                                                    <input type="radio" class="btn-check border-0" name="gateway_id" id="{{ gateway_input_id }}" value="{{ gtw.id }}" autocomplete="off" {{ not gateway_selected ? 'checked' : '' }}/>
                                                    {% if gtw.logo.logo %}
                                                        <label class="btn d-flex align-items-center gap-2" for="{{ gateway_input_id }}">
                                                            <picture>
                                                                {% if gtw.logo.avif|default(null) %}
                                                                    <source srcset="{{ gtw.logo.avif }}" type="image/avif">
                                                                {% endif %}
                                                                <img class="fb-image-contain" src="{{ gtw.logo.logo }}" alt="" width="48" height="32">
                                                            </picture>
                                                            <span>{{ gtw.title }}</span>
                                                        </label>
                                                    {% else %}
                                                        <label class="btn" for="{{ gateway_input_id }}">{{ gtw.title }}</label>
                                                    {% endif %}
                                                </div>
                                                {% set gateway_selected = true %}
                                            {% endif %}
                                        {% endfor %}
                                        </div>
                                        {% if not gateway_selected %}<p class="mt-2">{{ 'No payment methods are currently available for this order. Please contact support.'|trans }}</p>{% endif %}
                                    </fieldset>
                                {% endif %}
                                <div class="control-group">
                                    <div class="controls mt-3">
                                        {% if enough_in_balance %}
                                            <p>{{ 'Total amount will be deducted from account balance'|trans }}: <strong>{{ payable_total|format_currency(cart_currency.code) }}</strong>.</p>
                                        {% endif %}
                                        {% if settings.checkout_tos|default('0') == 'explicit' %}
                                            <div class="form-check mb-1">
                                                <input class="form-check-input" type="checkbox" value="" id="checkout-terms" required>
                                                <label class="form-check-label" for="checkout-terms">
                                                    {# TODO: Make this translatable once support for placeholders is implemented #}
                                                    <span>I agree to the <a href="{{ 'tos'|url }}" target="_blank" rel="noopener">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank" rel="noopener">{{ 'Privacy Policy'|trans }}</a>.</span>
                                                </label>
                                            </div>
                                        {% endif %}
                                        <button id="checkoutButton" class="btn btn-primary btn-large" type="submit"{% if currency_mismatch or (cart.total and not enough_in_balance and not gateway_selected|default(false)) %} disabled{% endif %} {% if not client %} hidden="true" {% endif %}>{{ cart.total > 0 ? (enough_in_balance ? 'Place Order and Pay with Balance'|trans : 'Place Order and Continue to Payment'|trans) : 'Place Free Order'|trans }}</button>
                                        {% if client and cart.total > 0 and not enough_in_balance %}<p class="small text-secondary mt-2">{{ 'Your order will be created with an invoice. Complete payment on the next step.'|trans }}</p>{% endif %}
                                        <p id="loginMessage" {% if client %} hidden="true" {% endif %}>{{ 'Sign in or create an account below to confirm tax and complete your order.'|trans }}</p>
                                    </div>
                                </div>
                            </fieldset>
                            {% if settings.checkout_tos|default('0') == 'implicit' %}
                                {# TODO: Make this translatable once support for placeholders is implemented #}
                                <span class="text-secondary">By completing your order, you agree to our <a href="{{ 'tos'|url }}" target="_blank" rel="noopener">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank" rel="noopener">{{ 'Privacy Policy'|trans }}</a>.</span>
                            {% endif %}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% elseif request.checkout|default(false) %}
        <div class="p-4"><p>{{ 'Your cart is empty.'|trans }}</p><a href="{{ 'order'|url }}" class="btn btn-primary">{{ 'Browse Products'|trans }}</a></div>
    {% endif %}
</div>
