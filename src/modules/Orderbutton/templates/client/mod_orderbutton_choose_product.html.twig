{% set categories = guest.product_category_get_list({'per_page': 50, 'page': request.category_page|default(1)}) %}
{% set cart_currency = guest.cart_get_currency %}
<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button{{ order_stage != 'browse' ? ' collapsed' : '' }}" type="button" data-bs-toggle="collapse" data-bs-target="#products" aria-expanded="{{ order_stage == 'browse' ? 'true' : 'false' }}" aria-controls="products">
            {{ 'Choose a Product'|trans }}
        </button>
    </h2>
    <div id="products" class="accordion-collapse collapse{{ order_stage == 'browse' ? ' show' : '' }}" data-bs-parent="#orderManager">
        <div class="accordion-body" data-product-catalogue>
            {% if categories.list %}
                <div class="row g-3 mb-4" data-catalogue-controls hidden>
                    <div class="col-md-8">
                        <label for="product-search" class="form-label">{{ categories.pages > 1 ? 'Search Products on This Page'|trans : 'Search Products'|trans }}</label>
                        <input type="search" id="product-search" class="form-control" placeholder="{{ 'Product name or description'|trans }}">
                    </div>
                    <div class="col-md-4">
                        <label for="product-category" class="form-label">{{ 'Category'|trans }}</label>
                        <select id="product-category" class="form-select">
                            <option value="">{{ 'All Categories'|trans }}</option>
                            {% for category in categories.list %}
                                {% if category.products %}<option value="{{ category.id }}">{{ category.title }}</option>{% endif %}
                            {% endfor %}
                        </select>
                    </div>
                </div>
            {% endif %}
            <p class="small text-secondary">{{ 'Setup fees are charged once. Any applicable taxes are shown at checkout.'|trans }}</p>
            {% set product_count = 0 %}
            {% for category in categories.list %}
                {% if category.products %}
                    <section class="mb-4" data-product-category="{{ category.id }}" aria-labelledby="category-{{ category.id }}">
                        <h3 class="h3" id="category-{{ category.id }}">{{ category.title }}</h3>
                        {% if category.description %}<div class="text-secondary">{{ category.description|markdown_to_html }}</div>{% endif %}
                        <div class="list-group list-group-flush">
                            {% for product in category.products|sort((a, b) => a.priority <=> b.priority) %}
                                {% set product_count = product_count + 1 %}
                                <div class="list-group-item px-0 py-3" data-product-entry>
                                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                        <div class="client-product-description">
                                            <h4 class="h4 mb-2">{{ product.title }}</h4>
                                            {% if product.description %}<p class="text-secondary small mb-0">{{ product.description|markdown_to_html|striptags|trim|truncate(180) }}</p>{% endif %}
                                        </div>
                                        <div class="client-product-price">
                                            {{ include('partial_orderbutton_price.html.twig') }}
                                            <a class="btn btn-sm btn-primary mt-2" href="{{ ('order/' ~ product.id)|url(query: {'show_custom_form_values': request.show_custom_form_values}) }}" aria-label="{{ 'Choose %product%'|trans({'%product%': product.title}) }}">{{ 'Choose Product'|trans }} <svg class="icon ms-1" aria-hidden="true"><use href="#arrow-right" /></svg></a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}
            {% endfor %}
            {% if not product_count %}{{ include('partial_client_empty.html.twig', {'empty_title': 'No Products Are Currently Available'|trans}, with_context: false) }}{% endif %}
            <div class="empty" data-catalogue-empty hidden role="status">
                <p class="empty-title">{{ 'No products match your search.'|trans }}</p>
                <div class="empty-action"><button type="button" class="btn btn-outline-secondary" data-catalogue-reset>{{ 'Clear Filters'|trans }}</button></div>
            </div>
            {{ include('partial_pagination.html.twig', {'list': categories, 'url': 'order', 'page_param': 'category_page'}) }}
        </div>
    </div>
</div>
