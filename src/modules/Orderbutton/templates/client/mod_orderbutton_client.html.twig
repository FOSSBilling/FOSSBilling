{% import "macro_functions.html.twig" as mf %}

<div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button{% if not request.checkout %} collapsed{% endif %}" type="button"
                data-bs-toggle="collapse" data-bs-target="#register" aria-controls="register" aria-expanded="{{ request.checkout ? 'true' : 'false' }}">
            <svg class="icon me-2"><use href="#user" /></svg>
            <span>{{ 'Your Account'|trans }}</span>
        </button>
    </h2>
    <div id="register" class="accordion-collapse collapse{% if request.checkout and not client %} show{% endif %}"
>
        <div class="accordion-body">
            <p class="text-secondary">{{ 'Sign in or create an account to continue. Your cart will be kept.'|trans }}</p>
            <div class="nav nav-tabs mb-3" role="tablist" aria-label="{{ 'Your Account'|trans }}">
                <button class="nav-link active" id="in-tab" data-bs-toggle="tab" data-bs-target="#sign-in" type="button" role="tab" aria-controls="sign-in" aria-selected="true">{{ 'Sign In'|trans }}</button>
                <button class="nav-link" id="up-tab" data-bs-toggle="tab" data-bs-target="#sign-up" type="button" role="tab" aria-controls="sign-up" aria-selected="false">{{ 'Create an Account'|trans }}</button>
            </div>
            <div>
                <div class="tab-content" id="nav-tabContent">
                    <div class="tab-pane show active" id="sign-in" role="tabpanel" aria-labelledby="in-tab" tabindex="0">
                        <form data-unsaved-changes method="post" action="{{ 'client/login'|api_url(role: 'guest') }}" {{ fb_api_form({callback: 'onLogin'}) }}>
                            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
                            <div class="row">
                                <div class="col-md-7 mb-3">
                                    <label for="email" class="form-label">{{ 'Email Address'|trans }}</label>
                                    <input class="form-control" type="email" autocapitalize="none" spellcheck="false" enterkeyhint="next" name="email" id="email" autocomplete="section-signin username"
                                           required="required"
                                           value="{{ request.email }}"
                                           placeholder="{{ 'Email address'|trans }}"
                                           data-validation-required-message="{{ 'You must fill in your email.'|trans }}">
                                </div>
                                <div class="col-md-7 mb-3">
                                    <label for="password" class="form-label">{{ 'Password'|trans }}</label>
                                    <input class="form-control" type="password" name="password" id="password" autocomplete="section-signin current-password" enterkeyhint="go"
                                           required="required"
                                           placeholder="{{ 'Password'|trans }}"
                                           data-validation-required-message="{{ 'You must fill in your password.'|trans }}">
                                </div>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <button class="btn btn-primary" type="submit">
                                    {{ 'Sign In and Review Order'|trans }}
                                </button>

                            </div>
                            <p class="mt-3 mb-0"><a href="{{ 'password-reset'|url }}" target="_blank" rel="noopener">{{ 'Forgot your password?'|trans }}</a></p>
                        </form>
                    </div>
                    <div class="tab-pane" id="sign-up" role="tabpanel" aria-labelledby="up-tab" tabindex="0">
                        <p class="small text-secondary">{{ 'Fields marked * are required.'|trans }}</p>
                        <form data-unsaved-changes method="post" action="{{ 'client/create'|api_url(role: 'guest') }}" {{ fb_api_form({callback: 'onAccountCreate'}) }} data-auth-passwords data-password-mismatch="{{ 'Passwords do not match.'|trans }}">
                            <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">

                            {% set r = guest.client_required %}
                            <div class="row">
                                <div class="col-md-7 mb-3">
                                    <label for="reg-email" class="form-label">{{ 'Email Address'|trans }}</label>
                                    <input class="form-control" type="email" autocapitalize="none" spellcheck="false" enterkeyhint="next" name="email" id="reg-email" autocomplete="section-signup username"
                                           required="required"
                                           value="{{ request.email }}"
                                           placeholder="{{ 'Email address'|trans }}">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-7">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="first-name" class="form-label">{{ 'First Name'|trans }}</label>
                                            <input class="form-control" type="text" name="first_name" id="first-name" autocomplete="section-signup given-name"
                                                   required="required"
                                                   value="{{ request.first_name }}"
                                                   placeholder="{{ 'First Name'|trans }}">
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label for="last_name" class="form-label">{{ 'Last Name'|trans }}</label>
                                            <input class="form-control" type="text" name="last_name" id="last_name" autocomplete="section-signup family-name"
                                                   value="{{ request.last_name }}"
                                                   placeholder="{{ 'Last Name'|trans }}"{% if 'last_name' in r %} required="required"{% endif %}>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {% if 'company' in r %}
                                <div class="row">
                                    <div class="col-md-7 mb-3">
                                        <label for="company" class="form-label">{{ 'Company'|trans }}</label>
                                        <input class="form-control" type="text" name="company" id="company" autocomplete="section-signup organization"
                                               required="required"
                                               value="{{ request.company }}"
                                               placeholder="{{ 'Company'|trans }}">
                                    </div>
                                </div>
                            {% endif %}

                            {% if 'birthday' in r %}
                                <div class="row">
                                    <div class="col-md-7 mb-3">
                                        <label for="birthday" class="form-label">{{ 'Birthday'|trans }}</label>
                                        <input class="form-control" type="date" name="birthday" required id="birthday" autocomplete="section-signup bday"
                                               placeholder="{{ 'Birthday'|trans }}">
                                    </div>
                                </div>
                            {% endif %}

                            {% if 'gender' in r %}
                                <div class="row">
                                    <div class="col-md-7 mb-3">
                                        <label for="gender" class="form-label">{{ 'You are'|trans }}</label>
                                        <select class="form-select" name="gender" required id="gender">
                                            <option value="">{{ 'Select an Option'|trans }}</option>
                                            <option value="male"{% if request.gender|default('') == 'male' %} selected{% endif %}>{{ 'Male'|trans }}</option>
                                            <option value="female"{% if request.gender|default('') == 'female' %} selected{% endif %}>{{ 'Female'|trans }}</option>
                                            <option value="nonbinary"{% if request.gender|default('') == 'nonbinary' %} selected{% endif %}>{{ 'Non-binary'|trans }}</option>
                                            <option value="other"{% if request.gender|default('') == 'other' %} selected{% endif %}>{{ 'Other'|trans }}</option>
                                        </select>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="row">
                                <div class="col-md-7 mb-3">
                                    <label for="reg-password" class="form-label">{{ 'Password'|trans }}</label>
                                    <input class="form-control" type="password" name="password" id="reg-password" autocomplete="section-signup new-password" minlength="8" data-auth-password data-auth-new-password aria-describedby="checkout-password-help"
                                           required="required"
                                           placeholder="{{ 'Password'|trans }}">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-7 mb-3">
                                    <label for="password-confirm" class="form-label">{{ 'Confirm Password'|trans }}</label>
                                    <input class="form-control" type="password" name="password_confirm" id="password-confirm" autocomplete="section-signup new-password" minlength="8" data-auth-password data-auth-confirm-password
                                           required="required"
                                           placeholder="{{ 'Confirm password'|trans }}">
                                </div>
                            </div>

                            <p class="small text-secondary" id="checkout-password-help">{{ 'Use at least 8 characters, including uppercase and lowercase letters and a number.'|trans }}</p>
                            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="checkout-show-passwords" data-auth-show-passwords><label class="form-check-label" for="checkout-show-passwords">{{ 'Show Passwords'|trans }}</label></div>
                            {% if 'address_1' in r %}
                            <div class="row">
                                <div class="col-md-7 mb-3">
                                    <label for="address_1" class="form-label">{{ 'Address'|trans }}</label>
                                    <input class="form-control" type="text" name="address_1" required id="address_1" autocomplete="section-signup address-line1"
                                           value="{{ request.address_1 }}"
                                           placeholder="{{ 'Address'|trans }}">
                                </div>
                            </div>
                            {% endif %}

                            {% if 'address_2' in r %}
                            <div class="row">
                                <div class="col-md-7 mb-3">
                                    <label for="address_2" class="form-label">{{ 'Address 2'|trans }}</label>
                                    <input class="form-control" type="text" name="address_2" required id="address_2" autocomplete="section-signup address-line2"
                                          value="{{ request.address_2 }}"
                                           placeholder="{{ 'Address 2'|trans }}">
                                </div>
                            </div>
                            {% endif %}

                            {% if 'city' in r %}
                                <div class="row">
                                    <div class="col-md-7 mb-3">
                                        <label for="city" class="form-label">{{ 'City'|trans }}</label>
                                        <input class="form-control" type="text" name="city" required id="city" autocomplete="section-signup address-level2"
                                               value="{{ request.city }}"
                                               placeholder="{{ 'City'|trans }}">
                                    </div>
                                </div>
                            {% endif %}

                            {% if 'country' in r %}
                                <div class="row">
                                    <div class="col-md-7 mb-3">
                                        <label for="country" class="form-label">{{ 'Country'|trans }}</label>
                                        <select class="form-select" name="country" id="country" autocomplete="section-signup country"
                                                required="required">
                                            <option value="">{{ '-- Select Country --'|trans }}</option>
                                            {% for val,label in guest.system_countries %}
                                                <option value="{{ val }}" label="{{ label|e }}" {% if request.country|default('') == val %}selected{% endif %}>{{ label|e }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            {% endif %}

                            {% if 'state' in r %}
                                <div class="row">
                                    <div class="col-md-7 mb-3">
                                        <label for="state" class="form-label">{{ 'State'|trans }}</label>
                                        <input class="form-control" type="text" name="state" required id="state" autocomplete="section-signup address-level1"
                                               value="{{ request.state }}"
                                               placeholder="{{ 'State'|trans }}">
                                    </div>
                                </div>
                            {% endif %}

                            {% if 'postcode' in r %}
                                <div class="row">
                                    <div class="col-md-7 mb-3">
                                        <label for="postcode" class="form-label">{{ 'Zip/Postal Code'|trans }}</label>
                                        <input class="form-control" type="text" name="postcode" required id="postcode" autocomplete="section-signup postal-code"
                                               value="{{ request.postcode }}"
                                               placeholder="{{ 'Zip/Postal Code'|trans }}">
                                    </div>
                                </div>
                            {% endif %}

                            {% if 'phone' in r %}
                                <div class="row">
                                    <div class="col-md-7 mb-3">
                                        <label for="phone" class="form-label">{{ 'Phone Number'|trans }}</label>
                                        <input type="hidden" name="phone_cc" id="phone_cc" value="{{ request.phone_cc }}">
                                        <input class="form-control js-phone-input" type="tel" name="phone" id="phone" value="{{ request.phone }}" autocomplete="section-signup tel" data-initial-country="{{ request.country|default(guest.system_default_country)|lower }}" required="required" placeholder="{{ 'Phone Number'|trans }}">
                                    </div>
                                </div>
                            {% endif %}

                            {% set custom_fields = guest.client_custom_fields %}
                            {% for field_name, field in custom_fields %}
                                {% if field.active|default(false) %}
                                    <div class="row">
                                        <div class="col-md-7 mb-3">
                                            <label class="form-label" for="{{ field_name }}">{% if field.title|default('') is not empty %}{{ field.title }}{% else %} {{ field_name|capitalize }} {% endif %}</label>
                                            <input class="form-control" type="text" name="{{ field_name }}" id="{{ field_name }}"
                                                   value="{{ request.(field_name)|default('') }}"
                                                   {% if field.required|default(false) %}required="required"{% endif %}
                                                   placeholder="{{ field_name|capitalize }}">
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                            {% set honeypot = antispam_honeypot() %}
                            {% if honeypot.enabled %}
                                <div style="position:absolute;left:-9999px" aria-hidden="true">
                                    <label for="checkout-{{ honeypot.field }}">{{ honeypot.field }}</label>
                                    <input id="checkout-{{ honeypot.field }}" type="text" name="{{ honeypot.field }}" value="" tabindex="-1" autocomplete="off">
                                </div>
                            {% endif %}
                            {{ mf.recaptcha }}
                            {% if settings.signup_tos|default('0') == 'explicit' %}
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" value="" id="signup-terms" required>
                                    <label class="form-check-label" for="signup-terms">
                                        {# TODO: Make this translatable once support for placeholders is implemented #}
                                        <span>I agree to the <a href="{{ 'tos'|url }}" target="_blank" rel="noopener">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank" rel="noopener">{{ 'Privacy Policy'|trans }}</a>.</span>
                                    </label>
                                </div>
                            {% endif %}
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <button class="btn btn-primary" type="submit">{{ 'Create Account and Review Order'|trans }}</button>

                            </div>
                            {% if settings.signup_tos|default('0') == 'implicit' %}
                                <div class="mb-1">
                                    {# TODO: Make this translatable once support for placeholders is implemented #}
                                    <span class="text-secondary mb-1">By creating an account, you agree to our <a href="{{ 'tos'|url }}" target="_blank" rel="noopener">{{ 'Terms of Service'|trans }}</a> and <a href="{{ 'privacy-policy'|url }}" target="_blank" rel="noopener">{{ 'Privacy Policy'|trans }}</a>.</span>
                                </div>
                            {% endif %}
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
