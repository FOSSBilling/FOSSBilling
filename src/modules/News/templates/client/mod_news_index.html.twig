{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'news' %}

{% block meta_title %}{{ 'News'|trans }}{% endblock %}
{% block body_class %}news-index{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ 'News'|trans }}</li>{% endblock %}

{% block content %}
    {% set search = request.search|default('')|trim %}
    {% set posts = guest.news_get_list({'page': request.page|default(1), 'per_page': 5, 'search': search, 'sort': 'created_at', 'direction': 'DESC'}) %}
    {{ include('partial_page_heading.html.twig', {title: 'News & Announcements'|trans, heading_class: 'mb-4'}) }}
    <section class="card mb-4" aria-label="{{ 'Announcements'|trans }}">
        <div class="card-body">
            {% include 'partial_client_search.html.twig' with {
                search_action: 'news'|url, search_clear_url: 'news'|url,
                search_id: 'news-search', search_label: 'Search Announcements'|trans,
                search_value: search, search_placeholder: 'Title, topic or keywords'|trans,
                search_form_class: 'mb-4'
            } only %}
            {% for post in posts.list %}
                {% set post_url = "news/#{post.slug}"|url(query: {'search': search, 'page': request.page|default(1)}) %}
                {% set published = post.published_at ?: post.created_at %}
                <article class="client-news-summary{{ not loop.first ? ' border-top pt-4 mt-4' : '' }}">
                    <div class="small text-secondary mb-2">
                        {% if post.section %}<span class="fw-semibold me-2">{{ post.section }}</span>{% endif %}
                        {% if published %}<time datetime="{{ published|date('c') }}">{{ published|format_date }}</time>{% endif %}
                    </div>
                    <h2 class="card-title mb-2"><a href="{{ post_url }}">{{ post.title }}</a></h2>
                    {% set summary = post.excerpt ?: (post.description ?: post.content) %}
                    {% if summary %}<p class="text-secondary mb-2">{{ (summary ?? '')|markdown_to_html|striptags|trim|truncate(240) }}</p>{% endif %}
                    <a class="client-content-link" href="{{ post_url }}" aria-label="{{ 'Read Announcement: %title%'|trans({'%title%': post.title}) }}">{{ 'Read Announcement'|trans }}</a>
                </article>
            {% else %}
                {% if posts.total|default(0) > 0 %}
                    {{ include('partial_client_empty.html.twig', {
                        'empty_title': 'No Announcements on This Page'|trans,
                        'empty_action_label': 'Back to First Page'|trans,
                        'empty_action_url': 'news'|url(query: {'search': search})
                    }, with_context: false) }}
                {% elseif search %}
                    {{ include('partial_client_empty.html.twig', {
                        'empty_title': 'No Matching Announcements'|trans,
                        'empty_description': 'Try different keywords or clear your search to see all announcements.'|trans
                    }, with_context: false) }}
                {% else %}
                    {{ include('partial_client_empty.html.twig', {
                        'empty_title': 'No Announcements Yet'|trans,
                        'empty_description': 'Service updates and news will appear here.'|trans
                    }, with_context: false) }}
                {% endif %}
            {% endfor %}
            {% if posts.list %}<div class="mt-4">{{ include('partial_pagination.html.twig', {'list': posts, 'url': 'news'}) }}</div>{% endif %}
        </div>
    </section>
{% endblock %}
