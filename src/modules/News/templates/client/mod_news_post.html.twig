{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'news' %}
{% set history_url = 'news'|url(query: {'search': request.search|default(''), 'page': request.page|default(1)}) %}

{% block meta_title %}{{ post.title }}{% endblock %}
{% block meta_description %}{{ post.description }}{% endblock %}

{% block body_class %}news-post{% endblock %}
{% block head %}{{ 'css/markdown.css'|public_asset_url|stylesheet_tag }}{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ history_url }}">{{ 'News'|trans }}</a></li>
<li class="breadcrumb-item active" aria-current="page">{{post.title}}</li>
{% endblock %}

{% block opengraph %}
    <meta property="og:title" content="{{ post.title }}" />
    <meta property="og:type" content="article" />
    <meta property="og:description" content="{{ post.description }}" />
    <meta property="og:url" content="{{ guest.system_current_url|url }}" />
    <meta property="og:image" content="{{ post.image }}" />
    <meta property="article:author" content="{{ post.author.name }}" />

    {% if post.published_at %}<meta property="article:published_time" content="{{ post.published_at }}" />{% endif %}
    {% if post.updated_at %}<meta property="article:modified_time" content="{{ post.updated_at }}" />{% endif %}
    {% if post.expires_at %}<meta property="article:expiration_time" content="{{ post.expires_at }}" />{% endif %}
    {% if post.section %}<meta property="article:section" content="{{ post.section }}" />{% endif %}
    {% if post.tags|default([])|length > 0 %}<meta property="article:tag" content="{{ post.tags|join(', ') }}" />{% endif %}
{% endblock %}

{% block content %}
    {% set published = post.published_at ?: post.created_at %}
    <div class="client-news-reader mx-auto">
        <a class="d-inline-flex align-items-center client-content-link mb-3" href="{{ history_url }}">{{ 'Back to Announcements'|trans }}</a>
        <article class="card mb-4">
            <div class="card-body p-3 p-md-4">
                <header class="mb-4">
                    {% if post.section %}<p class="small text-secondary fw-semibold mb-2">{{ post.section }}</p>{% endif %}
                    <h1 class="h2 mb-3">{{ post.title }}</h1>
                    <div class="small text-secondary">
                        {% if published %}<span class="d-block">{{ 'Published'|trans }} <time datetime="{{ published|date('c') }}">{{ published|format_date }}</time></span>{% endif %}
                        {% if post.updated_at and published and post.updated_at|date('Y-m-d') > published|date('Y-m-d') %}
                            <span class="d-block">{{ 'Updated'|trans }} <time datetime="{{ post.updated_at|date('c') }}">{{ post.updated_at|format_date }}</time></span>
                        {% endif %}
                        {% if post.author.name|default('') %}<span class="d-block">{{ 'By'|trans }} {{ post.author.name }}</span>{% endif %}
                    </div>
                </header>
                {% if post.image %}<img class="img-fluid rounded mb-4" src="{{ post.image }}" alt="{{ post.title }}">{% endif %}
                <div class="client-news-content markdown-body bg-transparent text-reset">
                    {{ (post.content ?? '')|markdown_to_html }}
                </div>
            </div>
        </article>
        <a class="d-inline-flex align-items-center client-content-link mb-4" href="{{ history_url }}">{{ 'Back to Announcements'|trans }}</a>
    </div>
{% endblock %}
