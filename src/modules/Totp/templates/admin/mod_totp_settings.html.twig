{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% block meta_title %}{{ 'Two-Factor Authentication Settings'|trans }}{% endblock %}
{% set active_menu = 'system' %}

{% block content %}
    {% set params = admin.extension_config_get({ ext: 'mod_totp' }) %}
    {% set company = guest.system_company %}
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title mb-1">{{ 'Two-Factor Authentication'|trans }}</h3>
                <p class="card-subtitle mb-0">{{ 'Control who can use TOTP and choose the issuer name shown in authenticator apps.'|trans }}</p>
            </div>
        </div>
        <form method="post" action="{{ 'extension/config_save'|api_url(role: 'admin') }}" {{ fb_api_form({message: 'Configuration Updated'|trans}) }}>
            <input type="hidden" name="ext" value="mod_totp">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <input type="hidden" name="allow_admin" value="0">
                        <label class="form-check form-switch form-switch-2">
                            <input class="form-check-input" name="allow_admin" value="1" type="checkbox" {% if params.allow_admin|default(true) %}checked{% endif %}>
                            <span class="form-check-label">{{ 'Allow staff accounts to configure TOTP'|trans }}</span>
                        </label>
                    </div>
                    <div class="col-12">
                        <input type="hidden" name="allow_client" value="0">
                        <label class="form-check form-switch form-switch-2">
                            <input class="form-check-input" name="allow_client" value="1" type="checkbox" {% if params.allow_client|default(true) %}checked{% endif %}>
                            <span class="form-check-label">{{ 'Allow client accounts to configure TOTP'|trans }}</span>
                        </label>
                    </div>
                    <div class="col-12">
                        <input type="hidden" name="security_notice" value="0">
                        <label class="form-check form-switch form-switch-2">
                            <input class="form-check-input" name="security_notice" value="1" type="checkbox" {% if params.security_notice|default(true) %}checked{% endif %}>
                            <span class="form-check-label">{{ 'Show dashboard security notices for accounts without TOTP'|trans }}</span>
                        </label>
                    </div>
                    <div class="col-lg-8">
                        <input type="hidden" name="custom_issuer_enabled" value="0">
                        <label class="form-check form-switch form-switch-2 mb-3">
                            <input class="form-check-input" id="custom-issuer-enabled" name="custom_issuer_enabled" value="1" type="checkbox" {% if params.custom_issuer_enabled|default(false) %}checked{% endif %}>
                            <span class="form-check-label">{{ 'Use a custom issuer name'|trans }}</span>
                        </label>
                        <label class="form-label" for="totp-issuer">{{ 'Issuer name'|trans }}</label>
                        <input class="form-control" id="totp-issuer" name="issuer" type="text" value="{{ params.custom_issuer_enabled|default(false) ? params.issuer|default(company.name|default('FOSSBilling')) : company.name|default('FOSSBilling') }}" maxlength="64" {% if not params.custom_issuer_enabled|default(false) %}disabled{% endif %}>
                        <div class="form-hint">{{ 'When disabled, the company name from System Settings is used.'|trans }}</div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-primary" type="submit">{{ 'Save Settings'|trans }}</button>
            </div>
        </form>
    </div>
{% endblock %}

{% block js %}
<script>
    (() => {
        const toggle = document.getElementById('custom-issuer-enabled');
        const issuer = document.getElementById('totp-issuer');
        const updateIssuerState = () => { issuer.disabled = !toggle.checked; };
        toggle.addEventListener('change', updateIssuerState);
    })();
</script>
{% endblock %}
