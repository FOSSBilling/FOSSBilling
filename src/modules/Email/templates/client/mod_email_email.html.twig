{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'emails' %}
{% set subject = email.subject|default('No Subject'|trans, true) %}
{% set history_url = 'email'|url(query: {'search': request.search|default(''), 'page': request.page|default(1)}) %}

{% block meta_title %}{{ subject }}{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ history_url }}">{{ 'Emails'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ subject }}</li>
{% endblock %}
{% block body_class %}email-email{% endblock %}

{% block content %}
    <a class="d-inline-flex align-items-center client-content-link mb-3" href="{{ history_url }}">{{ 'Back to Emails'|trans }}</a>
    <h1 class="h2 client-email-heading mb-4">{{ subject }}</h1>
    <article class="card mb-4" aria-label="{{ 'Email Message'|trans }}">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
                <dl class="client-email-metadata mb-0">
                    <dt>{{ 'From'|trans }}</dt><dd>{{ email.sender }}</dd>
                    <dt>{{ 'To'|trans }}</dt><dd>{{ email.recipients }}</dd>
                    <dt>{{ 'Sent'|trans }}</dt><dd>{{ email.created_at|format_datetime }}</dd>
                </dl>
                <div class="d-flex gap-2 align-items-start flex-wrap client-email-actions client-action-group">
                    <a class="btn btn-outline-secondary" href="{{ 'email/resend'|api_url(query: {id: email.id}) }}"
                       {{ fb_api_link({message: 'Email resent'|trans, modal: {type: 'confirm', title: 'Resend this email?'|trans}}) }}>{{ 'Resend Email'|trans }}</a>
                    <a class="btn btn-outline-danger client-action-destructive" href="{{ 'email/delete'|api_url(query: {id: email.id}) }}"
                       {{ fb_api_link({modal: {type: 'confirm', title: 'Delete Email'|trans, content: 'Delete "%subject%" from your email history? This cannot be undone. The delivered copy in your inbox will not be deleted.'|trans({'%subject%': email.subject|default('No Subject'|trans)}), button: 'Delete Email'|trans, buttonColor: 'danger', cancelButton: 'Keep Email'|trans}, loading: {button: 'Deleting Email…'|trans}, redirect: history_url}) }}>{{ 'Delete Email'|trans }}</a>
                </div>
            </div>
            {% set message_content = email.content_html %}
            {% if not message_content %}
                {% set message_content %}<!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light dark"></head><body style="margin: 16px; color: CanvasText; font: 16px/1.6 system-ui, sans-serif;"><pre style="white-space: pre-wrap; overflow-wrap: anywhere; font: inherit;">{{ email.content_text|default('') }}</pre></body></html>{% endset %}
            {% endif %}
            <iframe class="client-email-content" title="{{ 'Message: %subject%'|trans({'%subject%': subject}) }}" sandbox="allow-popups" referrerpolicy="no-referrer" srcdoc="{{ message_content|e('html_attr') }}"></iframe>
        </div>
    </article>
{% endblock %}
