{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'emails' %}

{% block meta_title %}{{ 'Emails'|trans }}{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ 'Emails'|trans }}</li>{% endblock %}
{% block body_class %}email-index{% endblock %}

{% block content %}
    {% set search = request.search|default('')|trim %}
    {% set emails = client.email_get_list({'per_page': 10, 'page': request.page|default(1), 'search': search, 'sort': 'created_at', 'direction': 'DESC'}) %}
    <h1 class="mb-4">{{ 'Emails'|trans }}</h1>
    <section class="card mb-4" aria-label="{{ 'Email History'|trans }}">
        <div class="card-body">
            {% include 'partial_client_search.html.twig' with {
                search_action: 'email'|url, search_clear_url: 'email'|url,
                search_id: 'email-search', search_label: 'Search Emails'|trans,
                search_value: search, search_placeholder: 'Subject, sender or message text'|trans,
                search_form_class: 'mb-4'
            } only %}
            {% if emails.list %}
                <p class="small text-secondary">{{ search ? 'Search results, newest first'|trans : 'Newest messages first'|trans }}</p>
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover client-email-list mb-0" aria-label="{{ 'Email History'|trans }}">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'Subject'|trans }}</th>
                                <th scope="col">{{ 'Sent'|trans }}</th>
                                <th scope="col"><span class="visually-hidden">{{ 'Actions'|trans }}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for email in emails.list %}
                                {% set subject = email.subject|default('No Subject'|trans, true) %}
                                {% set email_url = "email/#{email.id}"|url(query: {'search': search, 'page': request.page|default(1)}) %}
                                <tr>
                                    <td class="email-subject">
                                        <a class="fw-semibold" href="{{ email_url }}">{{ subject }}</a>
                                        <div class="small text-secondary">{{ email.sender }}</div>
                                    </td>
                                    <td class="email-date text-secondary"><span class="d-block d-md-none small" aria-hidden="true">{{ 'Sent'|trans }}</span>{{ email.created_at|format_datetime }}</td>
                                    <td class="email-action text-end">
                                        <a class="btn btn-sm btn-outline-secondary" href="{{ email_url }}" aria-label="{{ 'Read Email: %subject%'|trans({'%subject%': subject}) }}">{{ 'Read'|trans }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">{{ include('partial_pagination.html.twig', {'list': emails, 'url': 'email'}) }}</div>
            {% elseif emails.total|default(0) > 0 %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'No Messages on This Page'|trans,
                    'empty_action_label': 'Back to First Page'|trans,
                    'empty_action_url': 'email'|url(query: {'search': search})
                }, with_context: false) }}
            {% elseif search %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'No Matching Emails'|trans,
                    'empty_description': 'Try different keywords or clear your search to see all messages.'|trans
                }, with_context: false) }}
            {% else %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'No Emails Yet'|trans,
                    'empty_description': 'Messages sent to you will appear here.'|trans
                }, with_context: false) }}
            {% endif %}
        </div>
    </section>
{% endblock %}
