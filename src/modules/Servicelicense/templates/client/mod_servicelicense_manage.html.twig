{% if order.status == 'active' %}
<div class="card mb-4">
    <div class="card-header">
        <h2 class="h3 mb-0">{{ 'License Details'|trans }}</h2>
    </div>
    <div class="card-body">

        <div class="table-responsive"><table class="table table-vcenter table-striped table-sm client-service-properties">
            <tbody>
            <tr>
                <td>{{ 'Key'|trans }}</td>
                <td>
                    <strong>{{ service.license_key }}</strong>
                </td>
            </tr>

            {% if service.validate_ip %}
            <tr>
                <td>
                    {{ 'Valid IPs'|trans }}
                </td>
                <td>
                    {% for ip in service.ips %}
                    {{ ip }} <br/>
                    {% else %}
                    {{ 'All IPs'|trans }}
                    {% endfor %}
                </td>
            </tr>
            {% endif %}

            {% if service.validate_host %}
            <tr>
                <td>
                    {{ 'Valid Domains'|trans }}
                </td>
                <td>
                    {% for host in service.hosts %}
                    {{ host }} <br/>
                    {% else %}
                    {{ 'All Hosts'|trans }}
                    {% endfor %}
                </td>
            </tr>
            {% endif %}

            {% if service.validate_version %}
            <tr>
                <td>
                    {{ 'Valid Versions'|trans }}
                </td>
                <td>
                    {% for version in service.versions %}
                    {{ version }} <br/>
                    {% else %}
                    {{ 'All Versions'|trans }}
                    {% endfor %}
                </td>
            </tr>
            {% endif %}

            {% if service.validate_path %}
            <tr>
                <td>
                    {{ 'Valid Installation Paths'|trans }}
                </td>
                <td>
                    {% for path in service.paths %}
                    {{ path }} <br/>
                    {% else %}
                    {{ 'All Paths'|trans }}
                    {% endfor %}
                </td>
            </tr>
            {% endif %}

            </tbody>
        </table></div>

        <h3 class="h4">{{ 'Reset License'|trans }}</h3>
        <p>{{ 'Resetting the license will clear saved validation data (IP addresses, domains, versions, and installation paths). Use this if you moved servers; the license must then be activated again from the new environment.'|trans }}</p>
        <div class="block">
            <p>
                <a class="btn btn-outline-danger" {{ fb_api_link({href: 'servicelicense/reset'|api_url(query: {order_id: order.id}), modal: {type: 'confirm', title: 'Reset License'|trans, content: 'This clears saved validation data for "%service%". You will need to activate the license again from your new environment.'|trans({'%service%': order.title}), button: 'Reset License'|trans, buttonColor: 'danger', cancelButton: 'Keep License Settings'|trans}, loading: {button: 'Resetting License…'|trans}, message: 'License was reset'|trans}) }}>{{ 'Reset License'|trans }}</a>
            </p>
        </div>
    </div>
</div>
{% endif %}
