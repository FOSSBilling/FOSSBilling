{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'services' %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ order.title }}{% endblock %}

{% set addons = client.order_addons({ "id": order.id }) %}

{% block body_class %}order-manage{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ 'order/service'|url}}">{{ 'Services'|trans }}</a></li>
<li class="breadcrumb-item active" aria-current="page">{{ order.title }}</li>
{% endblock %}

{% set service_partial = "mod_service" ~ order.service_type ~ "_manage.html.twig" %}
{% set upgradables = client.order_upgradables({ 'id': order.id }) %}

{% block head %}
    {{ wysiwyg('.editor-textarea') }}
{% endblock %}

{% block content %}
    {{ render_widgets('client.order.manage.content.start', { 'order': order }) }}

    <div class="row">
        <div class="col-md-12">
            {% embed 'partial_card_heading.html.twig' with {heading_class: 'mb-4', heading_actions_class: 'client-action-group', heading_content_class: ''} %}
                {% block card_heading_content %}
                    {% import 'macro_functions.html.twig' as mf %}
                    <h1 class="mb-2">{{ order.title }}</h1>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        {{ mf.status_badge(order.status, 'order') }}
                        {% if order.unpaid_invoice_hash|default(null) or order.renewal_due|default(false) or order.meta.cancel_at_period_end|default(false) %}
                            {{ include('partial_order_attention.html.twig') }}
                        {% endif %}
                    </div>
                {% endblock %}
                {% block card_heading_actions %}
                    <a href="{{ 'order/service'|url }}" class="btn btn-outline-secondary">{{ 'Back to Services'|trans }}</a>
                {% endblock %}
            {% endembed %}

            <section class="card mb-4" aria-labelledby="service-billing-heading">
                <div class="card-body">
                    <h2 class="h3 mb-3" id="service-billing-heading">{{ 'Billing and Renewal'|trans }}</h2>
                    <dl class="row gy-3 mb-3">
                        <div class="col-6 col-sm-4">
                            <dt class="small text-secondary fw-normal">{{ 'Service Price'|trans }}</dt>
                            <dd class="fw-semibold mb-0">{{ max(0, order.total - order.discount|default(0))|format_currency(order.currency ?? default_currency) }}</dd>
                            {% if order.quantity|default(1) > 1 %}<dd class="small mb-0">{{ 'Quantity'|trans }}: {{ order.quantity }}</dd>{% endif %}
                            {% if order.discount|default(0) > 0 %}<dd class="small mb-0">{{ 'Discount Included'|trans }}: {{ order.discount|format_currency(order.currency ?? default_currency) }}</dd>{% endif %}
                        </div>
                        <div class="col-6 col-sm-4">
                            <dt class="small text-secondary fw-normal">{{ 'Billing Cycle'|trans }}</dt>
                            <dd class="fw-semibold mb-0">{{ order.period ? order.period|period_title : 'One-Time Payment'|trans }}</dd>
                        </div>
                        <div class="col-12 col-sm-4">
                            <dt class="small text-secondary fw-normal">{{ order.meta.cancel_at_period_end|default(false) ? 'Scheduled End Date'|trans : (order.period and order.status != 'canceled' ? 'Next Renewal Date'|trans : 'Expiry Date'|trans) }}</dt>
                            <dd class="fw-semibold mb-0">{{ order.expires_at ? order.expires_at|format_date : 'Not Scheduled'|trans }}</dd>
                        </div>
                    </dl>
                    <p class="small text-secondary">{{ 'Price before tax. Your invoice confirms the final amount due.'|trans }}</p>
                    {% if order.unpaid_invoice_hash|default(null) %}
                        <p>{{ 'There is an unpaid invoice for this service. Review it to see the amount due and payment options.'|trans }}</p>
                        <a class="btn btn-primary" href="{{ ('invoice/' ~ order.unpaid_invoice_hash)|url }}">{{ 'Pay Invoice'|trans }}</a>
                    {% elseif order.status == 'canceled' %}
                        <p class="mb-0">{{ 'This service has been canceled. Contact support if you need help with this service.'|trans }}</p>
                    {% elseif order.status == 'failed_setup' %}
                        <p class="mb-0">{{ 'Setup could not be completed. Open a support ticket so we can help get your service running.'|trans }}</p>
                    {% elseif order.status == 'failed_renew' %}
                        <p class="mb-0">{{ 'Renewal could not be completed. Open a support ticket to review the next steps.'|trans }}</p>
                    {% elseif order.status == 'suspended' %}
                        <p class="mb-0">{{ 'This service is suspended. Contact support for help restoring access.'|trans }}</p>
                    {% elseif order.meta.cancel_at_period_end|default(false) %}
                        <p class="mb-0">{{ 'Cancellation is scheduled for the end of the current period. Contact support if you want to change this request.'|trans }}</p>
                    {% elseif order.status == 'pending_setup' %}
                        <p class="mb-0">{{ 'Your service is awaiting setup. Management options will appear once it is active.'|trans }}</p>
                    {% elseif order.can_renew|default(false) %}
                        <p>{{ 'Renewal creates an invoice. Available account credit may be applied.'|trans }}</p>
                        <a class="btn btn-primary"
                           {{ fb_api_link({href: 'invoice/renewal_invoice'|api_url(query: {order_id: order.id}), modal: {type: 'confirm', title: 'Renew Service'|trans, content: 'Continue to the renewal invoice? Available account credit may be applied.'|trans}, callback: 'onRenewalInvoiceCreated'}) }}>{{ 'Renew Now'|trans }}</a>
                        <script>window.onRenewalInvoiceCreated = (hash) => { window.location = {{ 'invoice'|url|json_encode|raw }} + '/' + encodeURIComponent(hash); };</script>
                    {% elseif not order.period %}
                        <p class="mb-0">{{ 'This is a one-time purchase. There is no recurring renewal.'|trans }}</p>
                    {% else %}
                        <p class="mb-0">{{ 'Online renewal is not currently available. Contact support if you need help with renewal.'|trans }}</p>
                    {% endif %}
                    {% if order.reason|default('') and order.status != 'active' %}<p class="mt-3 mb-0"><strong>{{ 'Reason'|trans }}:</strong> {{ order.reason }}</p>{% endif %}
                </div>
            </section>

            {# Service management #}
            {% set service = null %}
            {{ render_widgets('client.order.manage.service.before', { 'order': order, 'service': service }) }}
            {% if order.status == 'active' and guest.system_template_exists({ 'file': service_partial }) %}
                {% set service = client.order_service({ 'id': order.id }) %}
                {% if service %}
                    {{ include(service_partial, { 'order': order, 'service': service }) }}
                {% else %}
                    <p class="text-secondary mb-4">{{ 'No online management options are available for this service. Contact support if you need help.'|trans }}</p>
                {% endif %}
            {% endif %}
            {{ render_widgets('client.order.manage.service.after', { 'order': order, 'service': service }) }}

            <section class="mb-4" aria-labelledby="service-support-heading">
                <h2 class="h3" id="service-support-heading">{{ 'Support and Changes'|trans }}</h2>
                <div class="d-flex flex-wrap gap-2 client-action-group">
                    <button class="btn {{ order.status in ['suspended', 'failed_setup', 'failed_renew', 'canceled'] and not order.unpaid_invoice_hash|default(null) ? 'btn-primary' : 'btn-outline-secondary' }}" type="button" id="open-ticket" data-bs-toggle="modal" data-bs-target="#open-ticket-modal">{{ 'Get Help with This Service'|trans }}</button>
                    {% if upgradables and order.status != 'canceled' and not order.meta.cancel_at_period_end|default(false) %}
                        <button class="btn btn-outline-secondary" type="button" id="request-upgrade" data-bs-toggle="modal" data-bs-target="#upgrade-request-modal">{{ 'Request Upgrade'|trans }}</button>
                    {% endif %}
                    {% if order.status == 'active' and not order.meta.cancel_at_period_end|default(false) %}
                        <button class="btn btn-outline-danger client-action-destructive" type="button" id="request-cancel" data-bs-toggle="modal" data-bs-target="#cancel-request-modal">{{ 'Request Cancellation'|trans }}</button>
                    {% endif %}
                    {{ render_widgets('client.order.manage.actions.end', { 'order': order }) }}
                </div>
                {% if order.active_tickets|default(0) > 0 %}<p class="mt-3 mb-0">{{ 'Active Support Tickets'|trans }}: {{ order.active_tickets }} · <a href="{{ 'support'|url }}">{{ 'View Support Tickets'|trans }}</a></p>{% endif %}
            </section>

            <section class="mb-4" aria-labelledby="service-record-heading">
                <h2 class="h3" id="service-record-heading">{{ 'Service Record'|trans }}</h2>
                <dl class="row gy-3">
                    <div class="col-12 col-sm-4"><dt class="small text-secondary fw-normal">{{ 'Service ID'|trans }}</dt><dd>#{{ order.id }}</dd></div>
                    <div class="col-12 col-sm-4"><dt class="small text-secondary fw-normal">{{ 'Ordered On'|trans }}</dt><dd>{{ order.created_at|format_date }}</dd></div>
                    <div class="col-12 col-sm-4"><dt class="small text-secondary fw-normal">{{ 'Activated On'|trans }}</dt><dd>{{ order.activated_at ? order.activated_at|format_date : 'Not Recorded'|trans }}</dd></div>
                </dl>
                {% if order.notes %}<h3 class="h4">{{ 'Service Notes'|trans }}</h3><div>{{ order.notes|markdown_to_html }}</div>{% endif %}
                {{ render_widgets('client.order.manage.details.after', { 'order': order }) }}
            </section>

            {# Order addons #}
            {% if order.group_master == 1 and addons|length > 0 %}
            <div class="card mb-4">
                <div class="card-header py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h3 mb-1">{{ 'Addons'|trans }}</h2>
                            <span class="small text-secondary">{{ 'Addons You Have Ordered with This Service'|trans }}</span>
                        </div>
                    </div>
                </div>
                <div class="card-body table-responsive">
                        <table class="table table-vcenter table-hover table-bordered table-sm client-service-addons">
                            <thead>
                            <tr>
                                <th scope="col">{{ 'Product/Service'|trans }}</th>
                                <th scope="col">{{ 'Price'|trans }}</th>
                                <th scope="col">{{ 'Billing Cycle'|trans }}</th>
                                <th scope="col">{{ 'Next Due Date'|trans }}</th>
                                <th scope="col">{{ 'Status'|trans }}</th>
                                <th scope="col">{{ 'Actions'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for i, addon in addons %}
                                <tr>
                                    <td>{{ addon.title }}</td>
                                    <td><span class="d-block d-md-none small text-secondary" aria-hidden="true">{{ 'Price'|trans }}</span>{{ max(0, addon.total - addon.discount|default(0))|format_currency(addon.currency ?? default_currency) }}</td>
                                    <td><span class="d-block d-md-none small text-secondary" aria-hidden="true">{{ 'Billing Cycle'|trans }}</span>{{ addon.period ? addon.period|period_title : 'One-Time Payment'|trans }}</td>
                                    <td><span class="d-block d-md-none small text-secondary" aria-hidden="true">{{ 'Next Due Date'|trans }}</span>{% if addon.expires_at %}{{ addon.expires_at|format_date }}{% else %}-{% endif %}</td>
                                    <td>
                                        {{ mf.status_badge(addon.status, 'order') }}
                                    </td>
                                    <td class="actions">
                                        <a class="btn btn-outline-primary btn-sm" href='{{ "order/service/manage/#{addon.id}"|url }}'>{{ 'Manage'|trans }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            <div class="modal fade" id="cancel-request-modal" tabindex="-1" role="dialog" aria-labelledby="cancel-modal" aria-describedby="cancel-description" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="cancel-modal">{{ 'Submit Cancellation Request'|trans }}</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="{{ 'support/ticket_create'|api_url }}" {{ fb_api_form({callback: 'onServiceTicketCreated'}) }} id="cancel-request-form" class="request-cancellation client-modal-form">
                            <div class="modal-body">
                                <p class="small text-secondary">{{ 'Service'|trans }}: {{ order.title }} (#{{ order.id }})</p>
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <input type="hidden" name="rel_task" value="cancel">
                                <p id="cancel-description">{{ 'This sends a cancellation request to support. It does not cancel your service immediately. Include when you would like the service to end.'|trans }}</p>
                                <div class="mb-3">
                                    <label for="cancel-helpdesk" class="form-label">{{ 'Help Desk'|trans }}</label>
                                    <select class="form-select" name="support_helpdesk_id" id="cancel-helpdesk" required>
                                        {% for id, title in client.support_helpdesk_get_pairs %}
                                            <option value="{{ id }}"{% if request.support_helpdesk_id == id %} selected{% endif %}>{{ title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="cancel-subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" id="cancel-subject" value="{{ request.subject|default('Cancellation Request'|trans ~ ': ' ~ order.title)|e }}" required/>
                                </div>
                                <div class="mb-3">
                                    <label for="cancel-content" class="form-label">{{ 'Reason'|trans }}</label>
                                    <textarea class="form-control" id="cancel-content" name="content" rows="5" required>{{ request.content|e }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'Keep Service'|trans }}</button>
                                <button type="submit" class="btn btn-danger">{{ 'Send Cancellation Request'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="open-ticket-modal" tabindex="-1" role="dialog" aria-labelledby="ticket-modal" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="ticket-modal">{{ 'Submit New Support Ticket'|trans }}</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="{{ 'support/ticket_create'|api_url }}" {{ fb_api_form({callback: 'onServiceTicketCreated'}) }} id="open-ticket-form" class="open-ticket client-modal-form">
                            <div class="modal-body">
                                <p class="small text-secondary">{{ 'Service'|trans }}: {{ order.title }} (#{{ order.id }})</p>
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <div class="mb-3">
                                    <label for="ticket-helpdesk" class="form-label">{{ 'Help Desk'|trans }}</label>
                                    <select class="form-select" name="support_helpdesk_id" id="ticket-helpdesk" required>
                                        {% for id, title in client.support_helpdesk_get_pairs %}
                                            <option value="{{ id }}"{% if request.support_helpdesk_id == id %} selected{% endif %}>{{ title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="ticket-subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" id="ticket-subject" value="{{ request.subject|default('Help with Service'|trans ~ ': ' ~ order.title)|e }}" required/>
                                </div>
                                <div class="mb-3">
                                    <label for="ticket-content" class="form-label">{{ 'Message'|trans }} <span class="text-danger" aria-hidden="true">*</span></label>
                                    <textarea class="editor-textarea form-control" id="ticket-content" name="content" rows="5" required>{{ request.content|e }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">{{ 'Create Ticket'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="upgrade-request-modal" tabindex="-1" role="dialog" aria-labelledby="upgrade-modal" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="upgrade-modal">{{ 'Submit Upgrade Request'|trans }}</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="{{ 'support/ticket_create'|api_url }}" {{ fb_api_form({callback: 'onServiceTicketCreated'}) }} id="upgrade-request-form" class="request-upgrade client-modal-form">
                            <div class="modal-body">
                                <p class="small text-secondary">{{ 'Service'|trans }}: {{ order.title }} (#{{ order.id }})</p>
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <input type="hidden" name="rel_task" value="upgrade">
                                <p>{{ 'Support will review your upgrade request and confirm pricing and any service changes.'|trans }}</p>
                                <div class="mb-3">
                                    <label for="upgrade-helpdesk" class="form-label">{{ 'Help Desk'|trans }}</label>
                                    <select class="form-select" name="support_helpdesk_id" id="upgrade-helpdesk" required>
                                        {% for id, title in client.support_helpdesk_get_pairs %}
                                            <option value="{{ id }}"{% if request.support_helpdesk_id == id %} selected{% endif %}>{{ title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="upgrade-subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" id="upgrade-subject" value="{{ request.subject|default('Upgrade Request'|trans ~ ': ' ~ order.title)|e }}" required />
                                </div>
                                <div class="mb-3">
                                    <label for="rel_new_value" class="form-label">{{ 'Upgrade To'|trans }}</label>
                                    <select class="form-select" name="rel_new_value" id="rel_new_value" required>
                                        {% for id, title in upgradables %}<option value="{{ id }}">{{ title }}</option>{% endfor %}
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="upgrade-content" class="form-label">{{ 'Notes'|trans }}</label>
                                    <textarea id="upgrade-content" name="content" rows="5" required class="form-control">{{ 'I would like to upgrade'|trans }} {{ order.title }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary" id="upgrade-request-submit">{{ 'Send Upgrade Request'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
{% block js %}
<script>
    function onServiceTicketCreated(id) {
        window.location = {{ 'support/ticket'|url|json_encode|raw }} + '/' + encodeURIComponent(id);
    }
</script>
{% endblock %}
