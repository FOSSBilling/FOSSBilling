{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'services' %}
{% import "macro_functions.html.twig" as mf %}
{% block meta_title %}{{ 'Services'|trans }}{% endblock %}
{% block body_class %}order-list{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Services'|trans }}</li>
{% endblock %}

{% block content %}
    {% set attention = client.order_get_list({'per_page': 10, 'page': request.page|default(1), 'review': 1, 'with_actions': true}) %}
    {% set review_services = request.review|default(null) is not null ? request.review == '1' : attention.total > 0 %}
    {% set orders = review_services ? attention : client.order_get_list({'per_page': 10, 'page': request.page|default(1), 'hide_addons': 1, 'with_actions': true}) %}
    <h1 class="mb-4">{{ 'Services'|trans }}</h1>
    <div class="card mb-4">
        <div class="card-header">
            <nav class="nav nav-tabs card-header-tabs" aria-label="{{ 'Service View'|trans }}">
                <a class="nav-link{{ review_services ? ' active' : '' }}" href="{{ 'order/service'|url(query: {'review': 1}) }}"{% if review_services %} aria-current="page"{% endif %}>
                    {{ 'Needs Attention'|trans }}{% if attention.total %}<span class="badge text-bg-danger ms-1">{{ attention.total }}</span>{% endif %}
                </a>
                <a class="nav-link{{ not review_services ? ' active' : '' }}" href="{{ 'order/service'|url(query: {'review': 0}) }}"{% if not review_services %} aria-current="page"{% endif %}>{{ 'All Services'|trans }}</a>
            </nav>
        </div>
        <div class="card-body">
            {% if orders.list %}
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover client-service-list mb-0" aria-label="{{ 'Services'|trans }}">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'Service'|trans }}</th>
                                <th scope="col">{{ 'Status'|trans }}</th>
                                <th scope="col">{{ 'Renewal'|trans }}</th>
                                <th scope="col"><span class="visually-hidden">{{ 'Actions'|trans }}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders.list %}
                                {% set manage_url = "order/service/manage/#{order.id}"|url %}
                                <tr>
                                    <td class="service-reference">
                                        <a class="fw-semibold" href="{{ manage_url }}">{{ order.title }}</a>
                                        <div class="small text-secondary">#{{ order.id }}</div>
                                    </td>
                                    <td class="service-status">{{ include('partial_order_attention.html.twig') }}</td>
                                    <td class="service-renewal">
                                        {% if order.period and order.expires_at and order.status != 'canceled' %}
                                            <span class="d-block d-md-none small text-secondary" aria-hidden="true">{{ 'Renewal Date'|trans }}</span>
                                            <div>{{ order.expires_at|format_date }}</div>
                                        {% endif %}
                                        <div class="small text-secondary">{{ order.total|format_currency(order.currency ?? default_currency) }}{% if order.period %} / {{ order.period|period_title }}{% else %} · {{ 'One-time'|trans }}{% endif %}</div>
                                    </td>
                                    <td class="service-action">
                                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                                            {% if order.unpaid_invoice_hash|default(null) %}
                                                <a class="btn btn-sm btn-primary" href="{{ ('invoice/' ~ order.unpaid_invoice_hash)|url }}">{{ 'Pay Invoice'|trans }}</a>
                                            {% elseif order.renewal_due|default(false) %}
                                                <a class="btn btn-sm btn-primary" {{ fb_api_link({href: 'invoice/renewal_invoice'|api_url(query: {order_id: order.id}), modal: {type: 'confirm', title: 'Renew Service'|trans, content: 'Continue to the renewal invoice? Available account credit may be applied.'|trans}, callback: 'onRenewalInvoiceCreated'}) }}>{{ 'Renew Now'|trans }}</a>
                                            {% endif %}
                                            <a class="btn btn-sm {{ order.unpaid_invoice_hash|default(null) or order.renewal_due|default(false) ? 'btn-outline-secondary' : 'btn-outline-primary' }}" href="{{ manage_url }}" aria-label="{{ 'Manage %service%'|trans({'%service%': order.title}) }}">{{ 'Manage'|trans }}</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">{{ include('partial_pagination.html.twig', {'list': orders, 'url': 'order/service'}) }}</div>
            {% elseif review_services %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'No Services Need Attention'|trans,
                    'empty_action_label': 'View All Services'|trans,
                    'empty_action_url': 'order/service'|url(query: {'review': 0})
                }, with_context: false) }}
            {% else %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'You Have No Services Yet'|trans,
                    'empty_action_label': 'Browse Products and Services'|trans,
                    'empty_action_url': 'order'|url
                }, with_context: false) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
{% block js %}
    <script>window.onRenewalInvoiceCreated = (hash) => { window.location = {{ 'invoice'|url|json_encode|raw }} + '/' + encodeURIComponent(hash); };</script>
{% endblock %}
