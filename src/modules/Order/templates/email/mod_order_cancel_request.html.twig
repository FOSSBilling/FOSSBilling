{% block subject %}[{{ guest.system_company.name }}] {{ 'Cancellation request received'|trans }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		strong {
			font-weight: bold;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>{{ 'Cancellation request received'|trans }}</h1>
	<p>{{ 'Hello %name%,'|trans({'%name%': c.first_name|default('')}) }}</p>
	<p>{{ 'We have received your request to cancel this service: %title%.'|trans({'%title%': order.title|default('')}) }}</p>
	{% if request.type|default('') == 'end_of_period' %}
	<p>{{ 'You requested cancellation at the end of the billing period. Check the service page for the current status.'|trans }}</p>
	{% else %}
	<p>{{ 'You requested immediate cancellation. Check the service page for the current status. If the request is still waiting and you change your mind, you can withdraw it there.'|trans }}</p>
	{% endif %}
	<p>{{ 'You may'|trans }} <a href="{{ "order/service/manage/#{order.id}"|url(area: 'client') }}" target="_blank">{{ 'manage your service'|trans }}</a>.</p>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
