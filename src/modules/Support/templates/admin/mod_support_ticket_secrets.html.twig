{# Secrets the client attached to the ticket. Values open one by one, audited. #}
{% set secrets = admin.support_ticket_secret_list({ 'ticket_id': ticket.id }) %}
<div class="card mb-3" id="ticket-secrets">
    <div class="card-body">
        <h5 class="card-title mb-1">{{ 'Client Secrets'|trans }}</h5>
        <p class="text-secondary mb-3">{{ 'Encrypted logins the client attached. Values open one by one and every opening is recorded; they vanish when the ticket closes.'|trans }}</p>
        {% if secrets.secrets is empty %}
            <p class="text-secondary mb-0">{{ 'No secrets.'|trans }}</p>
        {% else %}
        <div class="table-responsive">
            <table class="table table-vcenter text-nowrap mb-0">
                <tbody>
                {% for secret in secrets.secrets %}
                    <tr>
                        <td>
                            <span class="badge bg-secondary-lt me-1">{{ secret.kind }}</span>
                            {{ secret.label }}
                            <div class="text-muted small">{{ secret.created_at|format_datetime }}</div>
                            <div data-secret-fields="{{ secret.id }}" class="mt-1"></div>
                        </td>
                        <td class="text-end text-nowrap">
                            {% if secrets.can_open %}
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-secret-open="{{ secret.id }}">{{ 'Show'|trans }}</button>
                            {% endif %}
                            {% if secrets.can_delete %}
                            <a class="btn btn-sm btn-outline-danger" href="{{ 'support/ticket_secret_delete'|api_url(query: { 'id': secret.id }) }}"
                                {{ fb_api_link({ message: 'Are you sure?'|trans, modal: {type: 'confirm', title: 'Are you sure?'|trans}, reload: true }) }}>{{ 'Delete'|trans }}</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
        {% if secrets.events is not empty %}
        <div class="mt-3">
            <h6 class="mb-1">{{ 'History'|trans }}</h6>
            <ul class="list-unstyled text-muted small mb-0">
            {% for event in secrets.events %}
                <li>
                    {{ event.label }} —
                    {% if event.action == 'opened' %}{{ 'opened by :name'|trans({ ':name': event.staff_name|default('Support') }) }}
                    {% elseif event.action == 'deleted' %}{{ 'deleted'|trans }}
                    {% else %}{{ 'deleted after the time limit'|trans }}
                    {% endif %}
                    <span>({{ event.created_at|format_datetime }})</span>
                </li>
            {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll('[data-secret-open]').forEach((btn) => {
            btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-secret-open');
                const target = document.querySelector('[data-secret-fields="' + id + '"]');
                if (target && target.dataset.loaded) {
                    target.innerHTML = '';
                    delete target.dataset.loaded;
                    btn.textContent = "{{ 'Show'|trans }}";
                    return;
                }
                FOSSBilling.api.admin.get('support/ticket_secret_open', { id: id }, (fields) => {
                    if (!target) {
                        return;
                    }
                    const dl = document.createElement('dl');
                    dl.className = 'row small mb-0';
                    Object.entries(fields).forEach(([key, value]) => {
                        if (value === null || value === undefined || value === '') {
                            return;
                        }
                        const dt = document.createElement('dt');
                        dt.className = 'col-sm-3';
                        dt.textContent = key;
                        const dd = document.createElement('dd');
                        dd.className = 'col-sm-9 text-break';
                        const code = document.createElement('code');
                        code.textContent = value;
                        const copy = document.createElement('button');
                        copy.type = 'button';
                        copy.className = 'btn btn-sm btn-link py-0';
                        copy.textContent = "{{ 'Copy'|trans }}";
                        copy.addEventListener('click', () => navigator.clipboard?.writeText(String(value)));
                        dd.append(code, ' ', copy);
                        dl.append(dt, dd);
                    });
                    target.innerHTML = '';
                    target.append(dl);
                    target.dataset.loaded = '1';
                    btn.textContent = "{{ 'Hide'|trans }}";
                });
            });
        });
    });
</script>
