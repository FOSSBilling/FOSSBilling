{% extends request.ajax ? 'layout_blank.html.twig' : 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% block meta_title %}{{ ticket.subject }} - {{ ticket.messages|length }} {{ 'message(s)'|trans }}{% endblock %}

{% block breadcrumbs %}
    <ul class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ '/'|url }}">
                <svg class="icon">
                    <use href="#home" />
                </svg>
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'support'|url }}">{{ 'Support'|trans }}</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ 'support'|url }}">{{ 'Tickets'|trans }}</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">#{{ ticket.id }} - {{ ticket.subject }}</li>
    </ul>
{% endblock %}

{% set active_menu = 'support' %}

{% block top_content %}
    {{ include('partial_admin_page_heading.html.twig', {title: ticket.subject, description: '#' ~ ticket.id ~ ' · ' ~ ticket.author.name}) }}
{% endblock %}

{% block content %}
{% embed 'partial_admin_detail_tabs.html.twig' with {
    show_header: false,
    outer_card_class: 'mb-3'
} %}
    {% block detail_tabs %}
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="index-tab" data-bs-target="#tab-index" data-bs-toggle="tab" type="button" role="tab" aria-controls="tab-index" aria-selected="true">{{ 'Ticket'|trans }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="manage-tab" data-bs-target="#tab-manage" data-bs-toggle="tab" type="button" role="tab" aria-controls="tab-manage" aria-selected="false">{{ 'Manage'|trans }}</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="notes-tab" data-bs-target="#tab-notes" data-bs-toggle="tab" type="button" role="tab" aria-controls="tab-notes" aria-selected="false">{{ 'Notes'|trans }} {% if ticket.notes is defined and ticket.notes|length > 0 %}({{ ticket.notes|length }}){% endif %}</button>
                    </li>
                    {% if ticket.author.role|default('') == 'client' %}
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="support-tab" data-bs-target="#tab-support" data-bs-toggle="tab" type="button" role="tab" aria-controls="tab-support" aria-selected="false">{{ 'Client Tickets'|trans }}</button>
                    </li>
                    {% endif %}
    {% endblock %}

    {% block detail_tab_content %}
        {% import 'macro_functions.html.twig' as mf %}
        <div class="tab-pane fade show active" id="tab-index" role="tabpanel" aria-labelledby="index-tab">
            <div class="p-3 d-flex flex-column gap-3">
                {% set task = ticket.rel %}
                <div class="card">
                    <div class="card-header d-flex flex-wrap gap-3">
                        {{ include('partial_support_ticket_status.html.twig', {status: ticket.status}) }}
                        <span class="text-secondary small">{{ 'Updated'|trans }} {{ '%time% ago'|trans({'%time%': ticket.updated_at|timeago}) }}</span>
                        <div class="d-flex flex-wrap gap-2 ms-auto">
                            {% if ticket.status != 'closed' %}
                                <a class="btn btn-outline-secondary" href="{{ 'support/ticket_close'|api_url(query: {id: ticket.id}) }}"
                                    {{ fb_api_link({message: 'Are you sure?'|trans, modal: {type: 'confirm', title: 'Are you sure?'|trans}, redirect: 'support'|url(query: {status: 'open'})}) }}>{{ 'Close Ticket'|trans }}</a>
                            {% endif %}
                            {% if ticket.author.role|default('') == 'guest' and ticket.hash is defined %}
                                <a class="btn btn-outline-secondary" href='{{ "support/ticket/#{ticket.hash}"|url(area: 'client') }}' target="_blank">{{ 'View as Author'|trans }}</a>
                            {% endif %}
                            <a class="btn btn-primary" href='{{ "support/ticket/#{ticket.id}"|url }}#reply-box'>{{ 'Reply'|trans }}</a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-sm-6 col-xl-4">
                                <div class="form-label">{{ 'Author'|trans }}</div>
                                {% if ticket.author.role|default('') == 'client' %}
                                    <a class="fw-medium" href='{{ "client/manage/#{ticket.author.id}"|url }}'>{{ ticket.author.name }}</a>
                                {% else %}
                                    <span class="fw-medium">{{ ticket.author.name }}</span>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">{{ 'Guest'|trans }}</span>
                                {% endif %}
                                <div class="text-secondary small text-break">{{ ticket.author.email }}</div>
                            </div>
                            <div class="col-sm-6 col-xl-3">
                                <div class="form-label">{{ 'Helpdesk'|trans }}</div>
                                {{ ticket.helpdesk.name|default('–') }}
                            </div>
                            <div class="col-6 col-xl-3">
                                <div class="form-label">{{ 'Opened'|trans }}</div>
                                {{ ticket.created_at|format_datetime }}
                            </div>
                            <div class="col-6 col-xl-2">
                                <div class="form-label">{{ 'Priority'|trans }}</div>
                                {{ ticket.priority }}
                            </div>
                        </div>
                        {% if task.task or task.type == 'order' or task.status == 'pending' %}
                        <div class="d-flex flex-wrap align-items-center gap-3 border-top pt-3 mt-3">
                            {% if task.task %}<span>{{ 'Task'|trans }}: {{ mf.status_name(task.task) }}</span>{% endif %}
                            {% if task.type == 'order' %}<a href='{{ "order/manage/#{task.id}"|url }}'>{{ 'Order'|trans }} #{{ task.id }}</a>{% endif %}
                            {% if task.task == 'upgrade' %}<span>{{ 'Upgrade To'|trans }}: <a href='{{ "product/manage/#{task.new_value}"|url }}'>{{ admin.product_get_pairs[task.new_value] }}</a></span>{% endif %}
                            {% if task.status == 'pending' %}
                                <a class="btn btn-primary" href="{{ 'support/task_complete'|api_url(query: {id: ticket.id}) }}" {{ fb_api_link({reload: true}) }}>{{ 'Set Task Complete'|trans }}</a>
                            {% endif %}
                        </div>
                        {% endif %}
                    </div>

                </div>

                <div class="card">
                    <div class="card-body pb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div class="d-flex flex-column gap-1">
                                <h5 class="card-title mb-0">{{ 'Conversation'|trans }}</h5>
                                <p class="text-secondary small mb-0">{{ (ticket.messages|length == 1 ? '%count% message' : '%count% messages')|trans({'%count%': ticket.messages|length}) }}</p>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="toggleMessages">
                                <svg class="icon">
                                    <use href="#eye" />
                                </svg>
                                <span>{{ (ticket.messages|length <= 2 ? 'Collapse messages' : 'Show all messages')|trans }}</span>
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-0">
                        <div class="conversation">
                            {% for i, message in ticket.messages %}
                            {% set message_expanded = loop.last or loop.index + 1 == ticket.messages|length or message.id == request_message %}
                            <div class="card mb-3"{% if message.id == request_message %} id="direct-msg"{% endif %}>
                                <div class="card-header flex-wrap gap-2">
                                    {{ avatar(message.author.email|default(''), 24, 'avatar avatar-xs', name: message.author.name|default('')) }}
                                    <button class="btn btn-link p-0 text-body text-start fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#message-body-{{ message.id }}" aria-controls="message-body-{{ message.id }}" aria-expanded="{{ message_expanded ? 'true' : 'false' }}">
                                        <svg class="icon icon-sm me-1" aria-hidden="true"><use href="#chevron-down" /></svg>
                                        {{ message.author.name|default('') }}
                                    </button>
                                    {% if message.author.role|default('') == 'admin' %}
                                        <span class="badge bg-info-subtle text-info-emphasis">{{ 'Staff'|trans }}</span>
                                    {% endif %}
                                    <time class="text-secondary small ms-auto" datetime="{{ message.created_at|date('c') }}">{{ message.created_at|format_datetime }}</time>
                                    <a class="btn btn-ghost-secondary btn-icon btn-sm" aria-label="{{ 'Link to message'|trans }}" href='{{ "support/ticket/#{ticket.id}/message/#{message.id}"|url }}'>
                                        <svg class="icon"><use href="#link" /></svg>
                                    </a>
                                    {% if message.author.role|default('') == 'admin' %}
                                        <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm" aria-label="{{ 'Edit Reply'|trans }}" data-bs-toggle="modal" data-bs-target="#editMessage{{ message.id }}">
                                            <svg class="icon"><use href="#edit" /></svg>
                                        </button>
                                    {% endif %}
                                    {% if message.updated_at != message.created_at %}
                                        <button type="button" class="btn btn-ghost-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#messageHistory{{ message.id }}">{{ 'Edited'|trans }}</button>
                                    {% endif %}
                                </div>
                                <div class="collapse{% if message_expanded %} show{% endif %}" id="message-body-{{ message.id }}" data-ticket-message>
                                    <div class="card-body">
                                        <article class="markdown-body bg-transparent text-reset">{{ (message.content ?? '')|markdown_to_html }}</article>
                                    </div>
                                </div>
                            </div>

                            {% if message.author.role == 'admin' %}
                            <div class="modal modal-blur fade" id="editMessage{{ message.id }}" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-scrollable modal-lg modal-fullscreen-md-down">
                                    <form class="modal-content" method="post" action="{{ 'support/ticket_message_update'|api_url }}" {{ fb_api_form({reload: true}) }}>
                                        <div class="modal-header">
                                            <h5 class="modal-title">{{ 'Edit Reply'|trans }}</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                                        </div>
                                        <div class="modal-body">
                                            <input type="hidden" name="id" value="{{ message.id }}">
                                            <textarea class="form-control" name="content" rows="8" required>{{ message.content }}</textarea>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                                            <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            {% endif %}

                            {% if message.updated_at != message.created_at %}
                            <div class="modal modal-blur fade message-history-modal" id="messageHistory{{ message.id }}" tabindex="-1" aria-hidden="true" data-message-id="{{ message.id }}">
                                <div class="modal-dialog modal-dialog-scrollable modal-lg modal-fullscreen-md-down">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">{{ 'Edit History'|trans }}</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                                        </div>
                                        <div class="modal-body message-history-body">
                                            <p class="text-secondary mb-0">{{ 'Loading...'|trans }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="card mb-0" id="reply-box">
                    <form method="post" action="{{ 'support/ticket_reply'|api_url }}" {{ fb_api_form({ reload: true }) }}>
                        <div class="card-body">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                                <div class="d-flex flex-column gap-1">
                                    <h5 class="card-title mb-0">{{ 'Respond as'|trans }} {{ profile.name }}</h5>
                                    <p class="text-secondary small mb-0">{{ 'Replies are sent to the ticket author.'|trans }}</p>
                                </div>
                                <div>{{ include('mod_support_canned_selector.html.twig') }}</div>
                            </div>

                            <textarea class="editor-textarea" id="rt" name="content" rows="10" required>{{ 'Hello'|trans }} {{ ticket.author.first_name|default(ticket.author.name) }},
{{ canned_delay_message }}

{{ profile.signature }}
{{ ticket.helpdesk.signature|default('') }}</textarea>
                        </div>
                        <div class="card-footer d-flex flex-wrap align-items-center gap-2">
                            <input type="hidden" name="id" value="{{ ticket.id }}">
                            <input type="submit" value="{{ 'Send Reply'|trans }}" class="btn btn-primary ms-auto">

                            {% if ticket.messages|length > 2 and ticket.status != 'closed' %}
                            <a class="btn btn-outline-secondary" href="{{ 'support/ticket_close'|api_url(query: { 'id': ticket.id }) }}"
                                {{ fb_api_link({ message: 'Are you sure?'|trans, modal: {type: 'confirm', title: 'Are you sure?'|trans}, redirect: 'support'|url(query: { status: 'open' }) }) }}>
                                <svg class="icon">
                                    <use href="#check" />
                                </svg>
                                {{ 'Close Ticket'|trans }}
                            </a>
                            {% endif %}
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-manage" role="tabpanel" aria-labelledby="manage-tab">
            <div class="card-body">
                <form method="post" action="{{ 'support/ticket_update'|api_url }}" {{ fb_api_form({ reload: true}) }}>
                    {% embed 'partial_admin_form_card.html.twig' with {
                        title: 'Ticket Settings'|trans,
                        card_class: 'border-0 shadow-none rounded-0',
                        subtitle: 'Update the subject, helpdesk assignment, workflow status, and priority for this ticket.'|trans
                    } %}
                        {% import 'macro_functions.html.twig' as mf %}
                        {% block form_content %}
                            <div class="row g-3">
                                <div class="col-lg-6">
                                    <label class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" value="{{ ticket.subject }}" required>
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label">{{ 'Helpdesk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', admin.support_helpdesk_get_pairs, ticket.support_helpdesk_id, 1) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label">{{ 'Status'|trans }}</label>
                                    {{ mf.selectbox('status', {'open': 'Awaiting Staff'|trans, 'on_hold': 'Awaiting Client'|trans, 'closed': 'Closed'|trans}, ticket.status, 1) }}
                                </div>
                                <div class="col-lg-6">
                                    <label class="form-label">{{ 'Priority'|trans }}</label>
                                    <input class="form-control" type="text" name="priority" value="{{ ticket.priority }}">
                                </div>
                            </div>
                            <input type="hidden" name="id" value="{{ ticket.id }}">
                        {% endblock %}

                        {% block form_actions %}
                            <a class="btn btn-outline-danger me-auto" href="{{ 'support/ticket_delete'|api_url(query: {id: ticket.id}) }}"
                            {{ fb_api_link({message: 'Are you sure?'|trans, modal: {type: 'confirm', title: 'Are you sure?'|trans}, redirect: 'support'|url}) }}>{{ 'Delete'|trans }}</a>
                            <button class="btn btn-primary" type="submit">{{ 'Update'|trans }}</button>
                        {% endblock %}
                    {% endembed %}
                </form>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-notes" role="tabpanel" aria-labelledby="notes-tab">
            <div class="p-3 d-flex flex-column gap-3">
                {% embed 'partial_admin_related_section.html.twig' with {
                    title: 'Internal Notes'|trans,
                    subtitle: 'Keep internal staff notes attached to this ticket and remove them when no longer needed.'|trans,
                    card_class: 'mb-0'
                } %}
                    {% block section_content %}
                        <div class="table-responsive">
                            <table class="table card-table table-vcenter table-striped text-nowrap">
                            {% for note in ticket.notes|default([]) %}
                                <tr>
                                    <td class="w-1"><a href='{{ "staff/manage/#{note.admin_id}"|url }}'>{{ note.author.name }}</a></td>
                                    <td>{{ note.note }}</td>
                                    <td class="w-1">
                                        <a class="btn btn-ghost-secondary btn-icon btn-sm" aria-label="{{ 'Delete'|trans }}" href="{{ 'support/note_delete'|api_url(query: { 'id': note.id }) }}"
                                            {{ fb_api_link({ message: 'Are you sure?'|trans, modal: {type: 'confirm', title: 'Are you sure?'|trans}, reload: true }) }}>
                                            <svg class="icon"><use href="#trash" /></svg>
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td class="text-muted" colspan="3">{{ 'The list is empty'|trans }}</td></tr>
                            {% endfor %}
                            </table>
                        </div>
                    {% endblock %}
                {% endembed %}

                <form method="post" action="{{ 'support/note_create'|api_url }}" {{ fb_api_form({ reload: true}) }}>
                    {% embed 'partial_admin_form_card.html.twig' with {
                        title: 'Add Internal Note'|trans,
                        subtitle: 'Record a staff-only note against this ticket.'|trans,
                        card_class: 'mb-0'
                    } %}
                        {% block form_content %}
                            <label class="form-label" for="textareaNote">{{ 'Note'|trans }}</label>
                            <textarea data-bs-toggle="autosize" class="form-control" id="textareaNote" name="note" rows="3" required></textarea>
                            <input type="hidden" name="ticket_id" value="{{ ticket.id }}">
                        {% endblock %}

                        {% block form_actions %}
                            <button class="btn btn-primary" type="submit">
                                <svg class="icon">
                                    <use href="#plus" />
                                </svg>
                                {{ 'Add Note'|trans }}
                            </button>
                        {% endblock %}
                    {% endembed %}
                </form>
            </div>
        </div>

        {% if ticket.author.role == 'client' %}
        <div class="tab-pane fade" id="tab-support" role="tabpanel" aria-labelledby="support-tab">
            {% embed 'partial_admin_related_section.html.twig' with {
                title: 'Client Tickets'|trans,
                subtitle: 'Review other tickets for this client and open a new ticket without leaving the current conversation.'|trans,
                card_class: 'm-3'
            } %}
                {% block section_action %}
                    <a href="{{ 'support'|url(query: { 'client_id': ticket.author.id}) }}#tab-new" class="btn btn-primary">
                        <svg class="icon"><use href="#plus" /></svg>
                        {{ 'New Support Ticket'|trans }}
                    </a>
                {% endblock %}

                {% block section_content %}
                    {% import 'macro_functions.html.twig' as mf %}
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter table-striped text-nowrap">
                            <thead>
                                <tr>
                                    <th>{{ 'ID'|trans }}</th>
                                    <th>{{ 'Helpdesk'|trans }}</th>
                                    <th>{{ 'Subject'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set tickets = admin.support_ticket_get_list({ 'per_page': 20, 'client_id': ticket.author.id, 'deep': 0, 'include_first': 0 }) %}
                                {% for related_ticket in tickets.list %}
                                <tr>
                                    <td>{{ related_ticket.id }}</td>
                                    <td>{{ related_ticket.helpdesk.name }}</td>
                                    <td><a class="fw-semibold" href='{{ "support/ticket/#{related_ticket.id}"|url }}'>{{ related_ticket.subject|truncate(30) }}</a></td>
                                    <td>{{ include('partial_support_ticket_status.html.twig', {status: related_ticket.status}) }}</td>
                                    <td>
                                        <a class="btn btn-ghost-secondary btn-icon btn-sm" aria-label="{{ 'Edit'|trans }}" href='{{ "support/ticket/#{related_ticket.id}"|url }}'>
                                            <svg class="icon"><use href="#edit" /></svg>
                                        </a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr><td class="text-muted" colspan="5">{{ 'The list is empty'|trans }}</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
        {% endif %}
    {% endblock %}
{% endembed %}
{% endblock %}

{% block js%}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const directMsg = document.getElementById('direct-msg');
        if (directMsg) {
            window.scrollTo({top: directMsg.getBoundingClientRect().top + window.scrollY - 64});
        }

        let showAllMessages = {{ ticket.messages|length <= 2 ? 'true' : 'false' }};
        document.getElementById('toggleMessages').addEventListener('click', function() {
            showAllMessages = !showAllMessages;
            document.querySelectorAll('.conversation [data-ticket-message]').forEach(function(element) {
                const collapse = tabler.Collapse.getOrCreateInstance(element, {toggle: false});
                showAllMessages ? collapse.show() : collapse.hide();
            });
            this.querySelector('span').textContent = showAllMessages
                ? '{{ 'Collapse messages'|trans|e('js') }}'
                : '{{ 'Show all messages'|trans|e('js') }}';
        });

        document.querySelectorAll('.message-history-modal').forEach(function(modalEl) {
            modalEl.addEventListener('shown.bs.modal', function() {
                if (modalEl.dataset.loaded) return;

                var body = modalEl.querySelector('.message-history-body');
                FOSSBilling.api.admin.get('support/ticket_message_history_get_list', { id: modalEl.dataset.messageId }, function(history) {
                    modalEl.dataset.loaded = '1';
                    body.innerHTML = '';

                    if (!history || history.length === 0) {
                        var empty = document.createElement('p');
                        empty.className = 'text-secondary mb-0';
                        empty.textContent = '{{ 'No edit history for this message yet.'|trans|e('js') }}';
                        body.appendChild(empty);
                        return;
                    }

                    history.forEach(function(revision) {
                        var entry = document.createElement('div');
                        entry.className = 'mb-3 pb-3 border-bottom';

                        var meta = document.createElement('div');
                        meta.className = 'text-muted small mb-1';
                        meta.textContent = revision.created_at;

                        var content = document.createElement('article');
                        content.className = 'markdown-body bg-transparent text-reset mb-0';
                        content.innerHTML = revision.content_html;

                        entry.appendChild(meta);
                        entry.appendChild(content);
                        body.appendChild(entry);
                    });
                }, function() {
                    body.innerHTML = '';

                    var error = document.createElement('p');
                    error.className = 'text-danger mb-0';
                    error.textContent = '{{ 'Could not load edit history. Please try again.'|trans|e('js') }}';
                    body.appendChild(error);
                });
            });
        });
    });
</script>
{% endblock %}

{% block head %}
    {{ 'css/markdown.css' | public_asset_url | stylesheet_tag }}
    {{ wysiwyg('.editor-textarea') }}
{% endblock %}
