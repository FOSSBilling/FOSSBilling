{% block subject %}[{{ guest.system_company.name }}] {{ 'How did we do? Your feedback on ticket #%id%'|trans({'%id%': ticket.id|default('')}) }}{% endblock %}
{% block content %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		strong {
			font-weight: bold;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>{{ 'How did we do?'|trans }}</h1>
	<p>Hello {{ c.first_name|default(name|default('')) }},</p>

	<p>{{ 'Your support ticket #%id% (%subject%) was closed. Please rate the staff who helped you and tell us how we can improve.'|trans({'%id%': ticket.id|default(''), '%subject%': ticket.subject|default('')}) }}</p>

	<a href="{{ feedback_url|default('') }}" target="_blank">{{ 'Give feedback'|trans }}</a>

	<div class="signature">{{ guest.system_email.signature }}</div>
</body>
</html>
{% endblock %}
