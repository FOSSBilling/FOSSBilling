{# Secrets the client attached to the ticket (values never shown back). #}
{% set secrets = client.support_ticket_secret_list({ 'ticket_id': ticket.id }) %}
{% set kinds = client.support_ticket_secret_kinds %}
<div class="card mt-3" id="ticket-secrets">
    <div class="card-body">
        <h5 class="card-title mb-1">{{ 'Login Details'|trans }}</h5>
        <p class="text-secondary mb-3">{{ 'Share logins with support without posting them in messages. Values are encrypted, openable by staff only, and vanish when the ticket closes.'|trans }}</p>
        {% if secrets.secrets is empty %}
            <p class="text-secondary mb-3">{{ 'No secrets attached.'|trans }}</p>
        {% else %}
        <ul class="list-group mb-3">
            {% for secret in secrets.secrets %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    <span class="badge text-bg-secondary me-1">{{ secret.kind }}</span>
                    {{ secret.label }}
                    <span class="text-muted small">({{ secret.created_at|format_date }})</span>
                </span>
                <button type="button" class="btn btn-sm btn-link link-danger" data-secret-delete="{{ secret.id }}">{{ 'Delete'|trans }}</button>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
        {% if kinds.server or kinds.other %}
        <form id="ticket-secret-form">
            <input type="hidden" name="ticket_id" value="{{ ticket.id }}">
            <div class="mb-2">
                <div class="form-check form-check-inline">
                    {% if kinds.server %}
                    <input class="form-check-input" type="radio" name="kind" id="secret-kind-server" value="server" checked>
                    <label class="form-check-label" for="secret-kind-server">{{ 'Server'|trans }}</label>
                    {% endif %}
                    {% if kinds.other %}
                    <input class="form-check-input" type="radio" name="kind" id="secret-kind-other" value="other"{% if not kinds.server %} checked{% endif %}>
                    <label class="form-check-label" for="secret-kind-other">{{ 'Other'|trans }}</label>
                    {% endif %}
                </div>
            </div>
            <div data-secret-pane="server"{% if not kinds.server %} hidden{% endif %}>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label" for="secret-host">{{ 'Host'|trans }}</label>
                        <input type="text" name="host" id="secret-host" class="form-control" maxlength="255">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="secret-type">{{ 'Type'|trans }}</label>
                        <select name="type" id="secret-type" class="form-select">
                            <option value="ssh">SSH</option>
                            <option value="panel">{{ 'Panel'|trans }}</option>
                            <option value="other">{{ 'Other'|trans }}</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="secret-port">{{ 'Port'|trans }}</label>
                        <input type="number" name="port" id="secret-port" class="form-control" min="1" max="65535">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="secret-username">{{ 'Username'|trans }}</label>
                        <input type="text" name="username" id="secret-username" class="form-control" maxlength="255" autocomplete="off">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="secret-password">{{ 'Password'|trans }}</label>
                        <input type="password" name="password" id="secret-password" class="form-control" maxlength="1000" autocomplete="new-password">
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="secret-ssh-key">{{ 'SSH key'|trans }}</label>
                        <textarea name="ssh_key" id="secret-ssh-key" class="form-control" rows="2" maxlength="20000"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="secret-note">{{ 'Note'|trans }}</label>
                        <input type="text" name="note" id="secret-note" class="form-control" maxlength="2000">
                    </div>
                </div>
            </div>
            <div data-secret-pane="other"{% if kinds.server %} hidden{% endif %}>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label" for="secret-label">{{ 'Label'|trans }}</label>
                        <input type="text" name="label" id="secret-label" class="form-control" maxlength="100">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="secret-value">{{ 'Value'|trans }}</label>
                        <input type="password" name="value" id="secret-value" class="form-control" maxlength="5000" autocomplete="new-password">
                    </div>
                </div>
            </div>
            <button class="mt-2 btn btn-secondary" type="submit">{{ 'Add'|trans }}</button>
        </form>
        {% endif %}
        {% if secrets.events is not empty %}
        <div class="mt-3">
            <h6 class="mb-1">{{ 'History'|trans }}</h6>
            <ul class="list-unstyled text-muted small mb-0">
            {% for event in secrets.events %}
                <li>
                    {{ event.label }} —
                    {% if event.action == 'opened' %}{{ 'opened by :name'|trans({ ':name': event.staff_name|default('Support') }) }}
                    {% elseif event.action == 'deleted' %}{{ 'deleted'|trans }}
                    {% else %}{{ 'deleted after the time limit'|trans }}
                    {% endif %}
                    <span>({{ event.created_at|format_date }})</span>
                </li>
            {% endfor %}
            </ul>
        </div>
        {% endif %}
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const card = document.getElementById('ticket-secrets');
        if (!card) {
            return;
        }
        document.querySelectorAll('input[name="kind"]', card).forEach((radio) => {
            radio.addEventListener('change', () => {
                card.querySelectorAll('[data-secret-pane]').forEach((pane) => {
                    pane.hidden = pane.getAttribute('data-secret-pane') !== radio.value;
                });
            });
        });
        card.querySelectorAll('[data-secret-delete]').forEach((btn) => {
            btn.addEventListener('click', () => {
                FOSSBilling.api.client.post('support/ticket_secret_delete', { id: btn.getAttribute('data-secret-delete') },
                    () => window.location.reload(),
                    (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error'));
            });
        });
        const form = document.getElementById('ticket-secret-form');
        form?.addEventListener('submit', (e) => {
            e.preventDefault();
            FOSSBilling.api.client.post('support/ticket_secret_add', FOSSBilling.tools.serializeFormDataToObject(new FormData(form)),
                () => window.location.reload(),
                (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error'));
        });
    });
</script>
