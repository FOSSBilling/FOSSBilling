{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'support' %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ 'Support Tickets'|trans }}{% endblock %}
{% block page_header %}{{ 'Support Tickets'|trans }}{% endblock %}

{% block body_class %}support-tickets{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ 'Support Tickets'|trans }}</li>{% endblock %}

{% block head %}
    {{ wysiwyg('.editor-textarea') }}
{% endblock %}

{% block content %}
    {% set views = {'on_hold': 'Awaiting Your Reply'|trans, 'open': 'Waiting for Support'|trans, 'closed': 'Closed'|trans, 'all': 'All Tickets'|trans} %}
    {% set replies = client.support_ticket_get_list({'per_page': 10, 'page': request.page|default(1), 'status': 'on_hold', 'sort': 'updated_at', 'direction': 'DESC'}) %}
    {% set selected_status = request.status|default(null) in views|keys ? request.status : (replies.total ? 'on_hold' : 'all') %}
    {% set tickets = selected_status == 'on_hold' ? replies : client.support_ticket_get_list({'per_page': 10, 'page': request.page|default(1), 'status': selected_status == 'all' ? null : selected_status, 'sort': 'updated_at', 'direction': 'DESC'}) %}
    {% embed 'partial_page_heading.html.twig' with {title: 'Support Tickets'|trans, heading_class: 'mb-4', heading_actions_class: 'client-action-group'} %}
        {% block card_heading_actions %}
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#open-ticket-modal">{{ 'New Ticket'|trans }}</button>
        {% endblock %}
    {% endembed %}
    <div class="card mb-4">
        <div class="card-header">
            <nav class="nav nav-tabs card-header-tabs" aria-label="{{ 'Ticket View'|trans }}">
                {% for status, label in views %}
                    <a class="nav-link{{ selected_status == status ? ' active' : '' }}" href="{{ 'support'|url(query: {'status': status}) }}"{% if selected_status == status %} aria-current="page"{% endif %}>
                        {{ label }}{% if status == 'on_hold' and replies.total %}<span class="badge text-bg-primary ms-1">{{ replies.total }}</span>{% endif %}
                    </a>
                {% endfor %}
            </nav>
        </div>
        <div class="card-body">
            {% if tickets.list %}
                <div class="table-responsive">
                    <table class="table table-vcenter table-hover client-ticket-list mb-0" aria-label="{{ 'Support Tickets'|trans }}">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'Conversation'|trans }}</th>
                                <th scope="col">{{ 'Status'|trans }}</th>
                                <th scope="col">{{ 'Last Updated'|trans }}</th>
                                <th scope="col"><span class="visually-hidden">{{ 'Actions'|trans }}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ticket in tickets.list %}
                                {% set ticket_url = "support/ticket/#{ticket.id}"|url %}
                                <tr>
                                    <td class="ticket-reference">
                                        <a class="fw-semibold" href="{{ ticket_url }}">{{ ticket.subject }}</a>
                                        <div class="small text-secondary">#{{ ticket.id }} · {{ ticket.helpdesk.name }}</div>
                                    </td>
                                    <td class="ticket-status">{{ include('partial_support_ticket_status.html.twig') }}</td>
                                    <td class="ticket-updated">
                                        <span class="d-block d-md-none small text-secondary" aria-hidden="true">{{ 'Last Updated'|trans }}</span>
                                        <time datetime="{{ ticket.updated_at|date('c') }}" title="{{ ticket.updated_at|format_date }}">{{ ticket.updated_at|timeago }} {{ 'ago'|trans }}</time>
                                    </td>
                                    <td class="ticket-action text-end">
                                        <a class="btn btn-sm {{ ticket.status == 'on_hold' ? 'btn-primary' : 'btn-outline-secondary' }}"
                                           href="{{ ticket_url }}{{ ticket.status == 'on_hold' ? '#reply-to' : '' }}"
                                           aria-label="{{ ticket.status == 'on_hold' ? 'Reply to Ticket #%number%'|trans({'%number%': ticket.id}) : 'View Ticket #%number%'|trans({'%number%': ticket.id}) }}">
                                            {{ ticket.status == 'on_hold' ? 'Reply'|trans : 'View Conversation'|trans }}
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">{{ include('partial_pagination.html.twig', {'list': tickets, 'url': 'support'}) }}</div>
            {% elseif selected_status == 'on_hold' %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'No Tickets Need Your Reply'|trans,
                    'empty_action_label': 'View All Tickets'|trans,
                    'empty_action_url': 'support'|url(query: {'status': 'all'})
                }, with_context: false) }}
            {% elseif selected_status == 'open' %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'No Tickets Waiting for Support'|trans
                }, with_context: false) }}
            {% elseif selected_status == 'closed' %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'No Closed Tickets'|trans
                }, with_context: false) }}
            {% else %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'You Have No Support Tickets Yet'|trans,
                    'empty_description': 'Use New Ticket to start a conversation.'|trans
                }, with_context: false) }}
            {% endif %}
        </div>
    </div>


<div class="modal fade" id="open-ticket-modal" tabindex="-1" aria-labelledby="open-ticket-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h3" id="open-ticket-title">{{ 'New Ticket'|trans }}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
            </div>
            <form action="{{ 'support/ticket_create'|api_url }}" method="post" class="client-modal-form" id="ticket-submit" {{ fb_api_form({callback: 'onTicketCreated'}) }}>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="support-helpdesk-id" class="form-label">{{ 'Helpdesk'|trans }}</label>
                        <select name="support_helpdesk_id" id="support-helpdesk-id" class="form-select" required>
                            {% for id, name in client.support_helpdesk_get_pairs %}
                                <option value="{{ id }}"{% if request.support_helpdesk_id|default(null) == id %} selected{% endif %}>{{ name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                        <input type="text" name="subject" class="form-control" id="subject" required value="{{ request.subject|e }}">
                    </div>
                    {% if guest.support_kb_suggestions_enabled({ 'area': 'ticket' }) %}
                        {{ include('mod_support_kb_suggestions.html.twig', { 'input_id': 'subject' }) }}
                    {% endif %}
                    <div class="mb-3">
                        <label for="message" class="form-label">{{ 'Message'|trans }} <span class="text-danger" aria-hidden="true">*</span></label>
                        <textarea name="content" class="editor-textarea form-control" id="message" rows="5" required>{{ request.content|e }}</textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">{{ 'Create Ticket'|trans }}</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block js %}
    <script>
        window.onTicketCreated = (id) => { window.location = {{ 'support/ticket'|url|json_encode|raw }} + '/' + encodeURIComponent(id); };
        document.addEventListener('DOMContentLoaded', () => {
            {% if request.ticket %}
                tabler.Modal.getOrCreateInstance(document.getElementById('open-ticket-modal')).show();
            {% endif %}
        });
    </script>
{% endblock %}
