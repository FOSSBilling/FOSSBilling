{# Files attached to a ticket message. #}
{% set files = message.ticket_files|default([]) %}
{% if files is not empty %}
<div class="mt-2 small">
    {% for file in files %}
    <div class="d-flex align-items-center gap-2 py-1">
        {% if not file.removed %}
        <svg class="icon"><use href="#paperclip" /></svg>
        <a href='{{ "support/ticket-file/#{file.id}"|url }}' target="_blank">{{ file.name }}</a>
        <span class="text-muted">({{ file.size_label }})</span>
        {% elseif file.removed_reason == 'expired' %}
        <span class="text-muted">{{ 'Removed after the keep period: :name'|trans({ ':name': file.name }) }}</span>
        {% else %}
        <span class="text-muted">{{ 'Removed by staff: :name'|trans({ ':name': file.name }) }}</span>
        {% endif %}
    </div>
    {% endfor %}
</div>
{% endif %}
