{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'kb' %}

{% block meta_title %}{{ 'Knowledge Base'|trans }}{% endblock %}
{% block meta_description %}{{ 'Browse help articles, tutorials, and answers to common questions in our knowledge base.'|trans }}{% endblock %}
{% block body_class %}kb-index{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page">{{ 'Knowledge Base'|trans }}</li>{% endblock %}

{% block content %}
    {% set query = request.q|default('')|trim %}
    <h1 class="mb-4">{{ 'Knowledge Base'|trans }}</h1>
    <div class="card mb-4"><div class="card-body">{{ include('partial_support_kb_search.html.twig') }}</div></div>
    <section class="card mb-4" aria-labelledby="kb-results-heading">
        <div class="card-body">
            {% if query %}
                {% set articles = guest.support_kb_article_get_list({'search': query, 'per_page': 10, 'page': request.page|default(1)}) %}
                <h2 class="card-title mb-3" id="kb-results-heading">{{ 'Search Results'|trans }}</h2>
                {% if articles.list %}
                    {{ include('partial_support_kb_articles.html.twig', {'articles': articles, 'show_category': true, 'pagination_url': 'support/kb'}) }}
                {% elseif articles.total|default(0) > 0 %}
                    {{ include('partial_client_empty.html.twig', {
                        'empty_title': 'No Articles on This Page'|trans,
                        'empty_action_label': 'Back to First Page'|trans,
                        'empty_action_url': 'support/kb'|url(query: {'q': query})
                    }, with_context: false) }}
                {% else %}
                    {{ include('partial_client_empty.html.twig', {
                        'empty_title': 'No Matching Articles'|trans,
                        'empty_description': 'Try fewer or different keywords, or clear your search to browse categories.'|trans
                    }, with_context: false) }}
                {% endif %}
            {% else %}
                {% set categories = guest.support_kb_category_get_list({'per_page': 12, 'page': request.page|default(1)}) %}
                <h2 class="card-title mb-3" id="kb-results-heading">{{ 'Browse by Category'|trans }}</h2>
                <div class="row g-4">
                    {% for category in categories.list %}
                        <div class="col-md-6 client-kb-category">
                            <h3 class="h3 mb-2"><a class="client-content-link" href="{{ "support/kb/#{category.slug}"|url }}">{{ category.title }}</a></h3>
                            {% if category.description %}<p class="text-secondary mb-2">{{ category.description }}</p>{% endif %}
                            <p class="small text-secondary mb-0">{{ category.articles|length == 1 ? '1 article'|trans : '%count% articles'|trans({'%count%': category.articles|length}) }}</p>
                        </div>
                    {% else %}
                        <div class="col-12">
                            {% if categories.total|default(0) > 0 %}
                                {{ include('partial_client_empty.html.twig', {
                                    'empty_title': 'No Categories on This Page'|trans,
                                    'empty_action_label': 'Back to First Page'|trans,
                                    'empty_action_url': 'support/kb'|url
                                }, with_context: false) }}
                            {% else %}
                                {{ include('partial_client_empty.html.twig', {
                                    'empty_title': 'No Help Articles Yet'|trans,
                                    'empty_description': 'You can contact support for help with your account or services.'|trans
                                }, with_context: false) }}
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                {% if categories.list %}<div class="mt-4">{{ include('partial_pagination.html.twig', {'list': categories, 'url': 'support/kb'}) }}</div>{% endif %}
            {% endif %}
        </div>
    </section>
    {{ include('partial_support_kb_help.html.twig') }}
{% endblock %}
