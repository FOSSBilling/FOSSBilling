{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'kb' %}

{% block meta_title %}{{ category.title }}{% endblock %}
{% block meta_description %}{{ category.description|default('Browse support articles in this knowledge base category.'|trans) }}{% endblock %}
{% block body_class %}kb-category{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ 'support/kb'|url }}">{{ 'Knowledge Base'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ category.title }}</li>
{% endblock %}

{% block content %}
    {% set articles = guest.support_kb_article_get_list({'kb_article_category_id': category.id, 'per_page': 10, 'page': request.page|default(1)}) %}
    <a class="d-inline-flex align-items-center client-content-link mb-3" href="{{ 'support/kb'|url }}">{{ 'All Categories'|trans }}</a>
    <h1 class="mb-2">{{ category.title }}</h1>
    {% if category.description %}<p class="text-secondary mb-4">{{ category.description }}</p>{% endif %}
    <div class="card mb-4"><div class="card-body">{{ include('partial_support_kb_search.html.twig') }}</div></div>
    <section class="card mb-4" aria-label="{{ 'Help Articles'|trans }}">
        <div class="card-body">
            {% if articles.list %}
                {{ include('partial_support_kb_articles.html.twig', {'articles': articles, 'pagination_url': "support/kb/#{category.slug}"}) }}
            {% elseif articles.total|default(0) > 0 %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'No Articles on This Page'|trans,
                    'empty_action_label': 'Back to First Page'|trans,
                    'empty_action_url': "support/kb/#{category.slug}"|url
                }, with_context: false) }}
            {% else %}
                {{ include('partial_client_empty.html.twig', {
                    'empty_title': 'No Articles in This Category Yet'|trans
                }, with_context: false) }}
            {% endif %}
        </div>
    </section>
    {{ include('partial_support_kb_help.html.twig') }}
{% endblock %}
