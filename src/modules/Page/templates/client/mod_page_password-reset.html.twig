{% extends "layout_auth.html.twig" %}
{% import "macro_functions.html.twig" as mf %}
{% block meta_title %}{{ 'Reset Password'|trans }}{% endblock %}
{% block meta_description %}{{ 'Request a password reset link to regain access to your client account securely.'|trans }}{% endblock %}
{% block body_class %}page-password-reset{% endblock %}

{% block auth_content %}
    <h1 class="h3 mb-2">{{ 'Reset Password'|trans }}</h1>
    {% if request.expired|default(false) %}
        <p class="alert alert-warning" role="alert">{{ 'This reset link has expired or has already been used. Request a new link below.'|trans }}</p>
    {% endif %}
    <p class="text-secondary mb-4">{{ 'Enter the email address you use to sign in. We will send instructions to choose a new password if an account matches.'|trans }}</p>
    <div class="alert alert-success" id="reset-request-status" role="status" tabindex="-1" hidden>
        <h2 class="h3">{{ 'Check Your Email'|trans }}</h2>
        <p class="mb-0">{{ 'If an account matches that address, a reset link will be sent. Check your spam folder too. If it does not arrive, check the address and try again.'|trans }}</p>
    </div>
    <form action="{{ 'client/reset_password'|api_url(role: 'guest') }}" class="auth" {{ fb_api_form({callback: 'onClientResetRequested'}) }}>
        <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
        <div class="mb-3">
            <label class="form-label" for="email">{{ 'Email Address'|trans }}</label>
            <input class="form-control" id="email" type="email" name="email" value="{{ request.email|default('') }}" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
        </div>
        {{ mf.recaptcha }}
        <button type="submit" class="btn btn-primary w-100">{{ 'Send Reset Link'|trans }}</button>
    </form>
    <a class="d-inline-block mt-4" href="{{ 'login'|url }}">{{ 'Back to Sign In'|trans }}</a>
{% endblock %}
{% block js %}
<script>
    function onClientResetRequested() {
        const status = document.getElementById('reset-request-status');
        status.hidden = false;
        status.focus();
    }
</script>
{% endblock %}
