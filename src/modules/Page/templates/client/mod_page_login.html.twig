{% extends "layout_auth.html.twig" %}
{% block meta_title %}{{ 'Sign In'|trans }}{% endblock %}
{% block meta_description %}{{ 'Log in to manage your services, invoices, support tickets, and account details.'|trans }}{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block auth_content %}
    <h1 class="h3 mb-2">{{ 'Sign In'|trans }}</h1>
    <p class="text-secondary mb-4">{{ 'Access your services, invoices and support tickets.'|trans }}</p>
    {{ render_widgets('client.page.login.form.before') }}
    <form action="{{ 'client/login'|api_url(role: 'guest') }}" class="auth" data-auth-passwords {{ fb_api_form({redirect: redirect_uri|default('/')|url}) }}>
        <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
        <div class="mb-3">
            <label class="form-label" for="email">{{ 'Email Address'|trans }}</label>
            <input class="form-control" id="email" type="email" name="email" value="{{ request.email|default('') }}" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">{{ 'Password'|trans }}</label>
            <input class="form-control" id="password" type="password" name="password" autocomplete="current-password" data-auth-password required>
        </div>
        <div class="d-flex justify-content-between flex-wrap gap-2 mb-4">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="show-password" data-auth-show-passwords>
                <label class="form-check-label" for="show-password">{{ 'Show Password'|trans }}</label>
            </div>
            {% if settings.show_password_reset_link %}<a href="{{ 'password-reset'|url }}">{{ 'Forgot your password?'|trans }}</a>{% endif %}
        </div>
        <button type="submit" class="btn btn-primary w-100">{{ 'Sign In'|trans }}</button>
    </form>
    {{ render_widgets('client.page.login.form.after') }}
    {% if settings.show_signup_link %}<p class="mt-4 mb-0">{{ 'New here?'|trans }} <a href="{{ 'signup'|url }}">{{ 'Create an Account'|trans }}</a></p>{% endif %}
{% endblock %}
