{% block subject %}[{{ guest.system_company.name }}] {{ 'Automatic payment failed: invoice #%number%'|trans({'%number%': invoice.serie_nr|default('')}) }}{% endblock %}

{% block content %}
<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<style type="text/css">
		body {
			font-family: Arial, sans-serif;
			font-size: 14px;
			color: #333333;
		}

		h1 {
			font-size: 24px;
			font-weight: bold;
			margin: 0 0 20px;
		}

		p {
			margin: 0 0 10px;
		}

		strong {
			font-weight: bold;
		}

		.signature {
			font-style: italic;
			color: #999999;
			margin-top: 20px;
			border-top: 1px solid #cccccc;
			padding-top: 10px;
		}
	</style>
</head>
<body>
	<h1>{{ 'Automatic payment failed'|trans }}</h1>
	<p>{{ 'Hello %first_name% %last_name%,'|trans({'%first_name%': c.first_name|default(''), '%last_name%': c.last_name|default('')}) }}</p>
	<p>{{ 'We could not charge your saved payment method %card% for invoice #%number%. %reason%'|trans({'%card%': card|default(''), '%number%': invoice.serie_nr|default(''), '%reason%': reason|default('')}) }}</p>
	{% if retry_at|default('') %}
	<p>{{ 'We will try it again on %date%.'|trans({'%date%': retry_at|format_date}) }}</p>
	{% endif %}
	<p>{{ 'You can pay the invoice now, or change your payment method on the Payment methods page.'|trans }}</p>
    <ul>
        <li><strong>{{ 'Amount Due:'|trans }}</strong> {{ (invoice.balance_due ?? invoice.total)|default(0)|format_currency(invoice.currency|default(default_currency)) }}</li>
        <li><strong>{{ 'Due Date:'|trans }}</strong>  {{ invoice.due_at|default('')|format_date }}</li>
    </ul>

    <p>{{ 'You may view and pay the invoice'|trans }} <a href='{{ "invoice/#{invoice.hash|default('')}"|url(area: 'client') }}' target="_blank">{{ 'here.'|trans }}</a></p>
    <p>{{ 'You can also manage your saved payment methods on the'|trans }} <a href="{{ 'payment-methods'|url(area: 'client') }}" target="_blank">{{ 'Payment methods'|trans }}</a> {{ 'page.'|trans }}</p>

	<p class="signature">{{ guest.system_email.signature }}</p>
</body>
</html>
{% endblock %}
