{% extends 'layout_default.html.twig' %}

{% import 'macro_functions.html.twig' as mf %}

{% block meta_title %}{{ 'Failed Invoice Items'|trans }}{% endblock %}

{% set active_menu = 'invoice' %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ 'Failed Invoice Items'|trans }}</h3>
                <p class="card-subtitle">{{ 'Invoice items whose task permanently failed after repeated attempts. Re-queue an item to retry it on the next cron run.'|trans }}</p>
            </div>
        </div>
        <div class="card-body pt-3 pb-0 px-0">
            <div class="table-responsive">
                <table class="table card-table table-vcenter table-striped text-nowrap">
                    <thead>
                        <tr>
                            <th>{{ 'ID'|trans }}</th>
                            <th>{{ 'Invoice'|trans }}</th>
                            <th>{{ 'Title'|trans }}</th>
                            <th>{{ 'Type'|trans }}</th>
                            <th>{{ 'Task'|trans }}</th>
                            <th>{{ 'Attempts'|trans }}</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in admin.invoice_get_failed_items() %}
                        <tr>
                            <td>{{ item.id }}</td>
                            <td>
                                <a href='{{ "invoice/manage/#{item.invoice_id}"|url }}'>#{{ item.invoice_id }}</a>
                            </td>
                            <td>{{ item.title }}</td>
                            <td>{{ item.type }}</td>
                            <td>{{ item.task }}</td>
                            <td>{{ item.attempts }}</td>
                            <td>
                                <a class="btn btn-icon" href="{{ 'invoice/item_requeue'|api_url(query: { 'id': item.id }) }}"
                                    title="{{ 'Re-queue'|trans }}"
                                    {{ fb_api_link({message: 'Re-queued'|trans, reload: true}) }}>
                                    <svg class="icon">
                                        <use href="#refresh" />
                                    </svg>
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td class="text-muted" colspan="7">{{ 'There are no failed invoice items.'|trans }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
