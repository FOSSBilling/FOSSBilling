{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'invoices' %}

{% block meta_title %}{{ 'Invoices'|trans }}{% endblock %}
{% block page_header %}{{ 'Invoices'|trans }}{% endblock %}
{% block body_class %}invoice-index{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Invoices'|trans }}</li>
{% endblock %}

{% block content %}
    {% set statuses = {
        'unpaid': {'label': 'To Pay'|trans, 'empty': 'No Unpaid Invoices'|trans},
        'paid': {'label': 'Paid'|trans, 'empty': 'No Paid Invoices Yet'|trans},
        'refunded': {'label': 'Refunded'|trans, 'empty': 'No Refunded Invoices'|trans},
        'canceled': {'label': 'Canceled'|trans, 'empty': 'No Canceled Invoices'|trans}
    } %}
    {% set lists = {} %}
    {% for status, section in statuses %}
        {% set page_param = status == 'unpaid' ? 'page' : status ~ '_page' %}
        {% set lists = lists|merge({(status): client.invoice_get_list({
            'status': status, 'per_page': 10, 'page': attribute(request, page_param)|default(1),
            'sort': status == 'unpaid' ? 'due_at' : 'id', 'direction': status == 'unpaid' ? 'ASC' : 'DESC'
        })}) %}
    {% endfor %}
    {{ include('partial_page_heading.html.twig', {title: 'Invoices'|trans, heading_class: 'mb-4'}) }}
    <div class="card mb-4">
        <div class="card-header">
            <nav class="flex-fill" aria-label="{{ 'Invoice Status'|trans }}">
                <div class="nav nav-tabs card-header-tabs" role="tablist">
                    {% for status, section in statuses %}
                        <button class="nav-link{{ loop.first ? ' active' : '' }}" id="{{ status }}-tab"
                                data-bs-toggle="tab" data-bs-target="#nav-{{ status }}" type="button" role="tab"
                                aria-controls="nav-{{ status }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">
                            {{ section.label }}
                            {% if status == 'unpaid' and lists.unpaid.total %}
                                <span class="badge text-bg-danger ms-1">{{ lists.unpaid.total }}</span>
                            {% endif %}
                        </button>
                    {% endfor %}
                </div>
            </nav>
        </div>
        <div class="card-body tab-content">
            {% for status, section in statuses %}
                {% set invoices = lists[status] %}
                <div class="tab-pane fade{{ loop.first ? ' show active' : '' }}" id="nav-{{ status }}"
                     role="tabpanel" aria-labelledby="{{ status }}-tab" tabindex="0">
                    {% if invoices.total %}
                        {% if status == 'unpaid' %}
                            <p class="mb-4">{{ invoices.total == 1 ? '1 invoice awaiting payment'|trans : '%count% invoices awaiting payment'|trans({'%count%': invoices.total}) }}</p>
                        {% endif %}
                        <div class="table-responsive">
                            <table class="table table-vcenter table-hover client-invoice-list mb-0" aria-label="{{ 'Invoices'|trans ~ ': ' ~ section.label }}">
                                <thead>
                                    <tr>
                                        <th scope="col">{{ 'Invoice'|trans }}</th>
                                        <th scope="col">{{ status == 'paid' ? 'Paid On'|trans : (status == 'unpaid' ? 'Due Date'|trans : 'Invoice Date'|trans) }}</th>
                                        <th scope="col" class="text-end">{{ status == 'unpaid' ? 'Amount Due'|trans : 'Total'|trans }}</th>
                                        <th scope="col"><span class="visually-hidden">{{ 'Actions'|trans }}</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for invoice in invoices.list %}
                                        {% set invoice_url = "invoice/#{invoice.hash}"|url %}
                                        {% set label = invoice.credit_note_for_invoice_id ? 'Credit Note'|trans : (invoice.debit_note_for_invoice_id ? 'Debit Note'|trans : 'Invoice'|trans) %}
                                        <tr>
                                            <td class="invoice-reference">
                                                <a href="{{ invoice_url }}" class="fw-semibold">{{ label }} #{{ invoice.serie_nr }}</a>
                                                {% if invoice.lines|first %}
                                                    <div class="small text-secondary">{{ (invoice.lines|first).title }}</div>
                                                {% endif %}
                                            </td>
                                            <td class="invoice-date">
                                                <span class="d-block d-md-none small text-secondary" aria-hidden="true">{{ status == 'paid' ? 'Paid On'|trans : (status == 'unpaid' ? 'Due Date'|trans : 'Invoice Date'|trans) }}</span>
                                                {% if status == 'unpaid' %}
                                                    {% if invoice.due_at %}
                                                        <span>{{ invoice.due_at|format_date }}</span>
                                                        {% if invoice.due_at|date('Y-m-d') < 'now'|date('Y-m-d') %}
                                                            <span class="d-block small text-danger-emphasis fw-semibold">{{ 'Overdue'|trans }}</span>
                                                        {% elseif invoice.due_at|date('Y-m-d') == 'now'|date('Y-m-d') %}
                                                            <span class="d-block small fw-semibold">{{ 'Due Today'|trans }}</span>
                                                        {% endif %}
                                                    {% else %}
                                                        <span class="text-secondary">{{ 'No Due Date'|trans }}</span>
                                                    {% endif %}
                                                {% else %}
                                                    {{ (status == 'paid' ? invoice.paid_at : invoice.created_at)|format_date }}
                                                {% endif %}
                                            </td>
                                            <td class="invoice-amount text-end fw-semibold">
                                                <span class="d-block d-md-none small text-secondary fw-normal" aria-hidden="true">{{ status == 'unpaid' ? 'Amount Due'|trans : 'Total'|trans }}</span>
                                                {{ invoice.total|format_currency(invoice.currency ?? default_currency) }}
                                            </td>
                                            <td class="invoice-action text-end">
                                                <a class="btn btn-sm {{ status == 'unpaid' ? 'btn-primary' : 'btn-outline-secondary' }}"
                                                   href="{{ invoice_url }}" aria-label="{{ status == 'unpaid' ? 'Pay Invoice #%number%'|trans({'%number%': invoice.serie_nr}) : 'View Invoice #%number%'|trans({'%number%': invoice.serie_nr}) }}">
                                                    {{ status == 'unpaid' ? 'Pay Invoice'|trans : 'View'|trans }}
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3">
                            {{ include('partial_pagination.html.twig', {
                                'list': invoices, 'url': 'invoice', 'hash': '#nav-' ~ status,
                                'page_param': status == 'unpaid' ? 'page' : status ~ '_page'
                            }) }}
                        </div>
                    {% else %}
                        {{ include('partial_client_empty.html.twig', {
                            'empty_title': section.empty,
                            'empty_description': status == 'unpaid' ? 'There is nothing to pay right now. Your payment history is available under Paid.'|trans : ''
                        }, with_context: false) }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
