{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'invoices' %}

{% import "macro_functions.html.twig" as mf %}

{% set nr = invoice.serie_nr %}
{% if invoice.credit_note_for_invoice_id %}
    {% set doc_label = 'Credit Note'|trans %}
{% elseif invoice.debit_note_for_invoice_id %}
    {% set doc_label = 'Debit Note'|trans %}
{% else %}
    {% set doc_label = 'Invoice'|trans %}
{% endif %}
{% if invoice.status == 'canceled' %}
    {% set doc_label = 'Canceled Invoice'|trans %}
{% endif %}
{% if not invoice.issued %}
    {% set doc_label = 'Draft Invoice'|trans %}
    {% set nr = invoice.id %}
{% endif %}

{% block meta_title %}{{ doc_label }} #{{ nr }}{% endblock %}

{% block body_class %}invoice-invoice{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ 'invoice'|url }}">{{ 'Invoices'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">#{{ nr }}</li>
{% endblock %}

{% set invoice_currency = invoice.currency ?? default_currency %}
{% set payable = invoice.issued and invoice.status == 'unpaid' and invoice.total > 0 and not invoice.credit_note_for_invoice_id|default(null) and not invoice.replaced_by_invoice_id|default(null) %}

{% block content %}
{% set seller = invoice.seller %}
{% set buyer = invoice.buyer %}
    {% embed 'partial_card_heading.html.twig' with {heading_class: 'mb-4', heading_actions_class: 'client-action-group', heading_content_class: 'client-invoice-heading'} %}
        {% block card_heading_content %}
            {% import 'macro_functions.html.twig' as mf %}
            <h1 class="h3 mb-2">{{ doc_label }} #{{ nr }}</h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                {% if not invoice.issued %}<span class="badge text-bg-secondary">{{ 'Draft'|trans }}</span>{% elseif invoice.status == 'canceled' %}{{ mf.status_badge(invoice.status, 'invoice') }}{% elseif invoice.replaced_by_invoice_id|default(null) %}<span class="badge text-bg-secondary">{{ 'Replaced'|trans }}</span>{% elseif invoice.credit_note_for_invoice_id|default(null) %}<span class="badge text-bg-secondary">{{ 'Credit Note Issued'|trans }}</span>{% else %}{{ mf.status_badge(invoice.status, 'invoice') }}{% endif %}
                {% if payable and invoice.due_at %}
                    <span>{{ 'Due'|trans }} {{ invoice.due_at|format_date }}</span>
                    {% if invoice.due_at|date('Y-m-d') < 'now'|date('Y-m-d') %}<span class="text-danger-emphasis fw-semibold">{{ 'Overdue'|trans }}</span>{% elseif invoice.due_at|date('Y-m-d') == 'now'|date('Y-m-d') %}<span class="fw-semibold">{{ 'Due Today'|trans }}</span>{% endif %}
                {% endif %}
            </div>
        {% endblock %}
        {% block card_heading_actions %}
            {% if client %}<a href="{{ 'invoice'|url }}" class="btn btn-outline-secondary">{{ 'Back to Invoices'|trans }}</a>{% endif %}
            <a href="{{ ('invoice/pdf/' ~ invoice.hash)|url }}" target="_blank" rel="noopener" class="btn btn-outline-secondary">{{ 'Download PDF'|trans }}</a>
            <a href="{{ ('invoice/print/' ~ invoice.hash)|url }}" target="_blank" rel="noopener" class="btn btn-outline-secondary">{{ 'Print'|trans }}</a>

        {% endblock %}
    {% endembed %}

    <section class="mb-4" aria-label="{{ 'Payment Status'|trans }}">
        <div class="small text-secondary">{{ payable ? 'Amount Due'|trans : (invoice.credit_note_for_invoice_id|default(null) ? 'Credit Note Total'|trans : 'Invoice Total'|trans) }} ({{ invoice_currency }})</div>
        <p class="h3 mb-2">{{ invoice.total|format_currency(invoice_currency) }}</p>
        {% if not invoice.issued %}
            <p>{{ 'This is a draft. Payment is not available until the invoice is issued.'|trans }}</p>
        {% elseif invoice.credit_note_for_invoice_id|default(null) %}
            <p>{{ 'This credit note records an adjustment to an earlier invoice. No payment is required.'|trans }}</p>
        {% elseif invoice.status == 'canceled' or invoice.replaced_by_invoice_id|default(null) %}
            <p>{{ 'This invoice was canceled and can no longer be paid.'|trans }}{% if invoice.replaced_by_invoice_id|default(null) %} {{ 'A replacement invoice has been issued. You can find it in your invoices list.'|trans }}{% endif %}</p>
        {% elseif invoice.status == 'paid' %}
            <p>{{ 'This invoice has been paid. There is nothing to pay.'|trans }}{% if invoice.paid_at %} {{ 'Paid On'|trans }} {{ invoice.paid_at|format_date }}.{% endif %}</p>
        {% elseif invoice.status == 'refunded' %}
            <p>{{ 'This invoice has been refunded. There is nothing to pay.'|trans }}</p>
        {% elseif not payable %}
            <p>{{ 'No payment is due for this invoice.'|trans }}</p>
        {% endif %}
        {% if invoice.refunded_total|default(0) > 0 %}<p>{{ 'Refunded Amount'|trans }}: {{ invoice.refunded_total|format_currency(invoice_currency) }}</p>{% endif %}
        {% if payable and request.status|default('') in ['ok', 'cancel'] %}
            <p role="status">{{ request.status == 'cancel' ? 'Payment is not confirmed. If you canceled at the payment provider, choose a payment method below when you are ready.'|trans : 'Payment is not confirmed yet. If you just paid, check the status again before making another payment.'|trans }} <a href="{{ ('invoice/thank-you/' ~ invoice.hash)|url }}">{{ 'Check Payment Status'|trans }}</a></p>
        {% endif %}
        {% if payable %}<a href="#invoice-payment-heading" class="btn btn-primary d-lg-none">{{ 'Pay Invoice'|trans }}</a>{% endif %}
    </section>

    <div class="row gy-4 mb-4">
        <div class="{{ payable ? 'col-lg-8' : 'col-12' }}">
            <section class="card" aria-labelledby="invoice-charges-heading">
                <div class="card-body">
                    <h2 class="h3 mb-3" id="invoice-charges-heading">{{ 'Charges'|trans }}</h2>
                    {% if invoice.text_1 %}<div class="mb-3">{{ invoice.text_1|markdown_to_html }}</div>{% endif %}
                    <div class="table-responsive">
                        <table class="table invoice-lines align-middle" aria-labelledby="invoice-charges-heading">
                            <thead><tr><th scope="col">{{ 'Description'|trans }}</th><th scope="col">{{ 'Quantity'|trans }}</th><th scope="col" class="text-end">{{ 'Unit Price'|trans }}</th><th scope="col" class="text-end">{{ 'Amount'|trans }}</th></tr></thead>
                            <tbody>
                            {% for item in invoice.lines %}
                                <tr>
                                    <td>
                                        {% if client and item.order_id %}<a href="{{ ('order/service/manage/' ~ item.order_id)|url }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
                                        {% if item.period|default(null) %}<div class="small text-secondary">{{ item.period|period_title }}</div>{% endif %}
                                        {% if invoice.taxrate|default(0) > 0 %}<div class="small text-secondary">{{ item.taxed|default(false) ? 'Taxable'|trans : 'Not Taxed'|trans }}</div>{% endif %}
                                    </td>
                                    <td data-label="{{ 'Quantity'|trans }}"><span class="invoice-cell-label" aria-hidden="true">{{ 'Quantity'|trans }}</span>{{ item.quantity }}{% if item.quantity > 1 and item.unit %} {{ item.unit }}{% endif %}</td>
                                    <td data-label="{{ 'Unit Price'|trans }}" class="text-end"><span class="invoice-cell-label" aria-hidden="true">{{ 'Unit Price'|trans }}</span>{{ item.price|format_currency(invoice_currency) }}</td>
                                    <td data-label="{{ 'Amount'|trans }}" class="text-end fw-semibold"><span class="invoice-cell-label" aria-hidden="true">{{ 'Amount'|trans }}</span>{{ item.total|format_currency(invoice_currency) }}</td>
                                </tr>
                            {% else %}<tr><td colspan="4">{{ 'No charges have been added.'|trans }}</td></tr>{% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="row justify-content-end">
                        <div class="col-sm-8 col-xl-6">
                            <table class="table invoice-totals mb-0">
                                <caption class="visually-hidden">{{ 'Invoice Totals'|trans }} ({{ invoice_currency }})</caption>
                                <tbody>
                                    <tr><th scope="row" class="fw-normal">{{ 'Subtotal'|trans }}</th><td class="text-end">{{ invoice.subtotal|default(invoice.total - invoice.tax|default(0))|format_currency(invoice_currency) }}</td></tr>
                                    {% if invoice.discount|default(0) > 0 %}<tr><th scope="row" class="fw-normal">{{ 'Discount Included'|trans }}</th><td class="text-end">{{ invoice.discount|format_currency(invoice_currency) }}</td></tr>{% endif %}
                                    {% if invoice.tax|default(0) != 0 %}<tr><th scope="row" class="fw-normal">{{ invoice.taxname }} ({{ invoice.taxrate }}%)</th><td class="text-end">{{ invoice.tax|format_currency(invoice_currency) }}</td></tr>{% endif %}
                                    <tr><th scope="row">{{ 'Total'|trans }} ({{ invoice_currency }})</th><td class="text-end fw-semibold">{{ invoice.total|format_currency(invoice_currency) }}</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {% if invoice.text_2 %}<div class="mt-3">{{ invoice.text_2|markdown_to_html }}</div>{% endif %}
                </div>
            </section>
        </div>
        {% if payable %}
        <div class="col-lg-4">
            <section class="card" aria-labelledby="invoice-payment-heading">
                <div class="card-body">
                    <h2 class="h3" id="invoice-payment-heading" tabindex="-1">{{ 'Choose a Payment Method'|trans }}</h2>
                    <p>{{ 'Review the payment type and amount before continuing.'|trans }}</p>
                    {% set deposit_invoice = invoice.lines|filter(line => line.type|default('') == 'deposit')|length > 0 %}
                    {% set available_gateways = guest.invoice_gateways|filter(gtw => invoice_currency in gtw.accepted_currencies and (gtw.allow_single or (invoice.subscribable and gtw.allow_recurrent)) and (gtw.code|default('') != 'ClientBalance' or (client and not deposit_invoice and profile.id|default(null) == invoice.client_id|default(-1) and profile.currency|default('') == invoice_currency))) %}
                    {% if available_gateways %}
                        {% set payment_available = false %}
                        <div class="d-flex flex-column gap-2">
                        {% for gtw in available_gateways %}
                            {% set balance_gateway = gtw.code|default('') == 'ClientBalance' %}
                            {% set available_balance = balance_gateway ? (profile.balance ?? client.client_balance_get_total) : 0 %}
                            {% set insufficient_balance = balance_gateway and available_balance|round(2) < invoice.total|round(2) %}
                            {% if not insufficient_balance %}{% set payment_available = true %}{% endif %}
                            {% set gateway_title = balance_gateway and gtw.title in ['ClientBalance', 'Client Balance'] ? 'Account Balance'|trans : gtw.title %}
                            <button type="button" class="btn btn-outline-primary d-flex align-items-center justify-content-start gap-2 invoice-payment-method"
                                    data-gateway-id="{{ gtw.id }}" data-gateway-title="{{ gateway_title }}"
                                    data-single="{{ gtw.allow_single ? 'true' : 'false' }}" data-recurrent="{{ gtw.allow_recurrent ? 'true' : 'false' }}"{% if insufficient_balance %} disabled aria-describedby="invoice-balance-help"{% endif %}>
                                {% if gtw.logo.logo|default(null) %}<picture>{% if gtw.logo.avif|default(null) %}<source srcset="{{ gtw.logo.avif }}" type="image/avif">{% endif %}<img class="fb-image-contain" src="{{ gtw.logo.logo }}" alt="" width="40" height="28"></picture>{% endif %}
                                <span>{{ gateway_title }}</span>
                            </button>
                            {% if balance_gateway %}<p class="small text-secondary mb-1" id="invoice-balance-help">{{ 'Available Balance'|trans }}: {{ available_balance|format_currency(invoice_currency) }}.{% if insufficient_balance %} {{ 'Your balance does not cover this invoice.'|trans }}{% endif %}</p>{% endif %}
                        {% endfor %}
                        </div>
                        {% if not payment_available %}<p class="mt-3 mb-0">{% if guest.invoice_funds_enabled|default(false) %}<a href="{{ 'client/balance'|url }}">{{ 'Add Funds to Your Wallet'|trans }}</a>{% else %}<a href="{{ 'support'|url }}">{{ 'Contact Support to Arrange Payment'|trans }}</a>{% endif %}</p>{% endif %}
                    {% else %}
                        <p class="mb-0" role="status">{{ 'No payment methods are currently available for this invoice. Please contact support to arrange payment.'|trans }} {% if client %}<a href="{{ 'support'|url }}">{{ 'Contact Support'|trans }}</a>{% endif %}</p>
                    {% endif %}
                </div>
            </section>
        </div>
        {% endif %}
    </div>

    <section class="mb-4" aria-labelledby="invoice-details-heading">
        <h2 class="h3 mb-3" id="invoice-details-heading">{{ 'Billing Details'|trans }}</h2>
        <dl class="row gy-2 mb-4">
            <div class="col-12 col-sm-4"><dt class="small text-secondary fw-normal">{{ 'Invoice Date'|trans }}</dt><dd>{{ invoice.created_at|format_date }}</dd></div>
            <div class="col-12 col-sm-4"><dt class="small text-secondary fw-normal">{{ 'Due Date'|trans }}</dt><dd>{{ invoice.due_at ? invoice.due_at|format_date : 'Not Specified'|trans }}</dd></div>
            {% if invoice.paid_at %}<div class="col-12 col-sm-4"><dt class="small text-secondary fw-normal">{{ 'Payment Date'|trans }}</dt><dd>{{ invoice.paid_at|format_date }}</dd></div>{% endif %}
        </dl>
        <div class="row gy-4">
            <div class="col-md-6">
                <h3 class="h4">{{ 'From'|trans }}</h3>
                <dl class="row small">
                    {% for key, label in {company: 'Company'|trans, company_number: 'Company Number'|trans, company_vat: 'VAT Number'|trans, address: 'Address'|trans, phone: 'Phone'|trans, email: 'Email'|trans, account_number: 'Account'|trans, note: 'Note'|trans} %}
                        {% if seller[key]|default('')|trim %}<dt class="col-sm-4 text-secondary">{{ label }}</dt><dd class="col-sm-8">{{ seller[key] }}</dd>{% endif %}
                    {% endfor %}
                </dl>
            </div>
            <div class="col-md-6">
                <h3 class="h4">{{ 'Billed To'|trans }}</h3>
                <dl class="row small">
                    {% if buyer.first_name|default('')|trim or buyer.last_name|default('')|trim %}<dt class="col-sm-4 text-secondary">{{ 'Name'|trans }}</dt><dd class="col-sm-8">{{ buyer.first_name }} {{ buyer.last_name }}</dd>{% endif %}
                    {% for key, label in {company: 'Company'|trans, company_number: 'Company Number'|trans, company_vat: 'VAT Number'|trans, phone: 'Phone'|trans} %}
                        {% if buyer[key]|default('')|trim %}<dt class="col-sm-4 text-secondary">{{ label }}</dt><dd class="col-sm-8">{{ buyer[key] }}</dd>{% endif %}
                    {% endfor %}
                    {% if buyer.address|default('')|trim %}<dt class="col-sm-4 text-secondary">{{ 'Address'|trans }}</dt><dd class="col-sm-8">{{ buyer.address }}<br>{{ buyer.city }} {{ buyer.state }}<br>{{ buyer.zip }} {{ buyer.country|country_name }}</dd>{% endif %}
                </dl>
            </div>
        </div>
        {% if invoice.credit_note_for_invoice_id|default(null) or invoice.debit_note_for_invoice_id|default(null) %}<p>{{ 'Refers to Invoice'|trans }} #{{ invoice.related_invoices[invoice.credit_note_for_invoice_id ?? invoice.debit_note_for_invoice_id]|default(invoice.credit_note_for_invoice_id ?? invoice.debit_note_for_invoice_id) }}</p>{% endif %}
        {% if invoice.refunded_by_invoice_ids|default([]) %}<p>{{ 'Credited By'|trans }} {% for ref_id in invoice.refunded_by_invoice_ids %}#{{ invoice.related_invoices[ref_id]|default(ref_id) }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
        {% if invoice.debited_by_invoice_ids|default([]) %}<p>{{ 'Debited By'|trans }} {% for ref_id in invoice.debited_by_invoice_ids %}#{{ invoice.related_invoices[ref_id]|default(ref_id) }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
    </section>

    {% if payable %}
    <div class="modal fade" id="paymentPrompt" tabindex="-1" aria-labelledby="paymentPromptLabel" aria-describedby="paymentPromptAmount bodyText" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
            <div class="modal-header"><h2 class="modal-title h3" id="paymentPromptLabel">{{ 'Confirm Payment'|trans }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button></div>
            <div class="modal-body">
                <p id="paymentPromptAmount">{{ doc_label }} #{{ nr }} · <strong>{{ invoice.total|format_currency(invoice_currency) }} ({{ invoice_currency }})</strong></p>
                <p id="bodyText"></p>
                <div class="d-flex flex-column gap-2">
                    <a href="#" class="btn btn-primary" id="single" hidden>{{ 'Make a One-Time Payment'|trans }}</a>
                    <a href="#" class="btn btn-primary" id="subscription" hidden>{{ 'Pay and Set Up Recurring Payments'|trans }}</a>
                    <a href="#" class="btn btn-primary" id="pay-nondescript" hidden>{{ 'Continue to Payment'|trans }}</a>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'Choose Another Method'|trans }}</button></div>
        </div></div>
    </div>
    {% endif %}
{% endblock %}

{% block js %}
{% if payable %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.invoice-payment-method').forEach(button => {
            button.addEventListener('click', () => paymentPrompt(button.dataset.gatewayId, button.dataset.recurrent === 'true', button.dataset.single === 'true', button.dataset.gatewayTitle, button));
        });
    });

    function paymentPrompt(id, supportsSubscription, supportsOneTime, title, trigger = null) {
        const paymentLink = new URL({{ 'invoice/banklink'|url|json_encode|raw }} + '/' + {{ invoice.hash|json_encode|raw }} + '/' + encodeURIComponent(id), window.location.origin);
        const subscribable = {{ invoice.subscribable ? 'true' : 'false' }};
        const single = document.getElementById('single');
        const subscription = document.getElementById('subscription');
        const generic = document.getElementById('pay-nondescript');
        const body = document.getElementById('bodyText');
        single.hidden = true;
        subscription.hidden = true;
        generic.hidden = true;
        {% if settings.prompt_subscription|default(false) %}
            subscription.hidden = !(supportsSubscription && subscribable);
            single.hidden = !supportsOneTime;
            body.textContent = subscription.hidden
                ? {{ 'Continue with a one-time payment for this invoice.'|trans|json_encode|raw }}
                : {{ 'Recurring payments may cover future invoices automatically. Choose a one-time payment if you only want to pay this invoice.'|trans|json_encode|raw }};
            if (single.hidden && !subscription.hidden) body.textContent = {{ 'This payment method requires recurring payments for this service. Choose another method if you prefer a one-time payment.'|trans|json_encode|raw }};
        {% else %}
            const recurring = supportsSubscription && subscribable;
            generic.hidden = !(recurring || supportsOneTime);
            generic.textContent = recurring ? {{ 'Pay and Set Up Recurring Payments'|trans|json_encode|raw }} : {{ 'Continue to Payment'|trans|json_encode|raw }};
            body.textContent = recurring
                ? {{ 'This payment sets up recurring payments for future invoices as well as paying this invoice.'|trans|json_encode|raw }}
                : {{ 'Continue with a one-time payment for this invoice.'|trans|json_encode|raw }};
        {% endif %}
        if (single.hidden && subscription.hidden && generic.hidden) body.textContent = {{ 'This payment method is not available for this invoice. Choose another method.'|trans|json_encode|raw }};
        document.getElementById('paymentPromptLabel').textContent = {{ 'Pay with'|trans|json_encode|raw }} + ' ' + title;
        subscription.href = paymentLink.href;
        generic.href = paymentLink.href;
        const singleLink = new URL(paymentLink);
        singleLink.searchParams.set('allow_subscription', '0');
        single.href = singleLink.href;
        const modal = document.getElementById('paymentPrompt');
        if (trigger) modal.addEventListener('hidden.bs.modal', () => {
            if (trigger.isConnected) trigger.focus();
        }, {once: true});
        tabler.Modal.getOrCreateInstance(modal).show(trigger);
    }
</script>
{% endif %}
{% endblock %}
