{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'invoices' %}
{% set pending_payment = (invoice.issued ?? true) and invoice.status == 'unpaid' and invoice.total > 0 and not invoice.credit_note_for_invoice_id|default(null) and not invoice.replaced_by_invoice_id|default(null) %}
{% set deposit_invoice = invoice.lines|default([])|filter(line => line.type|default('') == 'deposit')|length > 0 %}

{% block meta_title %}{{ 'Payment Status'|trans }}{% endblock %}
{% block body_class %}invoice-payment{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ ('invoice/' ~ invoice.hash)|url }}">{{ 'Invoice'|trans }} #{{ invoice.serie_nr }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Payment Status'|trans }}</li>
{% endblock %}

{% block content %}
<section class="card">
    <div class="card-body">
        {% if not (invoice.issued ?? true) %}
            <h1 class="h3">{{ 'Invoice Not Issued'|trans }}</h1>
            <p>{{ 'This is a draft invoice. Payment is not available until it is issued.'|trans }}</p>
        {% elseif invoice.status == 'canceled' or invoice.replaced_by_invoice_id|default(null) %}
            <h1 class="h3">{{ 'Invoice Canceled'|trans }}</h1>
            <p>{{ 'This invoice can no longer be paid. Open the invoice for details or contact support.'|trans }}</p>
        {% elseif invoice.credit_note_for_invoice_id|default(null) %}
            <h1 class="h3">{{ 'Credit Note Issued'|trans }}</h1>
            <p>{{ 'This document records an adjustment. No payment is required.'|trans }}</p>
        {% elseif invoice.status == 'refunded' %}
            <h1 class="h3">{{ 'Invoice Refunded'|trans }}</h1>
            <p>{{ 'This invoice is recorded as refunded. Open it to review the refund details and related credit notes.'|trans }}</p>
        {% elseif invoice.status == 'paid' %}
            <h1 class="h3">{{ 'Payment Confirmed'|trans }}</h1>
            <p>{{ deposit_invoice ? 'Your invoice has been paid. Open your wallet to review your available balance.'|trans : 'Your invoice has been paid. You can check your services for activation and setup details.'|trans }}</p>
            {% if invoice.paid_at|default(null) %}<p>{{ 'Paid On'|trans }} {{ invoice.paid_at|format_datetime }}</p>{% endif %}
        {% elseif pending_payment %}
            <h1 class="h3">{{ 'Payment Awaiting Confirmation'|trans }}</h1>
            <p>{{ 'Your invoice has not been marked as paid yet. Payment confirmation can take a little time.'|trans }}</p>
            <p>{{ 'If you already authorized a payment, check the status again before trying to pay a second time. If your payment was declined or canceled, open the invoice to try again or choose another method.'|trans }}</p>
        {% else %}
            <h1 class="h3">{{ 'No Payment Due'|trans }}</h1>
            <p>{{ 'Open your invoice to review the final amount and status.'|trans }}</p>
        {% endif %}
        <p>{{ 'Invoice'|trans }} #{{ invoice.serie_nr }} · <strong>{{ invoice.total|format_currency(invoice.currency) }} ({{ invoice.currency }})</strong></p>
        <div class="d-flex flex-wrap gap-2 client-payment-actions client-action-group">
            {% if client and invoice.status == 'paid' %}<a class="btn btn-primary" href="{{ (deposit_invoice ? 'client/balance' : 'order/service')|url }}">{{ deposit_invoice ? 'View Wallet'|trans : 'View Services'|trans }}</a>{% endif %}
            {% if pending_payment %}<a class="btn btn-primary" href="{{ ('invoice/thank-you/' ~ invoice.hash)|url }}">{{ 'Check Payment Status'|trans }}</a>{% endif %}
            <a class="btn {{ pending_payment or (client and invoice.status == 'paid') ? 'btn-outline-secondary' : 'btn-primary' }}" href="{{ ('invoice/' ~ invoice.hash)|url }}">{{ 'View Invoice'|trans }}</a>
            {% if client and pending_payment %}<a class="btn btn-outline-secondary" href="{{ 'support'|url(query: {ticket: 1}) }}">{{ 'Contact Support'|trans }}</a>{% endif %}
        </div>
    </div>
</section>
{% endblock %}
