{% extends "layout_auth.html.twig" %}
{% block meta_title %}{{ 'Choose a New Password'|trans }}{% endblock %}
{% block body_class %}page-set-password{% endblock %}

{% block auth_content %}
    <h1 class="h3 mb-2">{{ 'Choose a New Password'|trans }}</h1>
    <p class="text-secondary mb-4">{{ 'Set a new password, then sign in to your account.'|trans }}</p>
    <form action="{{ 'client/update_password'|api_url(role: 'guest') }}" class="auth" data-auth-passwords data-password-mismatch="{{ 'The new passwords do not match.'|trans }}" {{ fb_api_form({callback: 'onClientResetPasswordSaved'}) }}>
        <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}">
        <input type="hidden" id="hash" name="hash" value="{{ hash }}">
        <div class="mb-3">
            <label class="form-label" for="password">{{ 'New Password'|trans }}</label>
            <input class="form-control" id="password" type="password" name="password" autocomplete="new-password" minlength="8" aria-describedby="password-help" data-auth-password data-auth-new-password required autofocus>
            {{ include('partial_auth_password_help.html.twig') }}
        </div>
        <div class="mb-3">
            <label class="form-label" for="password2">{{ 'Confirm New Password'|trans }}</label>
            <input class="form-control" id="password2" type="password" name="password_confirm" autocomplete="new-password" data-auth-password data-auth-confirm-password required>
        </div>
        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="show-passwords" data-auth-show-passwords>
            <label class="form-check-label" for="show-passwords">{{ 'Show Passwords'|trans }}</label>
        </div>
        <button type="submit" class="btn btn-primary w-100">{{ 'Save New Password'|trans }}</button>
    </form>
    <div class="d-flex flex-wrap gap-3 mt-4">
        <a href="{{ 'login'|url }}">{{ 'Back to Sign In'|trans }}</a>
        {% if settings.show_password_reset_link %}<a href="{{ 'password-reset'|url }}">{{ 'Request Another Reset Link'|trans }}</a>{% endif %}
    </div>
{% endblock %}
{% block js %}
<script>
    function onClientResetPasswordSaved() {
        flashMessage({message: {{ 'Password changed. Sign in with your new password.'|trans|json_encode|raw }}, reload: {{ 'login'|url|json_encode|raw }}, type: 'success'});
    }
</script>
{% endblock %}
