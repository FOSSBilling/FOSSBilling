{% if order.status == 'active' %}
<div class="card mb-4">
    <div class="card-header">
        <h2 class="h3 mb-0">{{ 'API Key Details'|trans }}</h2>
    </div>
    <div class="card-body">

        <div class="table-responsive"><table class="table table-vcenter table-striped table-sm client-service-properties">
            <tbody>
                <tr>
                    <td>{{ 'API Key'|trans }}</td>
                    <td>
                        <strong>{{ service.api_key }}</strong>
                    </td>
                </tr>
            </tbody>
        </table></div>

        <h3 class="h4">{{ 'Reset API Key'|trans }}</h3><p>{{ 'Resetting replaces this key. Update any integrations that use it to avoid losing access.'|trans }}</p>
        <div class="block">
            <a class="btn btn-outline-danger" {{ fb_api_link({href: 'serviceapikey/reset'|api_url(query: {order_id: order.id}), modal: {type: 'confirm', title: 'Reset API Key'|trans, content: 'This replaces the API key for "%service%". Integrations using the current key will lose access until you update them.'|trans({'%service%': order.title}), button: 'Reset API Key'|trans, buttonColor: 'danger', cancelButton: 'Keep Current Key'|trans}, loading: {button: 'Resetting API Key…'|trans}, reload: true}) }}>{{ 'Reset API Key'|trans }}</a>
        </div>
    </div>
</div>
{% endif %}
