{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'dashboard' %}
{% if client %}
    {% set dashboard = client.index_get_dashboard %}
    {% set profile = dashboard.profile %}
{% endif %}

{% block meta_title %}{{ 'Client Area'|trans }}{% endblock %}
{% block page_header %}{{ 'Dashboard'|trans }}{% endblock %}

{% block body_class %}dashboard{% endblock %}
{% block breadcrumbs %}
    {% if not settings.hide_dashboard_breadcrumb %}
        <nav aria-label="{{ 'Breadcrumb'|trans }}">
            <ol class="breadcrumb">
                <li class="breadcrumb-item active" aria-current="page">{{ 'Dashboard'|trans }}</li>
            </ol>
        </nav>
    {% endif %}
{% endblock %}

{% block content %}
    {{ render_widgets('client.index.dashboard.content.before') }}
    <h1 class="mb-4">{{ 'Dashboard'|trans }}</h1>

    {% if settings.showcase_enabled %}
        {% embed 'partial_notice.html.twig' with {notice_type: 'info'} %}
            {% block notice_content %}
                <div class="mb-2">{{ (settings.showcase_text ?? '')|markdown_to_html }}</div>

                {% if (settings.showcase_button_url) and (settings.showcase_button_title) %}
                    <a class="btn btn-sm btn-primary btn-large"
                       href="{{ settings.showcase_button_url }}">{{ settings.showcase_button_title }}</a>
                {% endif %}
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% if client %}
        {{ render_widgets('client.index.dashboard.client.before', { 'dashboard': dashboard, 'profile': profile }) }}

        <div>
            <div class="row">
                <div class="col-md-6 col-xl-4 d-flex mb-4">
                    <div class="card w-100">
                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title mb-3">{{ 'Invoices'|trans }}</h2>
                            {% if dashboard.invoices.unpaid %}
                                <p>{{ dashboard.invoices.unpaid == 1 ? '1 invoice awaiting payment'|trans : '%count% invoices awaiting payment'|trans({'%count%': dashboard.invoices.unpaid}) }}</p>
                                <a class="btn btn-sm btn-outline-primary align-self-start mt-auto" href="{{ 'invoice'|url }}">{{ 'Review Unpaid Invoices'|trans }}</a>
                            {% else %}
                                <p class="text-secondary">{{ 'No Unpaid Invoices'|trans }}</p>
                                <a class="align-self-start mt-auto" href="{{ 'invoice'|url }}">{{ 'View Invoices'|trans }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4 d-flex mb-4">
                    <div class="card w-100">
                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title mb-3">{{ 'Services'|trans }}</h2>
                            {% if dashboard.orders.needs_review|default(0) %}
                                <p>{{ dashboard.orders.needs_review == 1 ? '1 service to review'|trans : '%count% services to review'|trans({'%count%': dashboard.orders.needs_review}) }}</p>
                                <a class="btn btn-sm btn-outline-primary align-self-start mt-auto" href="{{ 'order/service'|url(query: {'review': 1}) }}">{{ 'Review Services'|trans }}</a>
                            {% else %}
                                <p class="text-secondary">{{ 'No Services Need Review'|trans }}</p>
                                <a class="align-self-start mt-auto" href="{{ 'order/service'|url }}">{{ 'View Services'|trans }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4 d-flex mb-4">
                    <div class="card w-100">
                        <div class="card-body d-flex flex-column">
                            <h2 class="card-title mb-3">{{ 'Tickets'|trans }}</h2>
                            {% if dashboard.tickets.on_hold %}
                                <p>{{ dashboard.tickets.on_hold == 1 ? '1 ticket awaiting your reply'|trans : '%count% tickets awaiting your reply'|trans({'%count%': dashboard.tickets.on_hold}) }}</p>
                                <a class="btn btn-sm btn-outline-primary align-self-start mt-auto" href="{{ 'support'|url(query: {'status': 'on_hold'}) }}">{{ 'Reply to Support'|trans }}</a>
                            {% else %}
                                <p class="text-secondary">{{ 'No Replies Needed'|trans }}</p>
                                <a class="align-self-start mt-auto" href="{{ 'support'|url }}">{{ 'View Tickets'|trans }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

        </div>

        {{ render_widgets('client.index.dashboard.client.after', { 'dashboard': dashboard, 'profile': profile }) }}
    {% else %}
        {{ render_widgets('client.index.dashboard.guest.before') }}

        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header h4 py-3">{{ 'Profile'|trans }}</div>
                    <div class="card-body">
                        <p>{{ 'You are currently logged out'|trans }}</p>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-primary" href="{{ 'login'|url }}">{{ 'Login'|trans }}</a>
                            <a class="btn btn-sm btn-dark" href="{{ 'signup'|url }}">{{ 'Register'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header h4 py-3">{{ 'Order'|trans }}</div>
                    <div class="card-body">
                        <p>{{ 'Order New Products and Services'|trans }}</p>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-dark" href="{{ 'order'|url }}">{{ 'Order'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>

            {% if guest.extension_is_on({"mod":"news"}) %}
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header h4 py-3">{{ 'News'|trans }}</div>
                        <div class="card-body">
                            <p>{{ 'Latest news and announcements'|trans }}</p>
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-dark" href="{{ 'news'|url }}">{{ 'Announcements'|trans }}</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if guest.support_kb_enabled() %}
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header h4 py-3">{{ 'Knowledge Base'|trans }}</div>
                        <div class="card-body">
                            <p>{{ 'Find answers to frequent questions'|trans }}</p>
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-dark" href="{{ 'support/kb'|url }}">{{ 'Knowledge Base'|trans }}</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {{ render_widgets('client.index.dashboard.guest.after') }}
    {% endif %}

    {{ render_widgets('client.index.dashboard.content.after') }}
{% endblock %}
